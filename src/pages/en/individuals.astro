---
// Englische Fassung von src/pages/individuals.astro. Inhaltlich deckungs-
// gleich, neu formuliert statt übersetzt. Ändert sich die deutsche Seite,
// muss diese mitgezogen werden.
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";

const bausteine = [
  {
    title: "Getting started with AI tools",
    text: "How do I actually get something useful out of ChatGPT, Claude and the rest? For people who use AI tools rather than build them.",
  },
  {
    title: "Bringing AI into how you work",
    text: "How do I fit AI into my existing tools and data so that it creates real value instead of another tab I never open?",
  },
  {
    title: "Building something new with AI",
    text: "How do I go beyond speeding up what I already do, and create products with AI that I can actually sell?",
  },
  {
    title: "Scaling your own AI products",
    text: "How do I move from building products with AI to building products that contain AI themselves?",
  },
];
---

<Layout
  lang="en"
  title="Coaching for individuals"
  description="One-to-one AI coaching for individuals and small groups: using AI well, fitting it into your own workflows, creating new value, and scaling what you build. On request."
>
  <Section
    as="h1"
    eyebrow="Training & workshops"
    title="For individuals"
    lead="Adult education for individuals and small groups — shaped around where you actually are."
  >
    <div class="max-w-2xl">
      <p class="text-[1.0625rem] leading-relaxed text-ink-700">
        AI is changing how we work. Focused one-to-one coaching is how you stay
        competitive through that. The goal is not just to speed up single tasks or
        manual workflows, but to rethink how value gets created in the first place —
        and that is what I am here to help with.
      </p>
    </div>

    <div class="cellgrid mt-10 sm:grid-cols-2">
      {
        bausteine.map((b) => (
          <article class="flex flex-col p-6">
            <span class="-mx-6 -mt-6 mb-5 h-[3px] bg-amber-500" aria-hidden="true" />
            <h2 class="text-lg font-semibold text-ink-900">{b.title}</h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-600">{b.text}</p>
          </article>
        ))
      }
    </div>

    <!-- The actual action of the page, same treatment as the German version. -->
    <div class="mt-12 grid items-center gap-8 bg-brand-800 p-8 text-white md:grid-cols-[2fr_auto] md:p-12">
      <div>
        <h2 class="font-display text-2xl font-bold leading-tight md:text-4xl">
          Ask about one-to-one coaching
        </h2>
        <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-brand-100">
          Just drop me a line — I reply within 48 hours on working days. Scope,
          format and price depend on what you want to cover and how many of you
          there are.
        </p>
      </div>
      <div class="flex md:justify-end">
        <a
          href="/en/#kontakt"
          class="inline-flex min-h-12 items-center justify-center bg-surface px-6 text-sm font-semibold text-brand-800 transition hover:bg-brand-50"
        >
          Get in touch
        </a>
      </div>
    </div>
  </Section>
</Layout>
