---
// Vollständige englische Fassung von src/pages/index.astro: gleiche
// Abschnitte, gleiche Reihenfolge, gleiche ids — damit die Anker aus
// Navigation und Fußzeile (#speaking, #bildung, #kontakt …) hier genauso
// greifen wie auf der deutschen Seite.
//
// Deutsch bleiben nur die Ziele, die es bewusst nur auf Deutsch gibt: die
// Schulworkshops und der Blog. Sie sind als solche gekennzeichnet.
//
// Ändert sich die deutsche Startseite, muss diese hier mitgezogen werden.
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import ContactForm from "../../components/ContactForm.astro";
import { SITE, PATHS, PORTRAIT } from "../../consts";
import { EDU_PATHS, angebotPath } from "../../education/consts";
import ZielgruppenHinweis from "../../education/components/ZielgruppenHinweis.astro";
import { postPath } from "../../blog/consts";

const alleAngebote = (await getCollection("angebote", ({ data }) => !data.preview)).sort(
  (a, b) => a.data.order - b.data.order,
);
const angebote = alleAngebote.slice(0, 2);
const weitereAngebote = alleAngebote.length - angebote.length;

const latestPosts = (await getCollection("posts", ({ data }) => !data.draft && !data.preview))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Englische Datumsformate: das Datum gehört zur Sprache der Seite, nicht zum
// Beitrag. "12 Sept 2026" statt "12. Sep. 2026".
const postFmt = new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "short", day: "numeric" });

const orientation = [
  {
    label: "Keynotes & talks",
    line: "Talks and consulting on AI, IT security, cloud, IAM and cryptography.",
    href: "#speaking",
    bar: "bg-brand-500",
  },
  {
    label: "Training & workshops",
    line: "Workshops and professional training for companies, schools and individuals.",
    href: "#bildung",
    bar: "bg-emerald-500",
  },
  {
    label: "Software",
    line: "Working software and projects, built through dSolve.",
    href: "#software",
    bar: "bg-amber-500",
  },
  {
    label: "Blog",
    line: "Posts on what occupies me: AI, IT security and technology in education.",
    href: "#blog",
    bar: "bg-ink-300",
  },
] as const;

const topics = [
  {
    title: "Artificial intelligence",
    text: "How it works, where it does and does not belong, AI integration architectures (A2A, MCP, REST) and scaling it without the bill running away (AI gateways, sandboxes, filtering, and the rest).",
  },
  {
    title: "Identity & Access Management",
    text: "Getting modern authentication, authorization and zero trust right in hybrid cloud environments.",
  },
  {
    title: "IT security",
    text: "The textbook against everyday practice. How to find the right trade-off between security, cost, usability and maintainability — from inside the financial industry.",
  },
  {
    title: "Cloud",
    text: "What actually scales, what only costs, how hybrid setups play out, and which architecture decisions you can barely correct later.",
  },
  {
    title: "Cryptography",
    text: "From fully homomorphic encryption (computing on encrypted data) to post-quantum cryptography — as a mathematical deep dive or as a pragmatic migration roadmap.",
  },
];

const weitereThemen = [
  "What AI does to society",
  "Scaling problems in enterprise IT",
  "…",
];
---

<Layout
  lang="en"
  title="Felix Paul – Keynotes, training and software"
  description="Talks, training and consulting on AI, IAM, IT security and cryptography – for companies, universities, schools and individuals. Solution Architect at Atruvia."
>
  <Hero lang="en" />

  <!-- ORIENTATION -->
  <Section id="saeulen" eyebrow="Overview" title="What I do" lead="">
    <ul class="mx-auto max-w-3xl divide-y divide-ink-100 overflow-hidden rounded-2xl border border-ink-200 bg-surface shadow-sm">
      {
        orientation.map((o) => (
          <li>
            <a
              href={o.href}
              class="group flex items-center gap-4 px-5 py-4 transition hover:bg-ink-50 sm:px-6"
            >
              <span class={`h-8 w-1 shrink-0 rounded-full ${o.bar}`} aria-hidden="true" />
              <span class="flex-1">
                <span class="block font-semibold text-ink-900">{o.label}</span>
                <span class="block text-sm leading-relaxed text-ink-600">{o.line}</span>
              </span>
              <svg
                class="h-4 w-4 shrink-0 text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-brand-700"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ABOUT ME -->
  <Section id="ueber-mich" background="muted" eyebrow="About me" title="A little about me">
    <div class="mx-auto max-w-5xl">
      <div class="grid items-start gap-10 md:grid-cols-[auto_1fr]">
        <figure class="mx-auto w-full max-w-xs">
          <img
            src={PORTRAIT.image}
            alt={`${SITE.author} – personal photo`}
            width="640"
            height="800"
            class="aspect-[4/5] w-full rounded-2xl object-cover shadow-md ring-1 ring-ink-200"
            loading="lazy"
          />
        </figure>

        <div>
          <div class="prose-content">
            <p>
              What drives me: learning new things, understanding how they fit together,
              checking and building them myself, and passing the knowledge on.
            </p>
            <p>
              The full CV is on <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
            </p>
          </div>

          <figure class="mt-8">
            <figcaption class="text-sm font-semibold uppercase tracking-widest text-brand-700">
              My background
            </figcaption>
            <div class="mt-6">
              <div class="flex flex-col gap-4">
                <div class="flex flex-wrap items-end gap-4 sm:gap-6">
                  <div>
                    <div class="flex items-end gap-2 sm:gap-3">
                      <div class="flex flex-col gap-2">
                        <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-brand-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-brand-900 ring-1 ring-brand-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">M.Sc. Computer Science</div>
                        <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-brand-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-brand-900 ring-1 ring-brand-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">B.Sc. Computer Science</div>
                      </div>
                      <div class="flex flex-col gap-2">
                        <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-brand-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-brand-900 ring-1 ring-brand-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">B.Sc. Mathematics</div>
                      </div>
                    </div>
                    <p class="mt-2 text-center text-[0.65rem] font-medium uppercase tracking-wider text-ink-500 sm:text-xs">
                      Subject degrees
                    </p>
                  </div>

                  <div>
                    <div class="flex flex-col gap-2">
                      <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-emerald-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-emerald-900 ring-1 ring-emerald-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">M.Ed. Maths &amp; Computer Science</div>
                      <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-emerald-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-emerald-900 ring-1 ring-emerald-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">B.Ed. Maths &amp; Computer Science</div>
                    </div>
                    <p class="mt-2 text-center text-[0.65rem] font-medium uppercase tracking-wider text-ink-500 sm:text-xs">
                      Teaching degrees
                    </p>
                  </div>

                  <div class="w-full sm:w-auto sm:flex-1">
                    <div class="flex h-16 w-full items-center justify-center rounded-xl bg-brand-600 px-4 text-on-accent shadow-sm ring-1 ring-brand-700 sm:h-[8.5rem] sm:min-w-[12rem]">
                      <span class="text-center text-sm font-semibold uppercase tracking-wider sm:text-base">
                        Hands-on experience
                      </span>
                    </div>
                    <p class="mt-2 text-center text-[0.65rem] font-medium uppercase tracking-wider text-ink-500 sm:text-xs">
                      Actually building it
                    </p>
                  </div>
                </div>

                <p class="text-xs leading-relaxed text-ink-500">
                  Three complete degree programmes side by side: computer science and
                  mathematics for the subject matter, teaching for how to convey it. On
                  top of that, the day job as a Solution Architect in the financial
                  industry — which is why the talks and workshops stay close to what
                  actually happens.
                </p>
              </div>
            </div>
          </figure>
        </div>
      </div>
    </div>
  </Section>

  <!-- SPEAKING -->
  <Section
    id="speaking"
    eyebrow="Speaking & consulting"
    title="Keynotes & talks"
    lead="I speak and advise at conferences, universities and companies on the topics below."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        topics.map((t) => (
          <div class="rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-ink-900">{t.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{t.text}</p>
          </div>
        ))
      }

      <div class="rounded-2xl border border-dashed border-ink-300 bg-ink-50 p-6">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-500">More topics</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-ink-600">
          {
            weitereThemen.map((t) => (
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-400" aria-hidden="true" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-brand-200 bg-brand-50 p-6 text-center shadow-sm">
      <h3 class="text-lg font-semibold text-ink-900">Consulting</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-600">
        Consulting on these topics is of course also possible — whether that is design
        work, an architecture review, or hands-on implementation.
      </p>
    </div>

    <div class="mt-10 text-center">
      <a href="#kontakt" class="rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-on-accent shadow-sm transition hover:bg-brand-800">
        Get in touch
      </a>
      <p class="mx-auto mt-4 max-w-xl text-sm text-ink-500">
        Your topic is not listed? Ask me anyway.
      </p>
    </div>
  </Section>

  <!-- TRAINING -->
  <Section
    id="bildung"
    background="muted"
    eyebrow="Education"
    title="Training & workshops"
    lead="Workshops, talks and professional training – for schools, universities, companies and individuals."
  >
    <ZielgruppenHinweis compact lang="en" />

    <p class="mt-8 text-sm font-semibold uppercase tracking-wider text-ink-500">
      A look at the school workshops
      <span class="ml-1.5 rounded-sm bg-ink-100 px-1.5 py-0.5 text-[0.65rem] font-semibold tracking-wider text-ink-600">
        pages in German
      </span>
    </p>

    <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        angebote.map((a) => (
          <a
            href={angebotPath(a.id)}
            lang="de"
            class="group flex h-full flex-col rounded-2xl border border-ink-200 bg-surface p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md"
          >
            <h3 class="text-base font-semibold text-ink-900">{a.data.title}</h3>
            <p class="mt-1 text-sm text-emerald-700">{a.data.subtitle}</p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{a.data.teaser}</p>
          </a>
        ))
      }

      <a
        href={PATHS.schools}
        class="group flex h-full flex-col justify-center rounded-2xl border border-dashed border-emerald-300 bg-emerald-50/60 p-5 text-center transition hover:border-emerald-400 hover:bg-emerald-50"
      >
        <span class="font-display text-3xl font-bold text-emerald-700">+{weitereAngebote}</span>
        <span class="mt-1 text-sm font-semibold text-emerald-900">more school workshops</span>
        <span class="mt-2 text-xs leading-relaxed text-emerald-900">
          Parents' evenings, cyber security, cyber bullying, clubs on vibe coding and
          touch typing — with audiences, durations and prices.
        </span>
        <span class="mt-3 inline-flex items-center justify-center gap-1 text-sm font-medium text-emerald-800">
          See all
          <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>
    </div>

    <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={PATHS.schools}
        class="rounded-lg bg-emerald-600 px-5 py-3 text-sm font-medium text-on-accent shadow-sm transition hover:bg-emerald-700"
      >
        See all school workshops
      </a>
      <a
        href={EDU_PATHS.insights}
        class="rounded-lg border border-ink-200 bg-surface px-5 py-3 text-sm font-medium text-ink-800 shadow-sm transition hover:border-emerald-300 hover:text-emerald-700"
      >
        Past workshops & materials
      </a>
    </div>
    <p class="mt-4 text-center text-xs text-ink-500">
      The school programme is written for the German school system and is only
      available in German.
    </p>
  </Section>

  <!-- SOFTWARE -->
  <Section id="software" eyebrow="Software" title="What I have built">
    <div class="mx-auto max-w-4xl">
      <a
        href={SITE.dSolveSite}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-col overflow-hidden rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md md:p-8"
      >
        <span class="absolute inset-x-0 top-0 h-1 bg-amber-500" aria-hidden="true" />
        <span class="inline-flex w-fit rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-amber-800">
          dSolve
        </span>
        <h3 class="mt-3 font-display text-2xl font-bold text-ink-900">
          Professional software products
        </h3>
        <p class="mt-3 max-w-2xl leading-relaxed text-ink-600">
          Through dSolve I build and sell software — from small automations to
          enterprise-ready applications.
        </p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-amber-800">
          d-solve.de
          <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>
    </div>
  </Section>

  <!-- PUBLICATIONS -->
  <Section
    id="publikationen"
    background="muted"
    eyebrow="Publications"
    title="Book & papers"
    lead="Research on cryptography and AI – as a book with Springer and as peer-reviewed papers."
  >
    <article class="rounded-3xl border border-ink-200 bg-surface p-6 shadow-sm md:p-10">
      <div class="grid gap-8 md:grid-cols-[auto_1fr] md:items-start">
        <img
          src="/img/goppa-book/cover.avif"
          alt="Book cover: Goppa Codes and the McEliece Cryptosystem (Springer BestMasters)"
          width="500"
          height="709"
          class="mx-auto w-44 rounded-xl shadow-lg ring-1 ring-ink-200 sm:w-52"
          loading="lazy"
        />
        <div>
          <h3 class="font-display text-2xl font-bold text-ink-900">Goppa Codes and the McEliece Cryptosystem</h3>
          <p class="mt-3 leading-relaxed text-ink-600">
            A thorough introduction to the McEliece cryptosystem — from the mathematical
            foundations through to a concrete implementation.
          </p>
          <div class="mt-5 grid grid-cols-3 gap-3">
            <a href="/pdf/goppa-book/uebersicht.pdf" class="group block overflow-hidden rounded-lg border border-ink-200">
              <img src="/img/goppa-book/uebersicht.png" alt="Chapter overview of the book" width="300" height="112" class="h-28 w-full object-cover object-top transition group-hover:scale-[1.02]" loading="lazy" />
            </a>
            <a href="/pdf/goppa-book/leseprobe.pdf" class="group block overflow-hidden rounded-lg border border-ink-200">
              <img src="/img/goppa-book/leseprobe.png" alt="Sample pages from the book" width="300" height="112" class="h-28 w-full object-cover object-top transition group-hover:scale-[1.02]" loading="lazy" />
            </a>
            <a href="/pdf/goppa-book/literaturverzeichnis.pdf" class="group block overflow-hidden rounded-lg border border-ink-200">
              <img src="/img/goppa-book/literaturverzeichnis.png" alt="Bibliography of the book" width="300" height="112" class="h-28 w-full object-cover object-top transition group-hover:scale-[1.02]" loading="lazy" />
            </a>
          </div>
          <p class="mt-3 text-xs text-ink-500">Click a preview to open the chapter overview, the sample pages or the bibliography as a PDF.</p>
          <div class="mt-5 flex flex-wrap gap-2 text-sm font-medium">
            <a
              href="https://link.springer.com/book/10.1007/978-3-658-46743-2"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-brand-700 px-4 py-2 text-on-accent shadow-sm transition hover:bg-brand-800"
            >
              View &amp; buy at Springer
            </a>
          </div>
        </div>
      </div>
    </article>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="flex h-full flex-col rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-widest text-brand-700">Paper · Cryptography</div>
        <h3 class="mt-2 text-lg font-semibold text-ink-900">Fully Homomorphic Encryption and its Use Cases</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">
          A survey paper on how FHE makes computation on encrypted data possible —
          including the talk and the slides.
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-sm font-medium">
          <a href="/pdf/fhe-survey.pdf" class="rounded-lg bg-brand-700 px-4 py-2 text-on-accent shadow-sm transition hover:bg-brand-800">Paper (PDF)</a>
          <a href="/pdf/slides-fhe-use-cases-without-notes.pdf" class="rounded-lg border border-ink-200 px-4 py-2 text-ink-800 transition hover:border-brand-300 hover:text-brand-700">Slides (PDF)</a>
        </div>
      </div>

      <div class="flex h-full flex-col rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-widest text-brand-700">Paper · AI</div>
        <h3 class="mt-2 text-lg font-semibold text-ink-900">Science-Gym: a simple testbed for AI-driven scientific discovery</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">
          A simple test environment for studying how AI can discover scientific
          relationships on its own – published in <em>Machine Learning</em> (Springer).
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-sm font-medium">
          <a href="https://link.springer.com/article/10.1007/s10994-025-06914-x" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-brand-700 px-4 py-2 text-on-accent shadow-sm transition hover:bg-brand-800">View the article</a>
        </div>
      </div>
    </div>
  </Section>

  <!-- BLOG -->
  <Section
    id="blog"
    background="muted"
    eyebrow="Blog"
    title="My personal blog"
    lead="Thoughts on what occupies me – IT security, AI, technology in education and plenty more. For professionals, teachers, parents, students and the curious."
  >
    <p class="mx-auto mb-6 max-w-4xl text-sm text-ink-500">
      Some blog posts are written in German only.
    </p>
    <ul class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-3">
      {
        latestPosts.map((post) => (
          <li>
            <a
              href={postPath(post.id)}
              lang="de"
              class="group flex h-full flex-col rounded-2xl border border-ink-200 bg-surface p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
            >
              <time datetime={post.data.pubDate.toISOString()} class="text-xs text-ink-500">
                {postFmt.format(post.data.pubDate)}
              </time>
              <span class="mt-2 flex-1 font-semibold leading-snug text-ink-900 group-hover:text-brand-700">
                {post.data.title}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 text-center">
      <a
        href={PATHS.blog}
        class="inline-flex items-center gap-2 rounded-lg border border-ink-200 bg-surface px-5 py-3 text-sm font-medium text-ink-800 shadow-sm transition hover:border-brand-300 hover:text-brand-700"
      >
        All posts
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </Section>

  <!-- CONTACT -->
  <Section
    id="kontakt"
    eyebrow="Contact"
    title="Let's talk"
    lead="A talk, a workshop, working together, or simply a question – a short message is enough. I reply within 48 hours on working days."
  >
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr]">
      <ContactForm lang="en" />

      <aside class="space-y-6">
        <div class="rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm">
          <h2 class="font-display text-lg font-semibold text-ink-900">Direct contact</h2>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <div class="font-medium text-ink-500">Email</div>
              <a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </li>
            <li>
              <div class="font-medium text-ink-500">LinkedIn</div>
              <a class="text-brand-700 underline" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">View profile</a>
            </li>
            <li>
              <div class="font-medium text-ink-500">GitHub</div>
              <a class="text-brand-700 underline" href={SITE.github} target="_blank" rel="noopener noreferrer">View profile</a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </Section>

  <!-- PRESS / SPEAKER PROFILE -->
  <Section
    id="presse"
    background="muted"
    eyebrow="Press & speaker profile"
    title="Material for organisers & press"
    lead="Short bio, photo and speaker profile – the essentials in one place."
  >
    <div class="grid gap-6 md:grid-cols-[1.4fr_1fr]">
      <div class="rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm md:p-8">
        <h3 class="font-display text-lg font-semibold text-ink-900">Short bio (ready to copy)</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-700">
