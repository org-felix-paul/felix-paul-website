---
// Vollständige englische Fassung von src/pages/index.astro: gleiche
// Abschnitte, gleiche Reihenfolge, gleiche ids — damit die Anker aus
// Navigation und Fußzeile (#speaking, #bildung, #kontakt …) hier genauso
// greifen wie auf der deutschen Seite.
//
// Deutsch bleiben nur die Ziele, die es bewusst nur auf Deutsch gibt: die
// Schulworkshops und der Blog. Sie sind als solche gekennzeichnet.
//
// Ändert sich die deutsche Startseite, muss diese hier mitgezogen werden.
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import ContactForm from "../../components/ContactForm.astro";
import { SITE, PATHS, PORTRAIT } from "../../consts";
import { EDU_PATHS, angebotPath } from "../../education/consts";
import ZielgruppenHinweis from "../../education/components/ZielgruppenHinweis.astro";
import { postPath } from "../../blog/consts";

const alleAngebote = (await getCollection("angebote", ({ data }) => !data.preview)).sort(
  (a, b) => a.data.order - b.data.order,
);
const angebote = alleAngebote.slice(0, 2);
const weitereAngebote = alleAngebote.length - angebote.length;

const latestPosts = (await getCollection("posts", ({ data }) => !data.draft && !data.preview))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Englische Datumsformate: das Datum gehört zur Sprache der Seite, nicht zum
// Beitrag. "12 Sept 2026" statt "12. Sep. 2026".
const postFmt = new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "short", day: "numeric" });

const orientation = [
  {
    label: "Keynotes & talks",
    line: "Talks and consulting on AI, IT security, cloud, IAM and cryptography.",
    href: "#speaking",
    bar: "bg-brand-500",
  },
  {
    label: "Training & workshops",
    line: "Workshops and professional training for companies, schools and individuals.",
    href: "#bildung",
    bar: "bg-emerald-500",
  },
  {
    label: "Software",
    line: "Working software and projects, built through dSolve.",
    href: "#software",
    bar: "bg-amber-500",
  },
  {
    label: "Blog",
    line: "Posts on what occupies me: AI, IT security and technology in education.",
    href: "#blog",
    bar: "bg-ink-300",
  },
] as const;

const topics = [
  {
    title: "Artificial intelligence",
    text: "How it works, where it does and does not belong, AI integration architectures (A2A, MCP, REST) and scaling it without the bill running away (AI gateways, sandboxes, filtering, and the rest).",
  },
  {
    title: "Identity & Access Management",
    text: "Getting modern authentication, authorization and zero trust right in hybrid cloud environments.",
  },
  {
    title: "IT security",
    text: "The textbook against everyday practice. How to find the right trade-off between security, cost, usability and maintainability — from inside the financial industry.",
  },
  {
    title: "Cloud",
    text: "What actually scales, what only costs, how hybrid setups play out, and which architecture decisions you can barely correct later.",
  },
  {
    title: "Cryptography",
    text: "From fully homomorphic encryption (computing on encrypted data) to post-quantum cryptography — as a mathematical deep dive or as a pragmatic migration roadmap.",
  },
];

const weitereThemen = [
  "What AI does to society",
  "Scaling problems in enterprise IT",
  "…",
];

// Wie auf der deutschen Seite: der Hintergrund als Aufstellung, nicht als
// Kachelgrafik. Gleiche Wörter, gleiche Gruppen.
const hintergrund = [
  {
    gruppe: "Subject degrees",
    abschluesse: ["M.Sc. Computer Science", "B.Sc. Computer Science", "B.Sc. Mathematics"],
    akzent: "bg-brand-500",
  },
  {
    gruppe: "Teaching degrees",
    abschluesse: ["M.Ed. Maths & Computer Science", "B.Ed. Maths & Computer Science"],
    akzent: "bg-emerald-500",
  },
  {
    gruppe: "Actually building it",
    abschluesse: ["Hands-on experience"],
    akzent: "bg-amber-500",
  },
];

const publikationen: {
  kicker: string;
  titel: string;
  text?: string;
  textVorEm?: string;
  em?: string;
  textNachEm?: string;
  links: { href: string; label: string; primaer?: boolean; extern?: boolean }[];
}[] = [
  {
    kicker: "Paper · Cryptography",
    titel: "Fully Homomorphic Encryption and its Use Cases",
    text: "A survey paper on how FHE makes computation on encrypted data possible — including the talk and the slides.",
    links: [
      { href: "/pdf/fhe-survey.pdf", label: "Paper (PDF)", primaer: true },
      { href: "/pdf/slides-fhe-use-cases-without-notes.pdf", label: "Slides (PDF)" },
    ],
  },
  {
    kicker: "Paper · AI",
    titel: "Science-Gym: a simple testbed for AI-driven scientific discovery",
    textVorEm: "A simple test environment for studying how AI can discover scientific relationships on its own – published in ",
    em: "Machine Learning",
    textNachEm: " (Springer).",
    links: [
      {
        href: "https://link.springer.com/article/10.1007/s10994-025-06914-x",
        label: "View the article",
        primaer: true,
        extern: true,
      },
    ],
  },
];

const buchVorschauen = [
  { href: "/pdf/goppa-book/uebersicht.pdf", src: "/img/goppa-book/uebersicht.png", alt: "Chapter overview of the book" },
  { href: "/pdf/goppa-book/leseprobe.pdf", src: "/img/goppa-book/leseprobe.png", alt: "Sample pages from the book" },
  { href: "/pdf/goppa-book/literaturverzeichnis.pdf", src: "/img/goppa-book/literaturverzeichnis.png", alt: "Bibliography of the book" },
];

const zeile =
  "group grid items-baseline gap-x-10 gap-y-2 py-7 lg:grid-cols-12 lg:py-8";
const knopfPrimaer =
  "inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-white transition hover:bg-brand-800";
const knopfSekundaer =
  "inline-flex min-h-11 items-center justify-center rounded-full border border-ink-300 px-6 text-[0.9375rem] font-medium text-ink-800 transition hover:border-ink-400 hover:text-brand-700";
---

<Layout
  lang="en"
  title="Felix Paul – Keynotes, training and software"
  description="Talks, training and consulting on AI, IAM, IT security and cryptography – for companies, universities, schools and individuals. Solution Architect at Atruvia."
>
  <Hero lang="en" />

  <!-- ORIENTATION -->
  <Section id="saeulen" eyebrow="Overview" title="What I do" tone="minor">
    <ul class="border-t border-ink-200">
      {
        orientation.map((o, i) => (
          <li class="border-b border-ink-100">
            <a href={o.href} class={zeile}>
              <span class="lg:col-span-1">
                <span class="u-eyebrow block text-ink-400" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class={`mt-2 block h-0.5 w-6 rounded-full ${o.bar}`} aria-hidden="true" />
              </span>
              <span class="u-subtitle text-ink-900 transition-colors group-hover:text-brand-700 lg:col-span-5">
                {o.label}
              </span>
              <span class="u-measure text-ink-600 lg:col-span-5">{o.line}</span>
              <span class="hidden justify-self-end text-ink-300 transition group-hover:translate-x-1 group-hover:text-brand-700 lg:col-span-1 lg:block">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ABOUT ME -->
  <Section id="ueber-mich" background="muted" eyebrow="About me" title="A little about me">
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-12">
      <figure class="md:col-span-4 lg:col-span-3">
        <img
          src={PORTRAIT.image}
          alt={`${SITE.author} – personal photo`}
          width="640"
          height="800"
          class="aspect-[4/5] w-full max-w-xs rounded-2xl object-cover object-[50%_18%]"
          loading="lazy"
        />
      </figure>

      <div class="md:col-span-8 lg:col-span-7 lg:col-start-5">
        <div class="prose-content u-measure">
          <p>
            What drives me: learning new things, understanding how they fit together,
            checking and building them myself, and passing the knowledge on.
          </p>
          <p>
            The full CV is on <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
          </p>
        </div>

        <figure class="mt-14">
          <figcaption class="u-eyebrow text-brand-700">
            My background
          </figcaption>

          <dl class="mt-8 border-t border-ink-200">
            {
              hintergrund.map((h) => (
                <div class="grid gap-x-10 gap-y-2 border-b border-ink-100 py-5 sm:grid-cols-12">
                  <dt class="sm:col-span-4">
                    <span class={`mb-2 block h-0.5 w-6 rounded-full ${h.akzent}`} aria-hidden="true" />
                    <span class="u-eyebrow text-ink-500">{h.gruppe}</span>
                  </dt>
                  <dd class="flex flex-wrap gap-x-6 gap-y-1 sm:col-span-8">
                    {h.abschluesse.map((a) => (
                      <span class="text-[0.9375rem] font-medium text-ink-900">{a}</span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>

          <p class="u-measure mt-6 text-sm leading-relaxed text-ink-500">
            Three complete degree programmes side by side: computer science and
            mathematics for the subject matter, teaching for how to convey it. On
            top of that, the day job as a Solution Architect in the financial
            industry — which is why the talks and workshops stay close to what
            actually happens.
          </p>
        </figure>
      </div>
    </div>
  </Section>

  <!-- SPEAKING -->
  <Section
    id="speaking"
    eyebrow="Speaking & consulting"
    title="Keynotes & talks"
    lead="I speak and advise at conferences, universities and companies on the topics below."
  >
    <ul class="border-t border-ink-200">
      {
        topics.map((t) => (
          <li class="grid items-baseline gap-x-10 gap-y-2 border-b border-ink-100 py-7 lg:grid-cols-12 lg:py-9">
            <h3 class="u-subtitle text-ink-900 lg:col-span-5">{t.title}</h3>
            <p class="u-measure leading-relaxed text-ink-600 lg:col-span-7">{t.text}</p>
          </li>
        ))
      }

      <li class="grid items-baseline gap-x-10 gap-y-2 border-b border-ink-100 py-7 lg:grid-cols-12">
        <h3 class="u-eyebrow text-ink-500 lg:col-span-5">More topics</h3>
        <ul class="flex flex-wrap gap-x-6 gap-y-1.5 text-[0.9375rem] text-ink-500 lg:col-span-7">
          {
            weitereThemen.map((t) => (
              <li class="flex items-baseline gap-2">
                <span class="h-1 w-1 shrink-0 rounded-full bg-ink-300" aria-hidden="true" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </li>
    </ul>

    <div class="mt-12 rounded-3xl bg-brand-50 px-7 py-9 md:px-12 md:py-11">
      <div class="grid gap-x-12 gap-y-4 lg:grid-cols-12">
        <h3 class="u-subtitle text-brand-900 lg:col-span-4">Consulting</h3>
        <p class="u-measure leading-relaxed text-brand-900/85 lg:col-span-8">
          Consulting on these topics is of course also possible — whether that is design
          work, an architecture review, or hands-on implementation.
        </p>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a href="#kontakt" class={knopfPrimaer}>
        Get in touch
      </a>
      <p class="u-measure-tight text-sm text-ink-500">
        Your topic is not listed? Ask me anyway.
      </p>
    </div>
  </Section>

  <!-- TRAINING -->
  <Section
    id="bildung"
    background="muted"
    eyebrow="Education"
    title="Training & workshops"
    lead="Workshops, talks and professional training – for schools, universities, companies and individuals."
  >
    <ZielgruppenHinweis compact lang="en" />

    <p class="u-eyebrow mt-16 flex flex-wrap items-center gap-2 text-ink-500">
      A look at the school workshops
      <span class="rounded-sm bg-ink-100 px-1.5 py-0.5 text-[0.65rem] font-semibold tracking-wider text-ink-500">
        pages in German
      </span>
    </p>

    <ul class="mt-6 grid gap-x-10 border-y border-ink-200 lg:grid-cols-3">
      {
        angebote.map((a) => (
          <li class="border-b border-ink-100 last:border-b-0 lg:border-b-0">
            <a href={angebotPath(a.id)} lang="de" class="group flex h-full flex-col py-7 lg:py-8">
              <span class="u-eyebrow text-emerald-700">{a.data.subtitle}</span>
              <h3 class="u-heading mt-3 text-ink-900 transition-colors group-hover:text-brand-700">
                {a.data.title}
              </h3>
              <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">{a.data.teaser}</p>
            </a>
          </li>
        ))
      }

      <li class="last:border-b-0">
        <a href={PATHS.schools} class="group flex h-full flex-col py-7 lg:py-8">
          <span class="u-eyebrow text-emerald-700"><span class="text-emerald-800">+{weitereAngebote}</span> more school workshops</span>
          <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">
            Parents' evenings, cyber security, cyber bullying, clubs on vibe coding and
            touch typing — with audiences, durations and prices.
          </p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-[0.9375rem] font-medium text-emerald-700">
            See all
            <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      </li>
    </ul>

    <div class="mt-12 flex flex-wrap gap-4 border-t border-ink-200 pt-10">
      <a
        href={PATHS.schools}
        class="inline-flex min-h-11 items-center justify-center rounded-full bg-emerald-700 px-6 text-[0.9375rem] font-medium text-white transition hover:bg-emerald-800"
      >
        See all school workshops
      </a>
      <a href={EDU_PATHS.insights} class={knopfSekundaer}>
        Past workshops & materials
      </a>
    </div>
    <p class="u-measure mt-6 text-sm text-ink-500">
      The school programme is written for the German school system and is only
      available in German.
    </p>
  </Section>

  <!-- SOFTWARE -->
  <Section id="software" tone="minor">
    <a
      href={SITE.dSolveSite}
      target="_blank"
      rel="noopener noreferrer"
      class="group block border-t-2 border-amber-500 pt-10"
    >
      <div class="grid gap-x-12 gap-y-6 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="u-eyebrow text-amber-800">Software</p>
          <p class="u-eyebrow mt-3 text-ink-400">dSolve</p>
        </div>
        <div class="lg:col-span-8">
          <h2 class="u-title text-balance text-ink-900">What I have built</h2>
          <h3 class="u-subtitle mt-5 font-normal text-ink-700">
            Professional software products
          </h3>
          <p class="u-measure mt-4 leading-relaxed text-ink-600">
            Through dSolve I build and sell software — from small automations to
            enterprise-ready applications.
          </p>
          <span class="mt-7 inline-flex items-center gap-2 text-[0.9375rem] font-medium text-amber-800">
            d-solve.de
            <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  </Section>

  <!-- PUBLICATIONS -->
  <Section
    id="publikationen"
    background="muted"
    eyebrow="Publications"
    title="Book & papers"
    lead="Research on cryptography and AI – as a book with Springer and as peer-reviewed papers."
  >
    <article class="grid gap-x-12 gap-y-8 md:grid-cols-12">
      <img
        src="/img/goppa-book/cover.avif"
        alt="Book cover: Goppa Codes and the McEliece Cryptosystem (Springer BestMasters)"
        width="500"
        height="709"
        class="w-40 rounded-lg ring-1 ring-ink-200 sm:w-48 md:col-span-4 md:w-full md:max-w-[15rem]"
        loading="lazy"
      />
      <div class="md:col-span-8">
        <h3 class="u-subtitle text-balance text-ink-900">Goppa Codes and the McEliece Cryptosystem</h3>
        <p class="u-measure mt-4 leading-relaxed text-ink-600">
          A thorough introduction to the McEliece cryptosystem — from the mathematical
          foundations through to a concrete implementation.
        </p>
        <div class="mt-7 grid max-w-lg grid-cols-3 gap-3">
          {
            buchVorschauen.map((v) => (
              <a href={v.href} class="group block overflow-hidden rounded-md ring-1 ring-ink-200 transition hover:ring-brand-400">
                <img src={v.src} alt={v.alt} width="300" height="112" class="h-24 w-full object-cover object-top transition group-hover:scale-[1.03]" loading="lazy" />
              </a>
            ))
          }
        </div>
        <p class="mt-3 text-xs text-ink-500">Click a preview to open the chapter overview, the sample pages or the bibliography as a PDF.</p>
        <div class="mt-7">
          <a
            href="https://link.springer.com/book/10.1007/978-3-658-46743-2"
            target="_blank"
            rel="noopener noreferrer"
            class={knopfPrimaer}
          >
            View &amp; buy at Springer
          </a>
        </div>
      </div>
    </article>

    <ul class="mt-16 border-t border-ink-200">
      {
        publikationen.map((p) => (
          <li class="grid gap-x-10 gap-y-3 border-b border-ink-100 py-8 md:grid-cols-12">
            <div class="md:col-span-4">
              <p class="u-eyebrow text-brand-700">{p.kicker}</p>
            </div>
            <div class="md:col-span-8">
              <h3 class="u-heading text-ink-900">{p.titel}</h3>
              <p class="u-measure mt-2 text-[0.9375rem] leading-relaxed text-ink-600">
                {p.text}
                {p.textVorEm}
                {p.em && <em>{p.em}</em>}
                {p.textNachEm}
              </p>
              <div class="mt-5 flex flex-wrap gap-3">
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    target={l.extern ? "_blank" : undefined}
                    rel={l.extern ? "noopener noreferrer" : undefined}
                    class={l.primaer ? knopfPrimaer : knopfSekundaer}
                  >
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- BLOG -->
  <Section
    id="blog"
    tone="minor"
    eyebrow="Blog"
    title="My personal blog"
    lead="Thoughts on what occupies me – IT security, AI, technology in education and plenty more. For professionals, teachers, parents, students and the curious."
  >
    <p class="u-measure mb-8 text-sm text-ink-500">
      Some blog posts are written in German only.
    </p>
    <ul class="border-t border-ink-200">
      {
        latestPosts.map((post) => (
          <li class="border-b border-ink-100">
            <a href={postPath(post.id)} lang="de" class="group grid items-baseline gap-x-10 gap-y-1 py-6 md:grid-cols-12">
              <time datetime={post.data.pubDate.toISOString()} class="u-eyebrow text-ink-400 md:col-span-3">
                {postFmt.format(post.data.pubDate)}
              </time>
              <span class="u-heading text-ink-900 transition-colors group-hover:text-brand-700 md:col-span-9">
                {post.data.title}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10">
      <a href={PATHS.blog} class={knopfSekundaer}>
        All posts
        <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </Section>

  <!-- CONTACT -->
  <Section
    id="kontakt"
    background="muted"
    eyebrow="Contact"
    title="Let's talk"
    lead="A talk, a workshop, working together, or simply a question – a short message is enough. I reply within 48 hours on working days."
  >
    <div class="grid gap-x-12 gap-y-12 md:grid-cols-12">
      <div class="md:col-span-7">
        <ContactForm lang="en" />
      </div>

      <aside class="md:col-span-4 md:col-start-9">
        <h2 class="u-eyebrow text-ink-500">Direct contact</h2>
        <ul class="mt-5 border-t border-ink-200">
          <li class="border-b border-ink-100 py-4">
            <div class="text-xs font-medium uppercase tracking-wider text-ink-500">Email</div>
            <a class="mt-1 block text-[0.9375rem] font-medium text-brand-700 underline underline-offset-4 hover:text-brand-900" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          <li class="border-b border-ink-100 py-4">
            <div class="text-xs font-medium uppercase tracking-wider text-ink-500">LinkedIn</div>
            <a class="mt-1 block text-[0.9375rem] font-medium text-brand-700 underline underline-offset-4 hover:text-brand-900" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">View profile</a>
          </li>
          <li class="border-b border-ink-100 py-4">
            <div class="text-xs font-medium uppercase tracking-wider text-ink-500">GitHub</div>
            <a class="mt-1 block text-[0.9375rem] font-medium text-brand-700 underline underline-offset-4 hover:text-brand-900" href={SITE.github} target="_blank" rel="noopener noreferrer">View profile</a>
          </li>
        </ul>
      </aside>
    </div>
  </Section>

  <!-- PRESS / SPEAKER PROFILE -->
  <Section
    id="presse"
    tone="minor"
    eyebrow="Press & speaker profile"
    title="Material for organisers & press"
    lead="Short bio, photo and speaker profile – the essentials in one place."
  >
    <div class="grid gap-x-12 gap-y-12 border-t border-ink-200 pt-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h3 class="u-eyebrow text-ink-500">Short bio (ready to copy)</h3>
        <p class="u-measure mt-4 leading-relaxed text-ink-700">
          Felix Paul is a computer scientist and mathematician focusing on IT security,
          IAM, AI and cloud. His day job is Solution Architect at Atruvia AG, the IT
          provider of the German cooperative banks; alongside that he is very active as
          a freelancer. As a keynote speaker he appears at conferences, universities and
          companies. He also gives talks at schools, sells his own software products,
          and published a book on post-quantum cryptography with Springer.
        </p>
        <dl class="mt-8 grid gap-x-10 gap-y-4 text-sm sm:grid-cols-2">
