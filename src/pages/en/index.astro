---
// Vollständige englische Fassung von src/pages/index.astro: gleiche
// Abschnitte, gleiche Reihenfolge, gleiche ids — damit die Anker aus
// Navigation und Fußzeile (#speaking, #bildung, #kontakt …) hier genauso
// greifen wie auf der deutschen Seite. Auch die Gliederung (OUTLINE) trägt
// dieselben ids in derselben Reihenfolge: die Nummern 01–09 stehen auf beiden
// Sprachfassungen über denselben Abschnitten.
//
// Deutsch bleiben nur die Ziele, die es bewusst nur auf Deutsch gibt: die
// Schulworkshops und der Blog. Sie sind als solche gekennzeichnet.
//
// Ändert sich die deutsche Startseite, muss diese hier mitgezogen werden.
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import DocGrid from "../../components/DocGrid.astro";
import Section from "../../components/Section.astro";
import ContactForm from "../../components/ContactForm.astro";
import { nummernGeber, type RailItem } from "../../components/outline";
import { SITE, PATHS, PORTRAIT } from "../../consts";
import { EDU_PATHS, angebotPath } from "../../education/consts";
import ZielgruppenHinweis from "../../education/components/ZielgruppenHinweis.astro";
import { postPath } from "../../blog/consts";

const alleAngebote = (await getCollection("angebote", ({ data }) => !data.preview)).sort(
  (a, b) => a.data.order - b.data.order,
);
const angebote = alleAngebote.slice(0, 2);
const weitereAngebote = alleAngebote.length - angebote.length;

const latestPosts = (await getCollection("posts", ({ data }) => !data.draft && !data.preview))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Englische Datumsformate: das Datum gehört zur Sprache der Seite, nicht zum
// Beitrag. "12 Sept 2026" statt "12. Sep. 2026".
const postFmt = new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "short", day: "numeric" });

const OUTLINE: readonly RailItem[] = [
  { id: "saeulen", label: "Overview" },
  { id: "ueber-mich", label: "About me" },
  { id: "speaking", label: "Speaking & consulting" },
  { id: "bildung", label: "Education" },
  { id: "software", label: "Software" },
  { id: "publikationen", label: "Publications" },
  { id: "blog", label: "Blog" },
  { id: "kontakt", label: "Contact" },
  { id: "presse", label: "Press & speaker profile" },
];
const nr = nummernGeber(OUTLINE);

const orientation = [
  {
    label: "Keynotes & talks",
    line: "Talks and consulting on AI, IT security, cloud, IAM and cryptography.",
    href: "#speaking",
    bar: "bg-brand-500",
  },
  {
    label: "Training & workshops",
    line: "Workshops and professional training for companies, schools and individuals.",
    href: "#bildung",
    bar: "bg-emerald-500",
  },
  {
    label: "Software",
    line: "Working software and projects, built through dSolve.",
    href: "#software",
    bar: "bg-amber-500",
  },
  {
    label: "Blog",
    line: "Posts on what occupies me: AI, IT security and technology in education.",
    href: "#blog",
    bar: "bg-ink-300",
  },
] as const;

const topics = [
  {
    title: "Artificial intelligence",
    text: "How it works, where it does and does not belong, AI integration architectures (A2A, MCP, REST) and scaling it without the bill running away (AI gateways, sandboxes, filtering, and the rest).",
  },
  {
    title: "Identity & Access Management",
    text: "Getting modern authentication, authorization and zero trust right in hybrid cloud environments.",
  },
  {
    title: "IT security",
    text: "The textbook against everyday practice. How to find the right trade-off between security, cost, usability and maintainability — from inside the financial industry.",
  },
  {
    title: "Cloud",
    text: "What actually scales, what only costs, how hybrid setups play out, and which architecture decisions you can barely correct later.",
  },
  {
    title: "Cryptography",
    text: "From fully homomorphic encryption (computing on encrypted data) to post-quantum cryptography — as a mathematical deep dive or as a pragmatic migration roadmap.",
  },
];

const weitereThemen = [
  "What AI does to society",
  "Scaling problems in enterprise IT",
  "…",
];

const qualifikation = [
  {
    gruppe: "Subject degrees",
    ton: "brand",
    eintraege: ["M.Sc. Computer Science", "B.Sc. Computer Science", "B.Sc. Mathematics"],
  },
  {
    gruppe: "Teaching degrees",
    ton: "emerald",
    eintraege: ["M.Ed. Maths & Computer Science", "B.Ed. Maths & Computer Science"],
  },
] as const;

const tonKlassen = {
  brand: "bg-brand-50 text-brand-900",
  emerald: "bg-emerald-50 text-emerald-900",
} as const;

const paper = [
  {
    kennung: "Paper · Cryptography",
    titel: "Fully Homomorphic Encryption and its Use Cases",
    text: "A survey paper on how FHE makes computation on encrypted data possible — including the talk and the slides.",
    links: [
      { href: "/pdf/fhe-survey.pdf", label: "Paper (PDF)", extern: false },
      { href: "/pdf/slides-fhe-use-cases-without-notes.pdf", label: "Slides (PDF)", extern: false },
    ],
  },
  {
    kennung: "Paper · AI",
    titel: "Science-Gym: a simple testbed for AI-driven scientific discovery",
    textVorEm: "A simple test environment for studying how AI can discover scientific relationships on its own – published in ",
    em: "Machine Learning",
    textNachEm: " (Springer).",
    links: [
      {
        href: "https://link.springer.com/article/10.1007/s10994-025-06914-x",
        label: "View the article",
        extern: true,
      },
    ],
  },
];

const buchVorschauen = [
  { href: "/pdf/goppa-book/uebersicht.pdf", img: "/img/goppa-book/uebersicht.png", alt: "Chapter overview of the book" },
  { href: "/pdf/goppa-book/leseprobe.pdf", img: "/img/goppa-book/leseprobe.png", alt: "Sample pages from the book" },
  { href: "/pdf/goppa-book/literaturverzeichnis.pdf", img: "/img/goppa-book/literaturverzeichnis.png", alt: "Bibliography of the book" },
];

const knopfPrimaer =
  "inline-flex min-h-11 items-center justify-center bg-brand-700 px-5 text-sm font-semibold text-on-brand transition hover:bg-brand-800";
const knopfSekundaer =
  "inline-flex min-h-11 items-center justify-center border border-rule bg-surface px-5 text-sm font-semibold text-ink-800 transition hover:border-brand-700 hover:text-brand-700";
---

<Layout
  lang="en"
  title="Felix Paul – Keynotes, training and software"
  description="Talks, training and consulting on AI, IAM, IT security and cryptography – for companies, universities, schools and individuals. Solution Architect at Atruvia."
>
  <Hero lang="en" />

  <DocGrid outline={OUTLINE} navLabel="Sections on this page">
    <!-- ORIENTATION -->
    <Section id="saeulen" index={nr("saeulen")} eyebrow="Overview" title="What I do" lead="">
      <ul class="recordlist">
        {
          orientation.map((o) => (
            <li>
              <a href={o.href} class="group flex items-stretch gap-4 py-4 transition hover:bg-ink-50">
                <span class={`w-1 shrink-0 ${o.bar}`} aria-hidden="true" />
                <span class="flex-1">
                  <span class="block font-semibold text-ink-900">{o.label}</span>
                  <span class="mt-0.5 block text-[0.9375rem] leading-relaxed text-ink-600">{o.line}</span>
                </span>
                <svg
                  class="mt-1 h-4 w-4 shrink-0 text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-brand-700"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </Section>

    <!-- ABOUT ME -->
    <Section id="ueber-mich" index={nr("ueber-mich")} eyebrow="About me" title="A little about me">
      <div class="grid gap-8 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-10">
        <figure class="border border-rule">
          <img
            src={PORTRAIT.image}
            alt={`${SITE.author} – personal photo`}
            width="640"
            height="800"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
        </figure>

        <div class="prose-content">
          <p>
            What drives me: learning new things, understanding how they fit together,
            checking and building them myself, and passing the knowledge on.
          </p>
          <p>
            The full CV is on <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
          </p>
        </div>
      </div>

      <figure class="mt-10">
        <figcaption class="label border-b border-rule pb-2 text-brand-700">My background</figcaption>

        <dl>
          {
            qualifikation.map((q) => (
              <div class="grid gap-3 border-b border-rule-soft py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
                <dt class="label pt-1 text-ink-500">{q.gruppe}</dt>
                <dd class="cellgrid grid-cols-2 sm:grid-cols-3">
                  {q.eintraege.map((e) => (
                    <span class={`flex min-h-14 items-center justify-center px-2 py-2 text-center text-xs font-semibold leading-tight ${tonKlassen[q.ton]}`}>
                      {e}
                    </span>
                  ))}
                  {/* Füllfeld: ohne es stünde in der dreispaltigen Zeile mit nur
                      zwei Abschlüssen die Rahmenfläche offen — ein graues Loch
                      im Raster. Leer, aber Fläche. */}
                  {q.eintraege.length < 3 && <span class="hidden sm:block" aria-hidden="true" />}
                </dd>
              </div>
            ))
          }

          <div class="grid gap-3 border-b border-rule py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
            <dt class="label pt-1 text-ink-500">Actually building it</dt>
            <dd>
              <span class="flex min-h-14 items-center justify-center bg-brand-700 px-4 py-2 text-center text-sm font-semibold tracking-wider text-on-brand uppercase">
                Hands-on experience
              </span>
            </dd>
          </div>
        </dl>

        <p class="mt-4 max-w-2xl text-[0.8125rem] leading-relaxed text-ink-500">
          Three complete degree programmes side by side: computer science and
          mathematics for the subject matter, teaching for how to convey it. On
          top of that, the day job as a Solution Architect in the financial
          industry — which is why the talks and workshops stay close to what
          actually happens.
        </p>
      </figure>
    </Section>

    <!-- SPEAKING -->
    <Section
      id="speaking"
      index={nr("speaking")}
      eyebrow="Speaking & consulting"
      title="Keynotes & talks"
      lead="I speak and advise at conferences, universities and companies on the topics below."
    >
      <div class="cellgrid sm:grid-cols-2 xl:grid-cols-3">
        {
          topics.map((t) => (
            <div class="p-5">
              <h3 class="text-base font-semibold text-ink-900">{t.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-600">{t.text}</p>
            </div>
          ))
        }

        <div class="bg-ink-50 p-5">
          <h3 class="label text-ink-600">More topics</h3>
          <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-ink-600">
            {
              weitereThemen.map((t) => (
                <li class="flex items-start gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 bg-ink-400" aria-hidden="true" />
                  <span>{t}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-8 border-t-2 border-brand-700 bg-brand-50 p-6">
        <h3 class="text-base font-semibold text-ink-900">Consulting</h3>
        <p class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-700">
          Consulting on these topics is of course also possible — whether that is design
          work, an architecture review, or hands-on implementation.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-rule pt-6">
        <a href="#kontakt" class={knopfPrimaer}>
          Get in touch
        </a>
        <p class="text-[0.9375rem] text-ink-500">
          Your topic is not listed? Ask me anyway.
        </p>
      </div>
    </Section>

    <!-- TRAINING -->
    <Section
      id="bildung"
      index={nr("bildung")}
      eyebrow="Education"
      title="Training & workshops"
      lead="Workshops, talks and professional training – for schools, universities, companies and individuals."
    >
      <ZielgruppenHinweis compact lang="en" />

      <p class="label mt-10 flex flex-wrap items-center gap-2 border-b border-rule pb-2 text-ink-500">
        A look at the school workshops
        <span class="border border-rule-soft px-1.5 py-0.5 text-[0.65rem] font-semibold tracking-wider text-ink-500">
          pages in German
        </span>
      </p>

      <div class="cellgrid border-t-0 sm:grid-cols-2 xl:grid-cols-3">
        {
          angebote.map((a) => (
            <a href={angebotPath(a.id)} lang="de" class="group flex h-full flex-col p-5 transition hover:bg-ink-50">
              <p class="label border-b border-rule-soft pb-2 text-emerald-700">{a.data.subtitle}</p>
              <h3 class="mt-3 text-base font-semibold text-ink-900 group-hover:text-brand-700">{a.data.title}</h3>
              <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">{a.data.teaser}</p>
            </a>
          ))
        }

        <a href={PATHS.schools} class="group flex h-full flex-col justify-center bg-emerald-50 p-5 transition hover:bg-emerald-100">
          <span class="font-display text-4xl font-bold tabular-nums text-emerald-700">+{weitereAngebote}</span>
          <span class="mt-1 text-sm font-semibold text-emerald-900">more school workshops</span>
          <span class="mt-2 text-[0.8125rem] leading-relaxed text-emerald-900">
            Parents' evenings, cyber security, cyber bullying, clubs on vibe coding and
            touch typing — with audiences, durations and prices.
          </span>
          <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-emerald-800">
            See all
            <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      </div>

      <div class="mt-8 flex flex-wrap gap-3 border-t border-rule pt-6">
        <a
          href={PATHS.schools}
          class="inline-flex min-h-11 items-center justify-center bg-emerald-700 px-5 text-sm font-semibold text-on-brand transition hover:bg-emerald-800"
        >
          See all school workshops
        </a>
        <a href={EDU_PATHS.insights} class={knopfSekundaer}>
          Past workshops & materials
        </a>
      </div>
      <p class="mt-4 text-[0.8125rem] text-ink-500">
        The school programme is written for the German school system and is only
        available in German.
      </p>
    </Section>

    <!-- SOFTWARE -->
    <Section id="software" index={nr("software")} eyebrow="Software" title="What I have built">
      <a
        href={SITE.dSolveSite}
        target="_blank"
        rel="noopener noreferrer"
        class="group block border border-rule border-t-2 border-t-amber-500 p-6 transition hover:bg-ink-50 md:p-8"
      >
        <span class="label text-amber-800">dSolve</span>
        <h3 class="mt-3 font-display text-2xl font-bold text-ink-900">
          Professional software products
        </h3>
        <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-600">
          Through dSolve I build and sell software — from small automations to
          enterprise-ready applications.
        </p>
        <span class="mt-6 inline-flex items-center gap-2 font-mono text-sm font-semibold text-amber-800">
          d-solve.de
          <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>
    </Section>

    <!-- PUBLICATIONS -->
    <Section
      id="publikationen"
      index={nr("publikationen")}
      eyebrow="Publications"
      title="Book & papers"
      lead="Research on cryptography and AI – as a book with Springer and as peer-reviewed papers."
    >
      <article class="border border-rule p-6 md:p-8">
        <div class="grid gap-8 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-start">
          <img
            src="/img/goppa-book/cover.avif"
            alt="Book cover: Goppa Codes and the McEliece Cryptosystem (Springer BestMasters)"
            width="500"
            height="709"
            class="w-full border border-rule"
            loading="lazy"
          />
          <div>
            <h3 class="font-display text-xl font-bold text-ink-900 md:text-2xl">Goppa Codes and the McEliece Cryptosystem</h3>
            <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-600">
              A thorough introduction to the McEliece cryptosystem — from the mathematical
              foundations through to a concrete implementation.
            </p>
            <div class="cellgrid mt-5 grid-cols-3">
              {
                buchVorschauen.map((v) => (
                  <a href={v.href} class="group block overflow-hidden">
                    <img src={v.img} alt={v.alt} width="300" height="112" class="h-28 w-full object-cover object-top transition group-hover:scale-[1.02]" loading="lazy" />
                  </a>
                ))
              }
            </div>
            <p class="mt-3 text-xs text-ink-500">Click a preview to open the chapter overview, the sample pages or the bibliography as a PDF.</p>
            <div class="mt-5">
              <a
                href="https://link.springer.com/book/10.1007/978-3-658-46743-2"
                target="_blank"
                rel="noopener noreferrer"
                class={knopfPrimaer}
              >
                View &amp; buy at Springer
              </a>
            </div>
          </div>
        </div>
      </article>

      <ul class="recordlist mt-10">
        {
          paper.map((p) => (
            <li class="record">
              <span class="label text-brand-700">{p.kennung}</span>
              <div>
                <h3 class="text-base font-semibold text-ink-900">{p.titel}</h3>
                <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-600">
                  {p.text}
                  {p.textVorEm}
                  {p.em && <em>{p.em}</em>}
                  {p.textNachEm}
                </p>
                <div class="mt-2 flex flex-wrap gap-x-5">
                  {p.links.map((l) => (
                    <a
                      href={l.href}
                      target={l.extern ? "_blank" : undefined}
                      rel={l.extern ? "noopener noreferrer" : undefined}
                      class="inline-flex min-h-11 items-center font-mono text-sm font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-900"
                    >
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </Section>

    <!-- BLOG -->
    <Section
      id="blog"
      index={nr("blog")}
      eyebrow="Blog"
      title="My personal blog"
      lead="Thoughts on what occupies me – IT security, AI, technology in education and plenty more. For professionals, teachers, parents, students and the curious."
    >
      <p class="mb-6 text-[0.9375rem] text-ink-500">
        Some blog posts are written in German only.
      </p>
      <ul class="recordlist">
        {
          latestPosts.map((post) => (
            <li>
              <a href={postPath(post.id)} lang="de" class="record group transition hover:bg-ink-50">
                <time datetime={post.data.pubDate.toISOString()} class="label text-ink-500">
                  {postFmt.format(post.data.pubDate)}
                </time>
                <span class="font-semibold leading-snug text-ink-900 group-hover:text-brand-700">
                  {post.data.title}
                </span>
                <svg class="hidden h-4 w-4 shrink-0 self-center text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-brand-700 sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-8">
        <a href={PATHS.blog} class={`${knopfSekundaer} gap-2`}>
          All posts
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </Section>

    <!-- CONTACT -->
    <Section
      id="kontakt"
      index={nr("kontakt")}
      eyebrow="Contact"
      title="Let's talk"
      lead="A talk, a workshop, working together, or simply a question – a short message is enough. I reply within 48 hours on working days."
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
        <ContactForm lang="en" />

        <aside>
          <h2 class="label border-b border-rule pb-2 text-ink-500">Direct contact</h2>
          <dl class="recordlist border-t-0">
            <div class="record">
              <dt class="label text-ink-500">Email</dt>
              <dd>
                <a class="text-brand-700 underline underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a>
              </dd>
            </div>
            <div class="record">
              <dt class="label text-ink-500">LinkedIn</dt>
              <dd>
                <a class="text-brand-700 underline underline-offset-4" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">View profile</a>
              </dd>
            </div>
            <div class="record">
              <dt class="label text-ink-500">GitHub</dt>
              <dd>
                <a class="text-brand-700 underline underline-offset-4" href={SITE.github} target="_blank" rel="noopener noreferrer">View profile</a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </Section>

    <!-- PRESS / SPEAKER PROFILE -->
    <Section
      id="presse"
      index={nr("presse")}
      eyebrow="Press & speaker profile"
      title="Material for organisers & press"
      lead="Short bio, photo and speaker profile – the essentials in one place."
    >
      <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr]">
        <div class="border border-rule p-6 md:p-8">
          <h3 class="label border-b border-rule pb-2 text-ink-500">Short bio (ready to copy)</h3>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-700">
            Felix Paul is a computer scientist and mathematician focusing on IT security,
            IAM, AI and cloud. His day job is Solution Architect at Atruvia AG, the IT
            provider of the German cooperative banks; alongside that he is very active as
            a freelancer. As a keynote speaker he appears at conferences, universities and
            companies. He also gives talks at schools, sells his own software products,
            and published a book on post-quantum cryptography with Springer.
          </p>
          <dl class="recordlist mt-6">
            <div class="record">
              <dt class="label text-ink-500">Languages</dt>
              <dd class="text-ink-900">German · English</dd>
            </div>
            <div class="record">
              <dt class="label text-ink-500">Contact</dt>
              <dd><a class="text-brand-700 underline underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
            </div>
          </dl>
        </div>

        <div class="border border-rule p-6 md:p-8">
