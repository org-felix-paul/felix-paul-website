---
// Ziel des englischen Kontaktformulars (`_next`). Ohne diese Seite landete
// eine englische Anfrage auf der deutschen Bestätigung.
import Layout from "../../layouts/Layout.astro";
---

<Layout
  lang="en"
  noindex
  title="Message sent"
  description="Your enquiry via felix-paul.de has been sent."
>
  <section class="mx-auto max-w-3xl px-5 py-28 sm:px-8 md:py-40">
    <p class="u-eyebrow text-brand-700">Thank you</p>
    <h1 class="u-title mt-6 text-balance text-ink-900">
      Message sent.
    </h1>
    <p class="u-lede u-measure mt-8 border-t border-ink-200 pt-8 text-ink-600">
      Your enquiry has reached me. I will get back to you within 48 hours on
      working days — sooner if I can.
    </p>
    <p class="u-measure mt-4 text-sm text-ink-500">
      A confirmation has been sent to your email address. If it does not turn up,
      please check your spam folder.
    </p>
    <div class="mt-10 flex">
      <a
        href="/en/"
        class="inline-flex min-h-11 items-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-brand-50 transition hover:bg-brand-800"
      >
        Back to the overview
      </a>
    </div>
  </section>
</Layout>
