---
// Ziel des englischen Kontaktformulars (`_next`). Ohne diese Seite landete
// eine englische Anfrage auf der deutschen Bestätigung.
import Layout from "../../layouts/Layout.astro";
---

<Layout
  lang="en"
  noindex
  title="Message sent"
  description="Your enquiry via felix-paul.de has been sent."
>
  <section class="mx-auto max-w-[72rem] px-6 pt-16 pb-24">
    <p class="label text-brand-700">Thank you</p>
    <h1 class="mt-4 max-w-3xl border-t border-rule pt-6 font-display text-4xl font-bold leading-tight tracking-tight text-ink-900 md:text-6xl">
      Message sent.
    </h1>
    <p class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-600 md:text-lg">
      Your enquiry has reached me. I will get back to you within 48 hours on
      working days — sooner if I can.
    </p>
    <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-500">
      A confirmation has been sent to your email address. If it does not turn up,
      please check your spam folder.
    </p>
    <div class="mt-10 border-t border-rule pt-6">
      <a
        href="/en/"
        class="inline-flex min-h-11 items-center justify-center bg-brand-700 px-5 text-sm font-semibold text-white transition hover:bg-brand-800"
      >
        Back to the overview
      </a>
    </div>
  </section>
</Layout>
