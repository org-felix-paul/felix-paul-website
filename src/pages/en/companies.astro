---
// Englische Fassung von src/pages/companies.astro. Inhaltlich deckungsgleich,
// aber neu formuliert statt Wort für Wort übersetzt — die deutsche Seite
// siezt und arbeitet mit Komposita, beides trägt im Englischen nicht.
//
// Wenn sich die deutsche Seite ändert, muss diese hier mitgezogen werden.
// Das ist der Preis jeder Übersetzung und der Grund, warum es bewusst nur
// wenige gibt (siehe claude-behavior.md §28).
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import { PATHS } from "../../consts";

type Accent = "brand" | "emerald" | "amber";

const formats: {
  label: string;
  title: string;
  text: string;
  accent: Accent;
  wide?: boolean;
}[] = [
  {
    label: "Individuals & leadership",
    title: "Your own role",
    text: "A close look at how you actually work: where AI makes your existing processes faster, where they are worth rethinking, and what is genuinely worth automating. For a single leader as much as for a small leadership team.",
    accent: "brand",
  },
  {
    label: "Small & mid-sized companies",
    title: "The whole picture",
    text: "At this size you can still see everything at once. We go through processes, tools and responsibilities together and decide where AI genuinely helps — and where it adds nothing.",
    accent: "emerald",
  },
  {
    label: "Large enterprises",
    title: "One bottleneck, in depth",
    text: "Instead of the full survey, a targeted look at the real pain point. Usually that means scaling AI across many business units: integration patterns, availability and choice of tooling, governance, and cost transparency.",
    accent: "amber",
    wide: true,
  },
];

const fundamentals = [
  `The <strong>lethal trifecta</strong> (Simon Willison): an agent turns dangerous the moment access to
   sensitive data, untrusted content and an outbound channel come together — and how to mitigate that
   combination in your own landscape, weighed against risk and value.`,
  `<strong>Identity and access management for AI:</strong> how do AI agents authenticate? Do you accept
   impersonation or only delegation, and how do you spot risky combinations of access as they happen?`,
  `<strong>Keeping an overview:</strong> which tools, MCP servers and agents exist in the first place,
   who runs them, who is allowed to use them, and how new ones are added under control.`,
  `<strong>Integration patterns:</strong> when an API is enough, when you need an MCP server, and when
   it has to be an A2A agent. And when AI is the wrong answer.`,
  `<strong>Governance that grows with you</strong> instead of slowing you down — guard rails that still
   work once more than a handful of teams are involved.`,
  `<strong>Cost management:</strong> making consumption visible across the entire company by decoupling
   applications from model access.`,
  `<strong>Shadow IT:</strong> why it appears particularly fast around AI, and how to meet it without
   shutting innovation down.`,
];

const depth: { title: string; text: string; items?: { name: string; was: string }[] }[] = [
  {
    title: "Identity and access management from the ground up",
    text: "Authentication, authorization and federation basics — what the terms actually mean, the security principles behind them, and the common authorization models. Then OAuth 2 token flows in detail.",
    items: [
      { name: "Authorization Code with PKCE", was: "the standard case wherever a user is present" },
      { name: "Client Credentials", was: "service to service, with no user involved" },
      { name: "Device Authorization Flow", was: "devices with neither a browser nor a keyboard" },
      { name: "Impersonation, delegation and token exchange (RFC 8693)", was: "calling further services on a user's behalf" },
      { name: "More specialised flows:", was: "RAR, PAR, JAR, JWE" },
    ],
  },
  {
    title: "The protocol landscape around agents",
    text: "An overview of the protocols and what each one is actually for.",
    items: [
      { name: "REST APIs", was: "agent to tools and data?" },
      { name: "MCP", was: "agent to tools and data" },
      { name: "A2A", was: "agent to agent, with the Linux Foundation since 2025" },
      { name: "A2UI, AG-UI", was: "what an agent is allowed to render in the interface" },
      { name: "AP2 / x402", was: "mandate, approval and proof for agentic payments" },
      { name: "UCP", was: "agentic commerce" },
    ],
  },
  {
    title: "Scaling problems from real environments",
    text: "Why AI integrations so often fail on identity, governance and integration — and how to build agentic systems safely (OWASP Top 10 for Agentic Applications).",
  },
];

const styles = {
  brand: { bar: "bg-brand-500", chip: "bg-brand-50 text-brand-800" },
  emerald: { bar: "bg-emerald-500", chip: "bg-emerald-50 text-emerald-800" },
  amber: { bar: "bg-amber-500", chip: "bg-amber-50 text-amber-800" },
};
---

<Layout
  lang="en"
  title="Training for companies and universities"
  description="Workshops for companies and universities – shaped around your own role, the organisation as a whole, or one specific bottleneck. On request."
>
  <Section
    as="h1"
    eyebrow="Training & workshops"
    title="For companies and universities"
    lead="Workshops, talks and training, shaped around your organisation and your role."
  >
    <div class="cellgrid md:grid-cols-2">
      {
        formats.map((f) => {
          const s = styles[f.accent];
          return (
            <article
              class:list={[
                "relative flex flex-col overflow-hidden border border-ink-200 bg-surface p-6",
                f.wide && "md:col-span-2",
              ]}
            >
              <span class={`-mx-6 -mt-6 mb-5 h-[3px] ${s.bar}`} aria-hidden="true" />
              <span class={`label w-fit px-2 py-1 ${s.chip}`}>
                {f.label}
              </span>
              <h2 class="mt-3 text-lg font-semibold text-ink-900">{f.title}</h2>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-600">{f.text}</p>
            </article>
          );
        })
      }
    </div>

    <!-- Applies to all three formats above. -->
    <div class="mt-10">
      <h2 class="label border-b border-rule pb-2 text-ink-500">
        Fundamentals that come up almost every time
      </h2>
      <ol class="text-[0.9375rem] text-ink-700">
        {
          fundamentals.map((g, i) => (
            <li class="grid gap-x-4 border-b border-rule-soft py-3 sm:grid-cols-[2.5rem_minmax(0,1fr)]">
              <span class="label pt-1 text-brand-700" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="leading-relaxed" set:html={g} />
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Deliberately set apart: this part is addressed to universities, not to
         companies. Its own tint, badge and border, so that nobody scrolling
         past mistakes the two lists for one. -->
    <section class="mt-12 border border-rule border-t-2 border-t-brand-700">
      <div class="border-b border-rule bg-brand-50 px-6 py-5">
        <span class="label inline-flex w-fit bg-brand-700 px-2 py-1 text-white">
          For universities and higher education
        </span>
        <h2 class="mt-3 font-display text-xl font-bold text-brand-900">
          Lectures, seminars and guest talks
        </h2>
        <p class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-brand-900">
          A deep look at the technology underneath, at lecture level. Also available
          to architecture and platform teams at engineering-led companies.
        </p>
      </div>

      <ul class="px-6 text-[0.9375rem] text-ink-700">
        {
          depth.map((t) => (
            <li class="border-b border-rule-soft py-5 last:border-b-0">
              <h3 class="text-base font-semibold text-ink-900">{t.title}</h3>
              <p class="mt-1 leading-relaxed text-ink-600">{t.text}</p>
              {t.items && (
                <ul class="mt-3 border-l-2 border-brand-700 pl-4">
                  {t.items.map((i) => (
                    <li class="border-b border-rule-soft py-1.5 leading-relaxed text-ink-600 last:border-b-0">
                      <strong class="font-semibold text-ink-900">{i.name}</strong>
                      {" – "}
                      {i.was}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- The actual action of the page, same treatment as the German version. -->
    <div class="mt-12 grid items-center gap-8 bg-brand-800 p-8 text-white md:grid-cols-[2fr_auto] md:p-12">
      <div>
        <h2 class="font-display text-2xl font-bold leading-tight md:text-4xl">
          Ready to book, or would you like a tailored proposal?
        </h2>
        <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-brand-100">
          Just drop me a line — I reply within 48 hours on working days. Format,
          scope and price all follow from what you want to achieve.
        </p>
      </div>
      <div class="flex md:justify-end">
        <a
          href={PATHS.kontakt}
          class="inline-flex min-h-12 items-center justify-center bg-surface px-6 text-sm font-semibold text-brand-800 transition hover:bg-brand-50"
        >
          Get in touch
        </a>
      </div>
    </div>
  </Section>
</Layout>
