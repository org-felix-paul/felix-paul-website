---
import { getCollection } from "astro:content";
import Layout from "../../blog/BlogLayout.astro";
import { postPath } from "../../blog/consts";
import {
  AUDIENCES,
  TOPICS,
  STATUSES,
  AUDIENCE_LABELS,
  TOPIC_LABELS,
  STATUS_LABELS,
  COMING_SOON_TEXT,
} from "../../blog/consts";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const dateFmt = new Intl.DateTimeFormat("de-DE", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const posts = allPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  // Preview posts only ever expose their title – everything else stays
  // hidden until the post is actually written and published.
  description: post.data.preview ? COMING_SOON_TEXT : post.data.description,
  audience: post.data.audience,
  topics: post.data.topics,
  pubDate: post.data.pubDate,
  preview: post.data.preview,
  status: post.data.preview ? "preview" : "published",
  searchText: post.data.preview
    ? [
        post.data.title,
        ...post.data.topics.map((t) => TOPIC_LABELS[t]),
        ...post.data.audience.map((a) => AUDIENCE_LABELS[a]),
      ]
        .join(" ")
        .toLowerCase()
    : [
        post.data.title,
        post.data.description,
        ...post.data.topics.map((t) => TOPIC_LABELS[t]),
        ...post.data.audience.map((a) => AUDIENCE_LABELS[a]),
        post.body ?? "",
      ]
        .join(" ")
        .toLowerCase(),
}));
---

<Layout>
  {/* Titelseite des Blogs in derselben Form wie die der Hauptseite: Label,
      Haarlinie, Titel, Haarlinie, Vorspann. */}
  <section class="bg-surface">
    <div class="mx-auto max-w-[72rem] px-6 pt-10 pb-12 md:pt-14">
      <p class="label text-brand-700">blogging@Felix&nbsp;Paul</p>
      <div class="mt-5 border-t border-rule pt-6">
        <h1 class="font-display text-4xl font-extrabold leading-[1.02] tracking-tight text-ink-900 sm:text-6xl md:text-7xl">
          Felix&nbsp;Pauls<br /><span class="text-brand-700">persönlicher Tech Blog</span>
        </h1>
      </div>
      <p class="mt-8 max-w-2xl border-t border-rule pt-6 text-[1.0625rem] leading-relaxed text-ink-700 md:text-lg">
        Meine Gedanken zu Themen, die mich begeistern: KI, IT-Sicherheit, IT in der Bildung und beliebige spannende IT-Projekte.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-[72rem] px-6 pb-16">
    <!-- Controls -->
    <div class="border-t-2 border-rule pt-6">
      <label class="block">
        <span class="sr-only">Beiträge durchsuchen</span>
        <input
          type="search"
          placeholder="Beiträge durchsuchen…"
          autocomplete="off"
          data-search-input
          class="w-full border border-rule bg-surface px-4 py-3 text-base text-ink-900 outline-none transition placeholder:text-ink-400 focus:border-brand-700 focus:ring-2 focus:ring-brand-100"
        />
      </label>

      <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-start md:gap-10">
        <div class="flex flex-wrap items-center gap-2" data-filter-group="audience">
          <span class="label mr-1 text-ink-500">Zielgruppe</span>
          <button
            type="button"
            data-value=""
            aria-pressed="true"
            class="inline-flex min-h-11 items-center border border-brand-700 bg-brand-700 px-3 text-sm font-semibold text-white transition"
          >
            Alle
          </button>
          {
            AUDIENCES.map((value) => (
              <button
                type="button"
                data-value={value}
                aria-pressed="false"
                class="inline-flex min-h-11 items-center border border-rule bg-surface px-3 text-sm font-medium text-ink-700 transition hover:border-brand-700 hover:text-brand-700"
              >
                {AUDIENCE_LABELS[value]}
              </button>
            ))
          }
        </div>

        <div class="flex flex-wrap items-center gap-2" data-filter-group="topic">
          <span class="label mr-1 text-ink-500">Thema</span>
          <button
            type="button"
            data-value=""
            aria-pressed="true"
            class="inline-flex min-h-11 items-center border border-brand-700 bg-brand-700 px-3 text-sm font-semibold text-white transition"
          >
            Alle
          </button>
          {
            TOPICS.map((value) => (
              <button
                type="button"
                data-value={value}
                aria-pressed="false"
                class="inline-flex min-h-11 items-center border border-rule bg-surface px-3 text-sm font-medium text-ink-700 transition hover:border-brand-700 hover:text-brand-700"
              >
                {TOPIC_LABELS[value]}
              </button>
            ))
          }
        </div>

        <div class="flex flex-wrap items-center gap-2" data-filter-group="status">
          <span class="label mr-1 text-ink-500">Status</span>
          <button
            type="button"
            data-value=""
            aria-pressed="true"
            class="inline-flex min-h-11 items-center border border-brand-700 bg-brand-700 px-3 text-sm font-semibold text-white transition"
          >
            Alle
          </button>
          {
            STATUSES.map((value) => (
              <button
                type="button"
                data-value={value}
                aria-pressed="false"
                class="inline-flex min-h-11 items-center border border-rule bg-surface px-3 text-sm font-medium text-ink-700 transition hover:border-brand-700 hover:text-brand-700"
              >
                {STATUS_LABELS[value]}
              </button>
            ))
          }
        </div>
      </div>

      <p id="ergebnisse" class="label mt-6 border-t border-rule pt-3 text-ink-500" data-count>{posts.length} {posts.length === 1 ? "Beitrag" : "Beiträge"}</p>
    </div>

    {/* Beitragsliste als Verzeichnis: Zeilen mit Haarlinien statt einer
        Kachelhalde. Die Merkmale (Thema, Zielgruppe) sind eckige Kennungen in
        der Monoschrift, das Datum steht rechts in der Ziffernspalte. */}
    <ul class="recordlist mt-6">
      {
        posts.map((post) =>
          post.preview ? (
            <li
              data-post
              data-audience={post.audience.join(" ")}
              data-topics={post.topics.join(" ")}
              data-status={post.status}
              data-search={post.searchText}
            >
              <div class="flex flex-col gap-3 bg-ink-50 p-6">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="label border border-amber-500 bg-amber-50 px-2 py-1 text-amber-800">
                    {STATUS_LABELS.preview}
                  </span>
                  {post.topics.map((t) => (
                    <span class="label border border-brand-300 bg-brand-50 px-2 py-1 text-brand-700">
                      {TOPIC_LABELS[t]}
                    </span>
                  ))}
                  {post.audience.map((a) => (
                    <span class="label border border-rule-soft bg-surface px-2 py-1 text-ink-600">
                      {AUDIENCE_LABELS[a]}
                    </span>
                  ))}
                </div>
                <h2 class="text-lg font-semibold text-ink-700">{post.title}</h2>
                <p class="text-[0.9375rem] font-medium italic leading-relaxed text-ink-400">{post.description}</p>
              </div>
            </li>
          ) : (
            <li
              data-post
              data-audience={post.audience.join(" ")}
              data-topics={post.topics.join(" ")}
              data-status={post.status}
              data-search={post.searchText}
            >
              <a
                href={postPath(post.id)}
                class="group grid gap-x-8 gap-y-3 py-5 transition hover:bg-ink-50 md:grid-cols-[minmax(0,1fr)_9rem]"
              >
                <div>
                  <div class="flex flex-wrap items-center gap-1.5">
                    {post.topics.map((t) => (
                      <span class="label border border-brand-300 bg-brand-50 px-2 py-1 text-brand-700">
                        {TOPIC_LABELS[t]}
                      </span>
                    ))}
                    {post.audience.map((a) => (
                      <span class="label border border-rule-soft bg-ink-50 px-2 py-1 text-ink-600">
                        {AUDIENCE_LABELS[a]}
                      </span>
                    ))}
                  </div>
                  <h2 class="mt-3 text-lg font-semibold text-ink-900 group-hover:text-brand-700">{post.title}</h2>
                  <p class="mt-2 max-w-3xl text-[0.9375rem] leading-relaxed text-ink-600">{post.description}</p>
                </div>
                <time datetime={post.pubDate.toISOString()} class="label self-start text-ink-500 md:pt-1 md:text-right">
                  {dateFmt.format(post.pubDate)}
                </time>
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div data-empty hidden class="mt-12 border border-rule bg-ink-50 px-6 py-12">
      <p class="text-lg font-semibold text-ink-700">Keine Ergebnisse gefunden</p>
      <p class="mt-2 max-w-xl text-[0.9375rem] text-ink-500">
        Zu deiner Suche passt kein Beitrag. Versuche einen anderen Suchbegriff oder setze die Filter auf „Alle“ zurück.
      </p>
    </div>
  </div>
</Layout>

<script>
  type Group = "audience" | "topic" | "status";
  const state: Record<Group, string> & { q: string } = { audience: "", topic: "", status: "", q: "" };

  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-post]"));
  const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const count = document.querySelector<HTMLElement>("[data-count]");
  const results = document.querySelector<HTMLElement>("#ergebnisse");

  function apply() {
    let visible = 0;
    for (const card of cards) {
      const audience = (card.dataset.audience ?? "").split(" ").filter(Boolean);
      const topics = (card.dataset.topics ?? "").split(" ").filter(Boolean);
      const status = card.dataset.status ?? "";
      const text = card.dataset.search ?? "";
      const show =
        (!state.audience || audience.includes(state.audience)) &&
        (!state.topic || topics.includes(state.topic)) &&
        (!state.status || status === state.status) &&
        (!state.q || text.includes(state.q));
      card.hidden = !show;
      if (show) visible++;
    }
    if (empty) empty.hidden = visible !== 0;
    if (count) count.textContent = `${visible} ${visible === 1 ? "Beitrag" : "Beiträge"}`;
  }

  searchInput?.addEventListener("input", () => {
    state.q = searchInput.value.trim().toLowerCase();
    apply();
  });

  // On mobile the live-filtered list sits below the fold, so pressing Enter
  // dismisses the keyboard and jumps straight to the (possibly empty) results.
  searchInput?.addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;
    event.preventDefault();
    state.q = searchInput.value.trim().toLowerCase();
    apply();
    searchInput.blur();
    results?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  document.querySelectorAll<HTMLElement>("[data-filter-group]").forEach((group) => {
    const name = group.dataset.filterGroup as Group;
    const buttons = group.querySelectorAll<HTMLButtonElement>("button[data-value]");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        state[name] = btn.dataset.value ?? "";
        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-pressed", active ? "true" : "false");
          b.classList.toggle("bg-brand-700", active);
          b.classList.toggle("text-white", active);
          b.classList.toggle("border-brand-700", active);
          b.classList.toggle("bg-surface", !active);
          b.classList.toggle("text-ink-700", !active);
          b.classList.toggle("border-rule", !active);
        });
        apply();
      });
    });
  });
</script>
