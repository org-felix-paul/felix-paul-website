---
import { getCollection, render } from "astro:content";
import Layout from "../../blog/BlogLayout.astro";
import { BLOG, AUDIENCE_LABELS, TOPIC_LABELS } from "../../blog/consts";
import { SITE, PATHS } from "../../consts";

export async function getStaticPaths() {
  // Preview posts are teaser-only ("Coming soon …") and have no detail page.
  const posts = await getCollection(
    "posts",
    ({ data }) => !data.draft && !data.preview,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat("de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Page-level structured data. The site-wide Person/Organization/WebSite graph
// comes from the shared Layout; this only adds the node that describes THIS
// post and points back at the existing Person via @id instead of repeating it.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${canonical}#post`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: post.data.pubDate.toISOString(),
    author: { "@id": `${SITE.url}/#person` },
    publisher: { "@id": `${SITE.url}/#person` },
    mainEntityOfPage: { "@id": `${canonical}#webpage` },
    inLanguage: "de-DE",
    keywords: [...post.data.topics, ...post.data.audience].join(", "),
  },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  schema={schema}
>
  <article>
    <section class="border-b border-ink-100 bg-gradient-to-br from-brand-50 via-white to-white">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <a href={BLOG.base} class="text-sm font-medium text-brand-700 hover:text-brand-900">← Alle Beiträge</a>
        <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">
          {post.data.title}
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-700">{post.data.description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          {
            post.data.topics.map((t) => (
              <span class="rounded-full border border-brand-200 bg-white px-3 py-1 text-xs font-medium text-brand-700">
                {TOPIC_LABELS[t]}
              </span>
            ))
          }
          {
            post.data.audience.map((a) => (
              <span class="rounded-full border border-ink-200 bg-white px-3 py-1 text-xs font-medium text-ink-600">
                {AUDIENCE_LABELS[a]}
              </span>
            ))
          }
        </div>

        <time datetime={post.data.pubDate.toISOString()} class="mt-4 block text-xs font-medium uppercase tracking-wider text-ink-400">
          {dateFmt.format(post.data.pubDate)}
        </time>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-6 py-16">
      <div class="prose-content">
        <Content />
      </div>

      <div class="mt-12 rounded-2xl bg-brand-50 p-6 md:p-8">
        <h2 class="font-display text-2xl font-bold text-ink-900">Lust auf einen Workshop dazu?</h2>
        <p class="mt-2 text-ink-700">
          Ich gebe praxisnahe Workshops zu KI und IT-Sicherheit an Schulen – für Schüler:innen, Eltern und Lehrkräfte.
          Erzähl mir von deiner Schule oder Veranstaltung und ich melde mich.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="/#kontakt"
            class="rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800"
          >
            Kontakt aufnehmen
          </a>
          <a
            href={PATHS.education}
            class="rounded-lg border border-ink-200 bg-white px-5 py-3 text-sm font-medium text-ink-800 shadow-sm transition hover:border-brand-300 hover:text-brand-700"
          >
            Workshops für Schulen
          </a>
        </div>
      </div>

      <div class="mt-12">
        <a href={BLOG.base} class="text-sm font-medium text-brand-700 hover:text-brand-900">← Alle Beiträge</a>
      </div>
    </div>
  </article>
</Layout>

<script>
  // Mermaid-Diagramme client-seitig rendern. Der Import erfolgt nur, wenn die
  // Seite tatsächlich ein .mermaid-Element enthält, damit Posts ohne Diagramm
  // das Bundle nicht laden.
  const blocks = document.querySelectorAll<HTMLElement>(".mermaid");
  if (blocks.length > 0) {
    const { default: mermaid } = await import("mermaid");
    mermaid.initialize({
      startOnLoad: false,
      // "base" ist nötig, damit die themeVariables greifen – passend zur
      // Brand-Blau-/Ink-Palette des Blogs (siehe global.css).
      theme: "base",
      fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif",
      themeVariables: {
        primaryColor: "#e0effe", // brand-100 – Knoten-Füllung
        primaryBorderColor: "#0072c6", // brand-600 – Rahmen
        primaryTextColor: "#1f2733", // ink-900 – Text
        secondaryColor: "#f6f7f9", // ink-50
        tertiaryColor: "#f0f7ff", // brand-50
        lineColor: "#36abf7", // brand-400 – Kanten/Pfeile
        clusterBkg: "#f0f7ff", // brand-50 – Subgraph-Hintergrund
        clusterBorder: "#bae0fd", // brand-200
        edgeLabelBackground: "#ffffff",
        // Balkenfarbe der xychart-Diagramme
        xyChart: { plotColorPalette: "#0d8fe8" }, // brand-500
      },
      themeCSS: ".edgeLabel { color: #1f2733; }",
      flowchart: { curve: "basis" },
    });
    await mermaid.run({ nodes: blocks });
  }
</script>
