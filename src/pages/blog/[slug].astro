---
import { getCollection, render } from "astro:content";
import Layout from "../../blog/BlogLayout.astro";
import { BLOG, AUDIENCE_LABELS, TOPIC_LABELS } from "../../blog/consts";
import { SITE, PATHS } from "../../consts";

export async function getStaticPaths() {
  // Preview posts are teaser-only ("Coming soon …") and have no detail page.
  const posts = await getCollection(
    "posts",
    ({ data }) => !data.draft && !data.preview,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat("de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Page-level structured data. The site-wide Person/Organization/WebSite graph
// comes from the shared Layout; this only adds the node that describes THIS
// post and points back at the existing Person via @id instead of repeating it.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${canonical}#post`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: post.data.pubDate.toISOString(),
    author: { "@id": `${SITE.url}/#person` },
    publisher: { "@id": `${SITE.url}/#person` },
    mainEntityOfPage: { "@id": `${canonical}#webpage` },
    inLanguage: "de-DE",
    keywords: [...post.data.topics, ...post.data.audience].join(", "),
  },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  schema={schema}
>
  <article>
    <section class="border-b border-ink-200 bg-gradient-to-br from-brand-50 via-canvas to-canvas">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <a href={BLOG.base} class="text-sm font-medium text-brand-700 hover:text-brand-900">← Alle Beiträge</a>
        <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">
          {post.data.title}
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-700">{post.data.description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          {
            post.data.topics.map((t) => (
              <span class="rounded-full border border-brand-200 bg-surface px-3 py-1 text-xs font-medium text-brand-700">
                {TOPIC_LABELS[t]}
              </span>
            ))
          }
          {
            post.data.audience.map((a) => (
              <span class="rounded-full border border-ink-200 bg-surface px-3 py-1 text-xs font-medium text-ink-600">
                {AUDIENCE_LABELS[a]}
              </span>
            ))
          }
        </div>

        <time datetime={post.data.pubDate.toISOString()} class="mt-4 block text-xs font-medium uppercase tracking-wider text-ink-400">
          {dateFmt.format(post.data.pubDate)}
        </time>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-6 py-16">
      <div class="prose-content">
        <Content />
      </div>

      <div class="mt-12 rounded-2xl bg-brand-50 p-6 md:p-8">
        <h2 class="font-display text-2xl font-bold text-ink-900">Lust auf einen Workshop dazu?</h2>
        <p class="mt-2 text-ink-700">
          Ich gebe praxisnahe Workshops zu KI und IT-Sicherheit an Schulen – für Schüler:innen, Eltern und Lehrkräfte.
          Erzähl mir von deiner Schule oder Veranstaltung und ich melde mich.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="/#kontakt"
            class="rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800"
          >
            Kontakt aufnehmen
          </a>
          <a
            href={PATHS.schools}
            class="rounded-lg border border-ink-200 bg-surface px-5 py-3 text-sm font-medium text-ink-800 shadow-sm transition hover:border-brand-300 hover:text-brand-700"
          >
            Bildungsangebote
          </a>
        </div>
      </div>

      <div class="mt-12">
        <a href={BLOG.base} class="text-sm font-medium text-brand-700 hover:text-brand-900">← Alle Beiträge</a>
      </div>
    </div>
  </article>
</Layout>

<script>
  // Mermaid-Diagramme client-seitig rendern. Der Import erfolgt nur, wenn die
  // Seite tatsächlich ein .mermaid-Element enthält, damit Posts ohne Diagramm
  // das Bundle nicht laden.
  const blocks = document.querySelectorAll<HTMLElement>(".mermaid");
  if (blocks.length > 0) {
    const { default: mermaid } = await import("mermaid");

    // Der Diagrammtext muss aufgehoben werden: mermaid ersetzt den Inhalt
    // durch ein SVG, ein zweiter Durchlauf hätte sonst keine Quelle mehr.
    const quelle = new Map<HTMLElement, string>();
    blocks.forEach((b) => quelle.set(b, b.textContent ?? ""));

    const istDunkel = () => document.documentElement.dataset.theme === "dark";
    const zeichne = async () => {
      // Farben kommen fest ins SVG, also muss bei einem Themenwechsel neu
      // gerendert werden — ein helles Diagramm auf dunklem Grund ist unlesbar.
      mermaid.initialize({
        startOnLoad: false,
        theme: "base",
        darkMode: istDunkel(),
        fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif",
        // Feste Hexwerte, weil mermaid die Farben ins SVG schreibt und keine
        // CSS-Variablen auflöst. Sie sind Kopien aus src/styles/global.css —
        // ändert sich die Palette dort, muss dieser Block mitgezogen werden.
        themeVariables: istDunkel()
          ? {
              primaryColor: "#251a63", // brand-100
              primaryBorderColor: "#ab90ff", // brand-700
              primaryTextColor: "#f4f4f8", // ink-900
              secondaryColor: "#21212a", // ink-100
              tertiaryColor: "#1a1145", // brand-50
              lineColor: "#9c82f4", // brand-500
              clusterBkg: "#0e0e12", // surface
              clusterBorder: "#6d6d78", // ink-200
              edgeLabelBackground: "#0e0e12", // surface
              xyChart: { plotColorPalette: "#ab90ff" }, // brand-700
            }
          : {
              primaryColor: "#e5e0ff", // brand-100
              primaryBorderColor: "#5934c4", // brand-700
              primaryTextColor: "#101017", // ink-900
              secondaryColor: "#f4f4f6", // ink-50
              tertiaryColor: "#f4f2ff", // brand-50
              lineColor: "#6c4bd9", // brand-500
              clusterBkg: "#ffffff", // surface
              clusterBorder: "#898994", // ink-200
              edgeLabelBackground: "#ffffff", // surface
              xyChart: { plotColorPalette: "#5934c4" }, // brand-700
            },
        flowchart: { curve: "basis", useMaxWidth: true },
        sequence: { useMaxWidth: true },
        xyChart: { useMaxWidth: true },
      });
      blocks.forEach((b) => {
        b.removeAttribute("data-processed");
        b.textContent = quelle.get(b) ?? "";
      });
      try {
        await mermaid.run({ nodes: blocks, suppressErrors: true });
      } finally {
        blocks.forEach((b) => {
          if (!b.dataset.processed) b.dataset.mermaidFailed = "true";
        });
      }
    };

    await zeichne();
    window.addEventListener("themechange", () => void zeichne());

  }
</script>
