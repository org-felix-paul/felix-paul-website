---
import { getCollection, render } from "astro:content";
import Layout from "../../blog/BlogLayout.astro";
import { BLOG, AUDIENCE_LABELS, TOPIC_LABELS } from "../../blog/consts";
import { SITE, PATHS } from "../../consts";

export async function getStaticPaths() {
  // Preview posts are teaser-only ("Coming soon …") and have no detail page.
  const posts = await getCollection(
    "posts",
    ({ data }) => !data.draft && !data.preview,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat("de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Page-level structured data. The site-wide Person/Organization/WebSite graph
// comes from the shared Layout; this only adds the node that describes THIS
// post and points back at the existing Person via @id instead of repeating it.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${canonical}#post`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: post.data.pubDate.toISOString(),
    author: { "@id": `${SITE.url}/#person` },
    publisher: { "@id": `${SITE.url}/#person` },
    mainEntityOfPage: { "@id": `${canonical}#webpage` },
    inLanguage: "de-DE",
    keywords: [...post.data.topics, ...post.data.audience].join(", "),
  },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  schema={schema}
>
  <article>
    <section class="post-hero">
      <div class="mx-auto max-w-3xl px-5 pt-14 pb-12 sm:px-8 md:pt-20">
        <a href={BLOG.base} class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700 hover:text-brand-900">← Alle Beiträge</a>
        <h1 class="u-title mt-4 text-balance text-ink-900">
          {post.data.title}
        </h1>
        <p class="u-lede u-measure mt-6 text-ink-700">{post.data.description}</p>

        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-1.5 border-t border-ink-200 pt-5">
          {
            post.data.topics.map((t) => (
              <span class="u-eyebrow text-brand-700">
                {TOPIC_LABELS[t]}
              </span>
            ))
          }
          {
            post.data.audience.map((a) => (
              <span class="u-eyebrow text-ink-400">
                {AUDIENCE_LABELS[a]}
              </span>
            ))
          }
          <time datetime={post.data.pubDate.toISOString()} class="u-eyebrow ml-auto text-ink-400">
            {dateFmt.format(post.data.pubDate)}
          </time>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-5 pt-12 pb-20 sm:px-8">
      <div class="prose-content">
        <Content />
      </div>

      <div class="mt-20 rounded-3xl bg-brand-50 px-7 py-9 md:px-10 md:py-11">
        <h2 class="u-subtitle text-balance text-brand-900">Lust auf einen Workshop dazu?</h2>
        <p class="u-measure mt-4 leading-relaxed text-brand-900/85">
          Ich gebe praxisnahe Workshops zu KI und IT-Sicherheit an Schulen – für Schüler:innen, Eltern und Lehrkräfte.
          Erzähl mir von deiner Schule oder Veranstaltung und ich melde mich.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/#kontakt"
            class="inline-flex min-h-11 items-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-white transition hover:bg-brand-800"
          >
            Kontakt aufnehmen
          </a>
          <a
            href={PATHS.schools}
            class="inline-flex min-h-11 items-center rounded-full border border-brand-300 px-6 text-[0.9375rem] font-medium text-brand-900 transition hover:border-brand-400"
          >
            Bildungsangebote
          </a>
        </div>
      </div>

      <div class="mt-14 border-t border-ink-200 pt-6">
        <a href={BLOG.base} class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700 hover:text-brand-900">← Alle Beiträge</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .post-hero {
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-brand-50) 85%, transparent),
      var(--color-canvas) 80%
    );
  }
</style>

<script>
  // Mermaid-Diagramme client-seitig rendern. Der Import erfolgt nur, wenn die
  // Seite tatsächlich ein .mermaid-Element enthält, damit Posts ohne Diagramm
  // das Bundle nicht laden.
  const blocks = document.querySelectorAll<HTMLElement>(".mermaid");
  if (blocks.length > 0) {
    const { default: mermaid } = await import("mermaid");

    // Der Diagrammtext muss aufgehoben werden: mermaid ersetzt den Inhalt
    // durch ein SVG, ein zweiter Durchlauf hätte sonst keine Quelle mehr.
    const quelle = new Map<HTMLElement, string>();
    blocks.forEach((b) => quelle.set(b, b.textContent ?? ""));

    const istDunkel = () => document.documentElement.dataset.theme === "dark";
    const zeichne = async () => {
      // Farben kommen fest ins SVG, also muss bei einem Themenwechsel neu
      // gerendert werden — ein helles Diagramm auf dunklem Grund ist unlesbar.
      mermaid.initialize({
        startOnLoad: false,
        theme: "base",
        darkMode: istDunkel(),
        fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif",
        themeVariables: istDunkel()
          ? {
              primaryColor: "#14497a",
              primaryBorderColor: "#4aa8ea",
              primaryTextColor: "#eef2f7",
              secondaryColor: "#1e242f",
              tertiaryColor: "#0d3355",
              lineColor: "#6dbdf2",
              clusterBkg: "#131820",
              clusterBorder: "#2b3341",
              edgeLabelBackground: "#131820",
              xyChart: { plotColorPalette: "#4aa8ea" },
            }
          : {
              primaryColor: "#e0effe",
              primaryBorderColor: "#0072c6",
              primaryTextColor: "#1f2733",
              secondaryColor: "#f6f7f9",
              tertiaryColor: "#f0f7ff",
              lineColor: "#36abf7",
              clusterBkg: "#f0f7ff",
              clusterBorder: "#bae0fd",
              edgeLabelBackground: "#ffffff",
              xyChart: { plotColorPalette: "#0d8fe8" },
            },
        flowchart: { curve: "basis", useMaxWidth: true },
        sequence: { useMaxWidth: true },
        xyChart: { useMaxWidth: true },
      });
      blocks.forEach((b) => {
        b.removeAttribute("data-processed");
        b.textContent = quelle.get(b) ?? "";
      });
      try {
        await mermaid.run({ nodes: blocks, suppressErrors: true });
      } finally {
        blocks.forEach((b) => {
          if (!b.dataset.processed) b.dataset.mermaidFailed = "true";
        });
      }
    };

    await zeichne();
    window.addEventListener("themechange", () => void zeichne());

  }
</script>
