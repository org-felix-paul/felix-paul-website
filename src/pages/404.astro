---
import Layout from "../layouts/Layout.astro";
---

<Layout noindex title="Seite nicht gefunden" description="Diese Seite existiert nicht.">
  <section class="mx-auto max-w-3xl px-5 py-28 sm:px-8 md:py-40">
    <p class="u-eyebrow text-brand-700">404</p>
    <h1 class="u-title mt-6 text-balance text-ink-900">
      Diese Seite existiert nicht.
    </h1>
    <p class="u-lede u-measure mt-8 border-t border-ink-200 pt-8 text-ink-600">
      Vielleicht ist sie umgezogen – oder hat nie existiert. Zurück zur Startseite geht es hier.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex min-h-11 items-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-brand-50 transition hover:bg-brand-800"
      >
        Zur Startseite
      </a>
      <a
        href="/#publikationen"
        class="inline-flex min-h-11 items-center rounded-full border border-ink-300 px-6 text-[0.9375rem] font-medium text-ink-800 transition hover:border-ink-400 hover:text-brand-700"
      >
        Publikationen ansehen
      </a>
    </div>
  </section>
</Layout>
