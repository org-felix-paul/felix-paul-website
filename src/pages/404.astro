---
import Layout from "../layouts/Layout.astro";
---

<Layout noindex title="Seite nicht gefunden" description="Diese Seite existiert nicht.">
  <section class="mx-auto max-w-[72rem] px-6 pt-16 pb-24">
    <p class="label text-brand-700">404</p>
    <h1 class="mt-4 max-w-3xl border-t border-rule pt-6 font-display text-4xl font-bold leading-tight tracking-tight text-ink-900 md:text-6xl">
      Diese Seite existiert nicht.
    </h1>
    <p class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-600 md:text-lg">
      Vielleicht ist sie umgezogen – oder hat nie existiert. Zurück zur Startseite geht es hier.
    </p>
    <div class="mt-10 flex flex-wrap gap-3 border-t border-rule pt-6">
      <a
        href="/"
        class="inline-flex min-h-11 items-center justify-center bg-brand-700 px-5 text-sm font-semibold text-white transition hover:bg-brand-800"
      >
        Zur Startseite
      </a>
      <a
        href="/#publikationen"
        class="inline-flex min-h-11 items-center justify-center border border-rule bg-surface px-5 text-sm font-semibold text-ink-800 transition hover:border-brand-700 hover:text-brand-700"
      >
        Publikationen ansehen
      </a>
    </div>
  </section>
</Layout>
