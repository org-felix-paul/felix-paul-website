---
import Layout from "../layouts/Layout.astro";
---

<Layout
  noindex
  title="Suche"
  description="Durchsuchen Sie felix-paul.de nach Schlagworten: Vorträge, Bildungsangebote, Blog."
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="font-display text-4xl font-bold tracking-tight text-ink-900">Suche</h1>
    <p class="mt-3 text-ink-600">Vorträge, Bildungsangebote und Blog – alles auf felix-paul.de.</p>
    <div id="search" class="mt-8"></div>
  </section>
  <!-- Pagefind writes /pagefind/ into dist after `astro build`; in `astro dev` it does not exist. -->
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    const ui = new PagefindUI({ element: "#search", showSubResults: true, autofocus: true });
    const q = new URLSearchParams(location.search).get("q");
    if (q) ui.triggerSearch(q);
  </script>
</Layout>

<style is:global>
  /* Pagefind UI an die Design-Tokens hängen, damit hell/dunkel mitzieht. */
  #search {
    --pagefind-ui-primary: var(--color-brand-700);
    --pagefind-ui-text: var(--color-ink-900);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-ink-200);
    --pagefind-ui-tag: var(--color-ink-100);
    --pagefind-ui-font: inherit;
  }
</style>
