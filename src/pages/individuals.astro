---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { PATHS } from "../consts";

// Erwachsenenbildung für Einzelne und kleine Gruppen. Bewusst ohne Katalog:
// der Zuschnitt entsteht im Gespräch, und der Ausgangspunkt ist bei jeder
// Person ein anderer.
const bausteine = [
  {
    title: "Verstehen, was da eigentlich passiert",
    text: "Wie generative KI funktioniert – ohne Mathematik, aber auch ohne Magie. Was sie kann, was sie nur zu können scheint, und woran man den Unterschied erkennt.",
  },
  {
    title: "Den eigenen Nutzen finden",
    text: "Der Mehrwert ist bei jedem ein anderer: im Beruf, beim Schreiben, beim Lernen, in der Selbstständigkeit. Wir gehen von Ihrem Alltag aus, nicht von einer Werkzeugliste.",
  },
  {
    title: "Sicher unterwegs sein",
    text: "Welche Daten gibt man preis, was passiert damit, und wie schützt man sich – bei KI-Diensten ebenso wie beim ganz normalen Surfen.",
  },
  {
    title: "Anschlussfähig bleiben",
    text: "Der Arbeitsmarkt verändert sich schneller, als Weiterbildung nachkommt. Ziel ist nicht, jedes Werkzeug zu kennen, sondern neue selbst einordnen zu können.",
  },
];
---

<Layout
  title="Erwachsenenbildung für Privatpersonen"
  description="Workshops und Kurse für Einzelne und kleine Gruppen: verstehen, wie KI funktioniert, den eigenen Nutzen finden und sicher unterwegs sein. Individuell zugeschnitten, auf Anfrage."
>
  <Section
    as="h1"
    eyebrow="Bildungsangebote"
    title="Für Privatpersonen"
    lead="Erwachsenenbildung für Einzelne und kleine Gruppen – individuell zugeschnitten statt aus dem Katalog."
  >
    <div class="mx-auto max-w-3xl">
      <p class="text-base leading-relaxed text-ink-700">
        Der Einstieg ist bei jedem ein anderer: manche wollen wissen, was hinter der Technik steckt, andere
        wollen sie im Beruf einsetzen, wieder andere wollen vor allem den Anschluss nicht verlieren. Deshalb
        gibt es hier keine festen Kurse, sondern einen gemeinsamen Ausgangspunkt und einen Zuschnitt, der zu
        Ihnen passt.
      </p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        bausteine.map((b) => (
          <article class="relative flex flex-col overflow-hidden rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
            <span class="absolute inset-x-0 top-0 h-1 bg-amber-500" aria-hidden="true" />
            <h2 class="text-lg font-semibold text-ink-900">{b.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{b.text}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-6 rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-500">Auch möglich</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-600">
        Kurse aus dem Schulkontext lassen sich für Erwachsene genauso halten – etwa das
        <a href={PATHS.schools} class="font-medium text-brand-700 underline underline-offset-2 hover:text-brand-900">
          Zehnfingersystem oder Vibe Coding
        </a>. Für Gruppen ab einer gewissen Größe ergibt ein eigener Termin meist mehr Sinn als
        Einzelunterricht.
      </p>
    </div>

    <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-center">
      <h2 class="font-display text-lg font-semibold text-amber-900">Angebote nur auf Anfrage</h2>
      <p class="mx-auto mt-2 max-w-2xl text-sm leading-relaxed text-amber-900">
        Umfang, Format und Preis hängen davon ab, worum es gehen soll und wie viele Sie sind. Schreiben Sie
        mir kurz, was Sie vorhaben – daraus wird dann ein konkreter Vorschlag.
      </p>
      <a
        href={PATHS.kontakt}
        class="mt-5 inline-flex items-center justify-center rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800"
      >
        Anfrage senden
      </a>
    </div>
  </Section>
</Layout>
