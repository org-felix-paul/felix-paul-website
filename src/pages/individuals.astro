---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { PATHS } from "../consts";

// Erwachsenenbildung für Einzelne und kleine Gruppen. Bewusst ohne Katalog:
// der Zuschnitt entsteht im Gespräch, und der Ausgangspunkt ist bei jeder
// Person ein anderer.
const bausteine = [
  {
    title: "Einführung in  KI Anwendungen",
    text: "Wie kann ich KI wie ChatGPT, Claude, ... für mich sinnvoll nutzen? Hilfe für Anwender von KI Tools.",
  },
  {
    title: "KI Lösungen in Arbeitsabläufe integrieren",
    text: "Wie kann ich KI in meine Arbeitsabläufe mit meinen Tools und Daten integrieren, um echten Mehrwert zu schaffen.",
  },
  {
    title: "Neue Wertschöpfung mittels KI schaffen",
    text: "Wie kann ich KI nicht nur in meine Prozesse integrieren, sondern mit KI neue Produkte schaffen, die ich monetarisieren kann?",
  },
  {
    title: "Skalierung eigener KI Lösungen",
    text: "Wie kann ich mit KI nicht nur neue Produkte schaffen, sondern Produkte erzeugen, die selbst wiederum KI enthalten? ",
  },
];
---

<Layout
  title="Erwachsenenbildung für Privatpersonen"
  description="Individualberatung zu KI für Einzelne und kleine Gruppen: KI sinnvoll anwenden, in eigene Arbeitsabläufe integrieren, neue Wertschöpfung schaffen und Lösungen skalieren. Auf Anfrage."
>
  <Section
    as="h1"
    eyebrow="Bildungsangebote"
    title="Für Privatpersonen"
    lead="Erwachsenenbildung für Einzelne und kleine Gruppen – individuell zugeschnitten."
  >
    <div class="u-measure">
      <p class="u-lede leading-relaxed text-ink-700">
        KI veränder die Art und Weise wie wir arbeiten. Mit zielgerichteter Individualberatung bleiben Sie wettbewerbsfähig. 
        Beschleunigen Sie nicht nur Einzelaufgaben oder manuelle Workflows, sondern denken Sie Wertschöpfungsketten neu. 
        Dazu unterstütze ich gerne mit individueller Beratung.
      </p>
    </div>

    <div class="mt-16 grid gap-x-12 sm:grid-cols-2">
      {
        bausteine.map((b) => (
          <article class="flex flex-col border-t border-ink-200 py-7">
            <span class="mb-4 block h-0.5 w-6 rounded-full bg-amber-500" aria-hidden="true" />
            <h2 class="u-subtitle text-balance text-ink-900">{b.title}</h2>
            <p class="u-measure mt-3 leading-relaxed text-ink-600">{b.text}</p>
          </article>
        ))
      }
    </div>

    <!-- Dominanter Abschluss-CTA, gleiche Behandlung wie auf /schools/: dies
         ist die eigentliche Handlung der Seite, und ein blasser Kasten in
         Fließtextgröße wurde ihr nicht gerecht. -->
    <div class="mt-20 grid items-center gap-x-12 gap-y-8 rounded-[2rem] bg-brand-800 px-8 py-12 text-white md:grid-cols-12 md:px-14 md:py-16">
      <div class="md:col-span-8">
        <h2 class="u-title text-balance">
          Jetzt individuelle Beratung anfragen
        </h2>
        <p class="u-measure mt-5 leading-relaxed text-brand-100">
          Schreiben Sie mir formlos – ich melde mich werktags innerhalb von 48 Stunden zurück. 
          Umfang, Format und Preis hängen davon ab, worum es gehen soll und wie viele Teilnehmer Sie sind. 
        </p>
      </div>
      <div class="md:col-span-4 md:flex md:justify-end">
        <a
          href={PATHS.kontakt}
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-surface px-7 text-[0.9375rem] font-medium text-brand-800 transition hover:bg-brand-50"
        >
          Jetzt anfragen
        </a>
      </div>
    </div>
  </Section>
</Layout>
