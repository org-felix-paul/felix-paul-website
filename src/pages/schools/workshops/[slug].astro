---
import { getCollection, render } from "astro:content";
import Layout from "../../../education/EduLayout.astro";
import { SITE } from "../../../consts";
import { EDU_PATHS } from "../../../education/consts";

export async function getStaticPaths() {
  // Preview-Angebote bekommen keine Detailseite.
  const angebote = (await getCollection("angebote")).filter((a) => !a.data.preview);
  return angebote.map((angebot) => ({
    params: { slug: angebot.id },
    props: { angebot },
  }));
}

const { angebot } = Astro.props;
const { Content } = await render(angebot);

// Page-level structured data: this one offer. Identity (Person/Organization)
// stays in the shared Layout and is referenced by @id, never duplicated.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const schema = [
  {
    "@type": "Service",
    "@id": `${canonical}#service`,
    name: angebot.data.title,
    description: angebot.data.teaser,
    serviceType: angebot.data.subtitle,
    provider: { "@id": `${SITE.url}/#person` },
    audience: { "@type": "Audience", audienceType: angebot.data.zielgruppe },
    areaServed: ["Rheinland-Pfalz", "Hamburg", "Deutschland"],
    mainEntityOfPage: { "@id": `${canonical}#webpage` },
  },
];
---

<Layout title={angebot.data.title} description={angebot.data.teaser} schema={schema}>
  <article>
    <section class="border-b border-ink-200 bg-gradient-to-br from-brand-50 via-canvas to-canvas">
      <div class="mx-auto max-w-4xl px-6 py-16">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-700">{angebot.data.subtitle}</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">
          {angebot.data.title}
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-700">{angebot.data.teaser}</p>

        <dl class="mt-8 grid gap-6 rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm sm:grid-cols-3">
          <div>
            <dt class="text-xs font-medium uppercase tracking-widest text-ink-500">Zielgruppe</dt>
            <dd class="mt-1 text-ink-900">{angebot.data.zielgruppe}</dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-widest text-ink-500">Dauer</dt>
            <dd class="mt-1 text-ink-900">{angebot.data.dauer}</dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-widest text-ink-500">Honorar</dt>
            <dd class="mt-1 text-ink-900">{angebot.data.preis}</dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-6 py-16">
      <div class="prose-content">
        <Content />
      </div>

      <div class="mt-12 rounded-2xl bg-brand-50 p-6 md:p-8">
        <h2 class="font-display text-2xl font-bold text-ink-900">Dieses Angebot buchen</h2>
        <p class="mt-2 text-ink-700">
          Schreiben Sie mir kurz, wann und für welche Klasse(n) – ich melde mich werktags innerhalb von 48 Stunden zurück.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href={EDU_PATHS.kontakt}
            class="rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800"
          >
            Anfrage senden
          </a>
          <a
            href={`mailto:${SITE.email}?subject=${encodeURIComponent("Anfrage: " + angebot.data.title)}`}
            class="rounded-lg border border-ink-200 bg-surface px-5 py-3 text-sm font-medium text-ink-800 shadow-sm transition hover:border-brand-300 hover:text-brand-700"
          >
            Direkt per Mail
          </a>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap items-center justify-between gap-4">
        <a href={EDU_PATHS.angebotAnchor} class="text-sm font-medium text-brand-700 hover:text-brand-900">
          ← Alle Angebote
        </a>
        <a href={EDU_PATHS.insights} class="text-sm font-medium text-brand-700 hover:text-brand-900">
          Einblicke aus durchgeführten Workshops →
        </a>
      </div>
    </div>
  </article>
</Layout>
