---
import { getCollection, render } from "astro:content";
import Layout from "../../../education/EduLayout.astro";
import { SITE } from "../../../consts";
import { EDU_PATHS } from "../../../education/consts";

export async function getStaticPaths() {
  // Preview-Angebote bekommen keine Detailseite.
  const angebote = (await getCollection("angebote")).filter((a) => !a.data.preview);
  return angebote.map((angebot) => ({
    params: { slug: angebot.id },
    props: { angebot },
  }));
}

const { angebot } = Astro.props;
const { Content } = await render(angebot);

// Page-level structured data: this one offer. Identity (Person/Organization)
// stays in the shared Layout and is referenced by @id, never duplicated.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const schema = [
  {
    "@type": "Service",
    "@id": `${canonical}#service`,
    name: angebot.data.title,
    description: angebot.data.teaser,
    serviceType: angebot.data.subtitle,
    provider: { "@id": `${SITE.url}/#person` },
    audience: { "@type": "Audience", audienceType: angebot.data.zielgruppe },
    areaServed: ["Rheinland-Pfalz", "Hamburg", "Deutschland"],
    mainEntityOfPage: { "@id": `${canonical}#webpage` },
  },
];
---

<Layout title={angebot.data.title} description={angebot.data.teaser} schema={schema}>
  <article>
    <section class="workshop-hero">
      <div class="mx-auto max-w-4xl px-5 pt-14 pb-12 sm:px-8 md:pt-20">
        <p class="u-eyebrow text-brand-700">{angebot.data.subtitle}</p>
        <h1 class="u-title mt-4 text-balance text-ink-900">
          {angebot.data.title}
        </h1>
        <p class="u-lede u-measure mt-6 text-ink-700">{angebot.data.teaser}</p>

        <dl class="mt-10 grid gap-x-10 border-t border-ink-200 sm:grid-cols-3">
          <div class="border-b border-ink-100 py-5 sm:border-b-0">
            <dt class="u-eyebrow text-ink-500">Zielgruppe</dt>
            <dd class="mt-2 text-[0.9375rem] text-ink-900">{angebot.data.zielgruppe}</dd>
          </div>
          <div class="border-b border-ink-100 py-5 sm:border-b-0">
            <dt class="u-eyebrow text-ink-500">Dauer</dt>
            <dd class="mt-2 text-[0.9375rem] text-ink-900">{angebot.data.dauer}</dd>
          </div>
          <div class="border-b border-ink-100 py-5 sm:border-b-0">
            <dt class="u-eyebrow text-ink-500">Honorar</dt>
            <dd class="mt-2 text-[0.9375rem] text-ink-900">{angebot.data.preis}</dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-5 pt-12 pb-20 sm:px-8">
      <div class="prose-content">
        <Content />
      </div>

      <div class="mt-20 rounded-3xl bg-brand-50 px-7 py-9 md:px-10 md:py-11">
        <h2 class="u-subtitle text-balance text-brand-900">Dieses Angebot buchen</h2>
        <p class="u-measure mt-4 leading-relaxed text-brand-900/85">
          Schreiben Sie mir kurz, wann und für welche Klasse(n) – ich melde mich werktags innerhalb von 48 Stunden zurück.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={EDU_PATHS.kontakt}
            class="inline-flex min-h-11 items-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-brand-50 transition hover:bg-brand-800"
          >
            Anfrage senden
          </a>
          <a
            href={`mailto:${SITE.email}?subject=${encodeURIComponent("Anfrage: " + angebot.data.title)}`}
            class="inline-flex min-h-11 items-center rounded-full border border-brand-300 px-6 text-[0.9375rem] font-medium text-brand-900 transition hover:border-brand-400"
          >
            Direkt per Mail
          </a>
        </div>
      </div>

      <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-ink-200 pt-6">
        <a href={EDU_PATHS.angebotAnchor} class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700 hover:text-brand-900">
          ← Alle Angebote
        </a>
        <a href={EDU_PATHS.insights} class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700 hover:text-brand-900">
          Einblicke aus durchgeführten Workshops →
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .workshop-hero {
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-brand-50) 85%, transparent),
      var(--color-canvas) 80%
    );
  }
</style>
