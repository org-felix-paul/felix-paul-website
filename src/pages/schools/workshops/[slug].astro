---
import { getCollection, render } from "astro:content";
import Layout from "../../../education/EduLayout.astro";
import { SITE } from "../../../consts";
import { EDU_PATHS } from "../../../education/consts";

export async function getStaticPaths() {
  // Preview-Angebote bekommen keine Detailseite.
  const angebote = (await getCollection("angebote")).filter((a) => !a.data.preview);
  return angebote.map((angebot) => ({
    params: { slug: angebot.id },
    props: { angebot },
  }));
}

const { angebot } = Astro.props;
const { Content } = await render(angebot);

// Page-level structured data: this one offer. Identity (Person/Organization)
// stays in the shared Layout and is referenced by @id, never duplicated.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const schema = [
  {
    "@type": "Service",
    "@id": `${canonical}#service`,
    name: angebot.data.title,
    description: angebot.data.teaser,
    serviceType: angebot.data.subtitle,
    provider: { "@id": `${SITE.url}/#person` },
    audience: { "@type": "Audience", audienceType: angebot.data.zielgruppe },
    areaServed: ["Rheinland-Pfalz", "Hamburg", "Deutschland"],
    mainEntityOfPage: { "@id": `${canonical}#webpage` },
  },
];
---

<Layout title={angebot.data.title} description={angebot.data.teaser} schema={schema}>
  <article>
    {/* Kopf eines Angebots: Label, Linie, Titel, Vorspann — und die drei
        Kenndaten als Rasterzellen mit Monolabel statt als drei Absätze in
        einer Karte. */}
    <section class="bg-surface">
      <div class="mx-auto max-w-4xl px-6 pt-10 pb-10">
        <p class="label text-brand-700">{angebot.data.subtitle}</p>
        <div class="mt-4 border-t border-rule pt-5">
          <h1 class="font-display text-3xl font-bold leading-tight tracking-tight text-ink-900 md:text-5xl">
            {angebot.data.title}
          </h1>
        </div>
        <p class="mt-6 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-700 md:text-lg">{angebot.data.teaser}</p>

        <dl class="cellgrid mt-8 sm:grid-cols-3">
          <div class="p-5">
            <dt class="label text-ink-500">Zielgruppe</dt>
            <dd class="mt-2 text-ink-900">{angebot.data.zielgruppe}</dd>
          </div>
          <div class="p-5">
            <dt class="label text-ink-500">Dauer</dt>
            <dd class="mt-2 text-ink-900">{angebot.data.dauer}</dd>
          </div>
          <div class="p-5">
            <dt class="label text-ink-500">Honorar</dt>
            <dd class="mt-2 font-semibold tabular-nums text-ink-900">{angebot.data.preis}</dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="mx-auto max-w-3xl border-t border-rule px-6 pt-10 pb-16">
      <div class="prose-content">
        <Content />
      </div>

      <div class="mt-12 border-t-2 border-brand-700 bg-brand-50 p-6 md:p-8">
        <h2 class="font-display text-xl font-bold text-ink-900 md:text-2xl">Dieses Angebot buchen</h2>
        <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-700">
          Schreiben Sie mir kurz, wann und für welche Klasse(n) – ich melde mich werktags innerhalb von 48 Stunden zurück.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href={EDU_PATHS.kontakt}
            class="inline-flex min-h-11 items-center justify-center bg-brand-700 px-5 text-sm font-semibold text-white transition hover:bg-brand-800"
          >
            Anfrage senden
          </a>
          <a
            href={`mailto:${SITE.email}?subject=${encodeURIComponent("Anfrage: " + angebot.data.title)}`}
            class="inline-flex min-h-11 items-center justify-center border border-rule bg-surface px-5 text-sm font-semibold text-ink-800 transition hover:border-brand-700 hover:text-brand-700"
          >
            Direkt per Mail
          </a>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-3">
        <a href={EDU_PATHS.angebotAnchor} class="label inline-flex min-h-11 items-center text-brand-700 hover:text-brand-900">
          ← Alle Angebote
        </a>
        <a href={EDU_PATHS.insights} class="label inline-flex min-h-11 items-center text-brand-700 hover:text-brand-900">
          Einblicke aus durchgeführten Workshops →
        </a>
      </div>
    </div>
  </article>
</Layout>
