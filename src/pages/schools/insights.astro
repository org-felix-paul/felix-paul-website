---
import Layout from "../../education/EduLayout.astro";
import Section from "../../education/components/Section.astro";
import { PROJECTS } from "../../consts";
import { EDU } from "../../education/consts";
---

<Layout
  title="Vergangene Workshops & Materialien"
  description="Aus vergangenen Workshops: NECK (Lernwebsite zu neuronalen Netzen), die Programmiertage Codenight und ReadMyBook – Lernsoftware und Material, die dabei entstanden sind."
>
  <Section
    as="h1"
    eyebrow="Workshops & Materialien"
    title="Aus vergangenen Workshops"
    lead="Entstandene Software und Impressionen aus vergangenen Workshops – eine wachsende Sammlung."
  >
    <!-- NECK -->
    <article class="border-t border-ink-200 pt-12">
      <div class="grid gap-10 md:grid-cols-[1.1fr_1fr] md:items-start">
        <div>
          <div class="u-eyebrow text-brand-700">Lernsoftware</div>
          <h2 class="u-title mt-4 text-balance text-ink-900">NECK – Network Construction Kit</h2>
          <p class="u-measure mt-5 leading-relaxed text-ink-600">
            Eine Lernwebsite, auf der Schüler:innen die Funktionsweise neuronaler Netze spielerisch
            erkunden. Geschrieben in reinem HTML, CSS und JavaScript – ganz ohne externe Bibliotheken.
            Sämtliche Abläufe, inklusive der Backpropagation, sind eigenständig implementiert.
          </p>
          <ul class="mt-6 space-y-2 border-t border-ink-100 pt-5 text-[0.9375rem] text-ink-600">
            <li>• Eigene neuronale Netze bauen (Neuronen anlegen, verbinden, verschieben, löschen)</li>
            <li>• Gewichte beim Training sperren, Bias aktivieren/deaktivieren</li>
            <li>• Lernverfahren, Aktivierungsfunktionen und Fehlermetriken wechseln</li>
            <li>• Netze und Trainingsdaten speichern und laden</li>
            <li>• Backpropagation, Gewichtsverlauf und Ausgaben visualisieren</li>
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={PROJECTS.neck}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-white transition hover:bg-brand-800"
            >
              NECK öffnen
            </a>
            <a
              href={PROJECTS.neckUserHandbook}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full border border-ink-300 px-6 text-[0.9375rem] font-medium text-ink-800 transition hover:border-ink-400 hover:text-brand-700"
            >
              Benutzerhandbuch
            </a>
            <a
              href={PROJECTS.neckDevHandbook}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full border border-ink-300 px-6 text-[0.9375rem] font-medium text-ink-800 transition hover:border-ink-400 hover:text-brand-700"
            >
              Entwicklerhandbuch
            </a>
          </div>
        </div>

        <div class="space-y-4">
          <a href={PROJECTS.neck} target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90">
            <img
              src={`${EDU.base}img/neck/neck.avif`}
              alt="Screenshot der NECK-Lernsoftware für neuronale Netze"
              class="w-full cursor-pointer rounded-2xl ring-1 ring-ink-200"
            />
          </a>
          <div class="overflow-hidden rounded-2xl ring-1 ring-ink-200">
            <div class="aspect-video w-full">
              <iframe
                class="h-full w-full"
                src="https://www.youtube.com/embed/2TRHbH5S06c?si=RM-VXEW3ibl5So8Q"
                title="NECK – Network Construction Kit (Video)"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen></iframe>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Codenight -->
    <article class="mt-20 border-t border-ink-200 pt-12">
      <div class="grid gap-10 md:grid-cols-[1fr_1.1fr] md:items-start">
        <div class="order-2 md:order-1">
          <a href={PROJECTS.codenight} target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90">
            <img
              src={`${EDU.base}img/codenight/lion.avif`}
              alt="Codenight – Programmiertage am Gymnasium Nieder-Olm"
              class="w-full cursor-pointer rounded-2xl ring-1 ring-ink-200"
            />
          </a>
        </div>
        <div class="order-1 md:order-2">
          <div class="u-eyebrow text-brand-700">Workshops · Programmiertage</div>
          <h2 class="u-title mt-4 text-balance text-ink-900">Codenight</h2>
          <p class="u-measure mt-5 leading-relaxed text-ink-600">
            Im März 2022 habe ich die Programmiertage „Codenight" am Gymnasium Nieder-Olm übernommen und
            fünf Workshops für alle Altersstufen geplant – von Website-Programmierung über
            Spieleentwicklung bis zu einer KI, die mit dem Minimax-Algorithmus Tic-Tac-Toe löst.
          </p>
          <p class="u-measure mt-4 leading-relaxed text-ink-600">
            Im Workshop „Tierwebsite" hat jede:r Schüler:in eine eigene Website über ein Tier in HTML und CSS
            programmiert – die verlinkte <strong class="text-ink-800">Tierpark-Website</strong> bündelt all diese
            Schüler-Seiten. Die <strong class="text-ink-800">Codenight-Website</strong> selbst entstand als
            begleitende Ergänzung mit allen Informationen zu den einzelnen Workshops.
          </p>
          <ul class="mt-6 space-y-2 border-t border-ink-100 pt-5 text-[0.9375rem] text-ink-600">
            <li>• <strong class="text-ink-800">Blockly</strong> – spielerische Grundlagen (Klasse 5–6)</li>
            <li>• <strong class="text-ink-800">Tierwebsite</strong> in HTML &amp; CSS (Klasse 5–8)</li>
            <li>• <strong class="text-ink-800">Autorennen</strong> in Scratch (Klasse 7–8)</li>
            <li>• <strong class="text-ink-800">Ping Pong</strong> in Scratch (Klasse 9–10)</li>
            <li>• <strong class="text-ink-800">Tic-Tac-Toe</strong> in Python mit Minimax (Oberstufe)</li>
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={PROJECTS.codenight}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-white transition hover:bg-brand-800"
            >
              Codenight ansehen
            </a>
            <a
              href={PROJECTS.tierpark}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full border border-ink-300 px-6 text-[0.9375rem] font-medium text-ink-800 transition hover:border-ink-400 hover:text-brand-700"
            >
              Tierpark-Website der Schüler:innen
            </a>
          </div>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <a href={PROJECTS.codenight} target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90">
          <img src={`${EDU.base}img/codenight/blockly.avif`} alt="Codenight-Workshop: Blockly" class="w-full cursor-pointer rounded-lg ring-1 ring-ink-200" />
        </a>
        <a href={PROJECTS.codenight} target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90">
          <img src={`${EDU.base}img/codenight/autorennen.avif`} alt="Codenight-Workshop: Autorennen in Scratch" class="w-full cursor-pointer rounded-lg ring-1 ring-ink-200" />
        </a>
        <a href={PROJECTS.codenight} target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90">
          <img src={`${EDU.base}img/codenight/pingpong.avif`} alt="Codenight-Workshop: Ping Pong in Scratch" class="w-full cursor-pointer rounded-lg ring-1 ring-ink-200" />
        </a>
        <a href={PROJECTS.codenight} target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90">
          <img src={`${EDU.base}img/codenight/tic-tac-toe.avif`} alt="Codenight-Workshop: Tic-Tac-Toe-KI in Python" class="w-full cursor-pointer rounded-lg ring-1 ring-ink-200" />
        </a>
      </div>
    </article>

    <!-- ReadMyBook -->
    <article class="mt-20 border-t border-ink-200 pt-12">
      <div class="grid gap-10 md:grid-cols-[1.1fr_1fr] md:items-start">
        <div>
          <div class="u-eyebrow text-brand-700">
            Android-App · KI / Texterkennung
          </div>
          <h2 class="u-title mt-4 text-balance text-ink-900">ReadMyBook</h2>
          <p class="u-measure mt-5 leading-relaxed text-ink-600">
            Eine App, die per Texterkennung (Google ML Kit) ein Kinderbuch vorliest. Entstanden als
            Ergänzung zum Kinderbuch einer Bekannten, mit dem Ziel, dass Kinder sich ein Buch auch
            dann vorlesen lassen können, wenn gerade niemand Zeit hat – sie scannen die Seite einfach
            selbst.
          </p>
          <p class="u-measure mt-4 leading-relaxed text-ink-600">
            Fachlich interessant ist daran, wie wenig KI nötig ist, damit etwas nützlich wird:
            Texterkennung und Sprachausgabe sind fertige Bausteine – die Arbeit steckt darin, sie für
            Kinderhände bedienbar zu machen (Nachtmodus, große Flächen, kein Konto, keine Werbung).
          </p>
          <p class="u-measure mt-4 text-sm leading-relaxed text-ink-500">
            <strong class="font-semibold text-ink-700">Dieses Projekt wurde eingestellt.</strong> Die
            Projektseite bleibt als Referenz erhalten.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={PROJECTS.readmybook}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-white transition hover:bg-brand-800"
            >
              ReadMyBook ansehen
            </a>
          </div>
        </div>

        <div>
          <a href={PROJECTS.readmybook} target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90">
            <img
              src={`${EDU.base}img/readmybook/readmybook-cover.jpg`}
              alt="ReadMyBook – App, die ein Kinderbuch per Texterkennung vorliest"
              loading="lazy"
              class="w-full cursor-pointer rounded-2xl ring-1 ring-ink-200"
            />
          </a>
        </div>
      </div>
    </article>

  </Section>
</Layout>
