    <!-- BLOG -->
    <!-- Bewusst im normalen Seitenlayout statt als dunkler Block: der Blog ist
         kein Angebot, und in der Übersicht oben steht er aus demselben Grund
         als schmale Leiste unter den drei Bereichen. Ein Kasten, der lauter ist
         als alles andere auf der Seite, widerspricht dieser Reihenfolge. -->
    <Section
      id="blog"
      index={nr("blog")}
      eyebrow="Blog"
      title="Mein persönlicher Blog"
      lead="Gedanken zu Themen, die mich umtreiben – IT-Sicherheit, KI, IT in der Bildung und vieles mehr. Für Professionals, Lehrkräfte, Eltern, Schüler:innen und Neugierige."
    >
      <!-- Beiträge als Verzeichnis mit durchlaufender Datumsspalte statt als
           drei gleich große Kacheln: drei Titel unterschiedlicher Länge in
           Kästen gleicher Höhe erzeugen vor allem Leerraum. -->
      <ul class="recordlist">
        {
          latestPosts.map((post) => (
            <li>
              <a href={postPath(post.id)} class="record group transition hover:bg-ink-50">
                <time datetime={post.data.pubDate.toISOString()} class="label text-ink-500">
                  {postFmt.format(post.data.pubDate)}
                </time>
                <span class="font-semibold leading-snug text-ink-900 group-hover:text-brand-700">
                  {post.data.title}
                </span>
                <svg class="hidden h-4 w-4 shrink-0 self-center text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-brand-700 sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-8">
        <a href={PATHS.blog} class={`${knopfSekundaer} gap-2`}>
          Alle Beiträge
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </Section>

    <!-- KONTAKT -->
    <Section
      id="kontakt"
      index={nr("kontakt")}
      eyebrow="Kontakt"
      title="Lassen Sie uns sprechen"
      lead="Ein Vortrag, ein Workshop,  eine Zusammenarbeit oder einfach eine Frage – eine kurze Nachricht genügt. Ich melde mich werktags innerhalb von 48 Stunden."
    >
      <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
        <ContactForm />

        <aside>
          <h2 class="label border-b border-rule pb-2 text-ink-500">Direkter Kontakt</h2>
          <dl class="recordlist border-t-0">
            <div class="record">
              <dt class="label text-ink-500">E-Mail</dt>
              <dd>
                <a class="text-brand-700 underline underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a>
              </dd>
            </div>
            <div class="record">
              <dt class="label text-ink-500">LinkedIn</dt>
              <dd>
                <a class="text-brand-700 underline underline-offset-4" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">Profil ansehen</a>
              </dd>
            </div>
            <div class="record">
              <dt class="label text-ink-500">GitHub</dt>
              <dd>
                <a class="text-brand-700 underline underline-offset-4" href={SITE.github} target="_blank" rel="noopener noreferrer">Profil ansehen</a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </Section>

    <!-- PRESSE / REDNERPROFIL -->
    <Section
      id="presse"
      index={nr("presse")}
      eyebrow="Presse & Rednerprofil"
      title="Material für Veranstalter & Presse"
      lead="Kurzbio, Foto und Rednerprofil – das Wichtigste auf einen Blick."
    >
      <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr]">
        <div class="border border-rule p-6 md:p-8">
          <h3 class="label border-b border-rule pb-2 text-ink-500">Kurzbio (zum Kopieren)</h3>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-700">
            Felix Paul ist Informatiker und Mathematiker mit Schwerpunkt IT Security, IAM, KI und Cloud. Hauptberuflich ist er
            Solution Architekt bei der Atruvia AG, dem IT-Dienstleister der genossenschaftlichen Banken. Daneben ist er auch freiberuflich sehr aktiv.
            Als Keynote-Speaker spricht er auf Konferenzen, an Universitäten
            und in Unternehmen. Außerdem hält er Vorträge an Schulen, vertreibt eigene Softwareprodukte und
            veröffentlichte ein Buch über Post-Quanten-Kryptographie bei Springer.
          </p>
          <dl class="recordlist mt-6">
            <div class="record">
              <dt class="label text-ink-500">Sprachen</dt>
              <dd class="text-ink-900">Deutsch · Englisch</dd>
            </div>
            <div class="record">
              <dt class="label text-ink-500">Kontakt</dt>
              <dd><a class="text-brand-700 underline underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
            </div>
          </dl>
        </div>

        <div class="border border-rule p-6 md:p-8">
          <h3 class="label border-b border-rule pb-2 text-ink-500">Downloads</h3>
          <ul class="recordlist border-t-0">
            <li>
              <a href="/pdf/rednerprofil.pdf" download class="flex min-h-14 items-center justify-between gap-4 text-sm font-semibold text-ink-800 transition hover:text-brand-700">
                Rednerprofil (PDF)
                <span class="label text-ink-400">PDF</span>
              </a>
            </li>
            <li>
              <a href={PORTRAIT.press} download class="flex min-h-14 items-center justify-between gap-4 text-sm font-semibold text-ink-800 transition hover:text-brand-700">
                Pressefoto (Porträt)
                <span class="label text-ink-400">PNG</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </Section>
  </DocGrid>
</Layout>
