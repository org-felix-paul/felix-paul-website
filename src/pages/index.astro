---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE, PATHS, PORTRAIT } from "../consts";
import { EDU_PATHS, angebotPath } from "../education/consts";
import { postPath } from "../blog/consts";
import { NEWS_KIND_LABELS } from "../news/collection";

// The home page pulls the education offers, the latest posts and the news log
// straight from the same collections the sub-pages use. That is deliberate:
// a visitor who only scrolls this page should see the real content, and there
// is no second copy of it to drift out of sync.
const angebote = (await getCollection("angebote", ({ data }) => !data.preview)).sort(
  (a, b) => a.data.order - b.data.order,
);

const latestPosts = (await getCollection("posts", ({ data }) => !data.draft && !data.preview))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const newsItems = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const newsFmt = new Intl.DateTimeFormat("de-DE", { year: "numeric", month: "long" });
const postFmt = new Intl.DateTimeFormat("de-DE", { year: "numeric", month: "short", day: "numeric" });

// Orientation strip at the top of the page: one line per area, no selling.
// The detail lives in #speaking and #bildung further down, so this stays a
// signpost rather than a second copy of the offer.
const orientation = [
  {
    label: "Keynotes & Fachvorträge",
    line: "Vorträge und Beratung zu KI, IT-Sicherheit, Cloud, IAM und Kryptographie.",
    href: "#speaking",
    bar: "bg-brand-500",
  },
  {
    label: "Bildungsangebote",
    line: "Workshops und Fortbildungen für Unternehmen, Schulen und Privatpersonen.",
    href: "#bildung",
    bar: "bg-emerald-500",
  },
  {
    label: "Software",
    line: "Lauffähige Software und Projekte über dSolve.",
    href: SITE.dSolveSite,
    bar: "bg-amber-500",
  },
  {
    // Kein Angebot, deshalb optisch zurückgenommen (graue Marke statt Akzentfarbe).
    label: "Blog",
    line: "Beiträge zu Themen die mich beschäftigen wie KI, IT-Sicherheit und schulische Bildung.",
    href: PATHS.blog,
    bar: "bg-ink-300",
  },
] as const;

// Speaking topics — one card per talk that stands on its own. Deliberately
// one sentence each: this section is a menu, not the talk itself.
const topics = [
  {
    title: "Künstliche Intelligenz",
    text: "Funktionsweise, (un)sinnvolle Einsatzgebiete, KI-Integrationsarchitekturen (A2A, MCP, REST) und kosteneffiziente Einsatzskalierung (Von AI Gateway über Sandboxes, Filtermechanismen, ...)",
  },
  {
    title: "Identity & Access Management",
    text: "Moderne Authentifizierung, Autorisierung und Zero Trust in hybriden Cloudumgebungen richtig einsetzen.",
  },
  {
    title: "IT Security",
    text: "Lehrbuch gegen gelebte Praxis. Wie findet man den richtigen Trade-Off zwischen Security, Kosten, Usability und Wartbarkeit – Einblicke aus der Finanzbranche",
  },
  {
    title: "Cloud",
    text: "Was wirklich skaliert, was nur kostet, hybride Szenarien und welche Architekturentscheidungen sich später kaum noch korrigieren lassen.",
  },
  {
    title: "Kryptographie",
    text: "Fully Homomorphic Encryption – Rechnen auf verschlüsselten Daten – und Post-Quanten-Kryptographie, mathematischer Deep Dive oder  pragmatische Migrationsroadmap.",
  },
];

// Sechste Kachel im Raster: kurze Stichworte statt ausformulierter Themen,
// damit die Liste wachsen kann, ohne den Abschnitt zu verlängern.
const weitereThemen = [
  "Gesellschaftliche Folgen von KI",
  "Skalierungsprobleme bei Enterprise-IT",
  "..."
];
---

<Layout>
  <Hero />

  <!-- ORIENTIERUNG -->
  <!-- Bewusst knapp: eine Zeile pro Bereich, damit klar wird, was es gibt und
       wo es weitergeht. Die eigentlichen Inhalte stehen weiter unten
       (#speaking, #bildung) — hier wird nicht verkauft, hier wird sortiert. -->
  <Section
    id="saeulen"
    eyebrow="Überblick"
    title="Was ich mache"
    lead="Drei Bereiche – dazu ein Blog, in dem ich schreibe, was mich gerade beschäftigt."
  >
    <ul class="mx-auto max-w-3xl divide-y divide-ink-100 overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-sm">
      {
        orientation.map((o) => {
          const external = o.href.startsWith("http");
          return (
            <li>
              <a
                href={o.href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class="group flex items-center gap-4 px-5 py-4 transition hover:bg-ink-50 sm:px-6"
              >
                <span class={`h-8 w-1 shrink-0 rounded-full ${o.bar}`} aria-hidden="true" />
                <span class="flex-1">
                  <span class="block font-semibold text-ink-900">{o.label}</span>
                  <span class="block text-sm leading-relaxed text-ink-600">{o.line}</span>
                </span>
                <svg
                  class="h-4 w-4 shrink-0 text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-brand-700"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </li>
          );
        })
      }
    </ul>
  </Section>

  <!-- ÜBER MICH -->
  <Section id="ueber-mich"
    background="muted" eyebrow="Über mich" title="Kurz zu mir">
    <div class="mx-auto max-w-5xl">
      <div class="grid items-start gap-10 md:grid-cols-[auto_1fr]">
        <figure class="mx-auto w-full max-w-xs">
          <img
            src={PORTRAIT.image}
            alt={`${SITE.author} – persönliches Foto`}
            width="640"
            height="800"
            class="aspect-[4/5] w-full rounded-2xl object-cover shadow-md ring-1 ring-ink-200"
            loading="lazy"
          />
        </figure>

        <div>
          <div class="prose-content">
            <p>
              Was mich antreibt: Immer Neues zu lernen, die Welt um mich herum zu verstehen, Dinge selbst umzusetzen und das gewonnene Wissen
               weiterzugeben.
            </p>
            <p>  
              Den ausführlichen Lebenslauf gibt es auf <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
            </p>
          </div>

          <figure class="mt-8">
            <figcaption class="text-sm font-semibold uppercase tracking-widest text-brand-700">
              Mein Hintergrund
            </figcaption>
            <div class="mt-6">
              <!-- Drei Gruppen nebeneinander, Unterkanten der Blöcke bündig:
                   die beiden Studienstränge und daneben die Praxiserfahrung,
                   die über die volle Höhe beider Reihen läuft. Jede Gruppe hat
                   eine dünne Bildunterschrift, damit klar ist, wofür M.Ed.
                   steht. Auf Mobil bricht die Praxis in eine eigene Zeile. -->
              <div class="flex flex-col gap-4">
                <div class="flex flex-wrap items-end gap-4 sm:gap-6">
                  <!-- Fachstudium: Informatik (B.Sc. + M.Sc.) und Mathematik (B.Sc.) -->
                  <div>
                    <div class="flex items-end gap-2 sm:gap-3">
                      <div class="flex flex-col gap-2">
                        <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-brand-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-brand-900 ring-1 ring-brand-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">M.Sc. Informatik</div>
                        <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-brand-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-brand-900 ring-1 ring-brand-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">B.Sc. Informatik</div>
                      </div>
                      <div class="flex flex-col gap-2">
                        <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-brand-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-brand-900 ring-1 ring-brand-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">B.Sc. Mathematik</div>
                      </div>
                    </div>
                    <p class="mt-2 text-center text-[0.65rem] font-medium uppercase tracking-wider text-ink-500 sm:text-xs">
                      Fachstudium
                    </p>
                  </div>

                  <!-- Lehramtsstudium: B.Ed. + M.Ed. -->
                  <div>
                    <div class="flex flex-col gap-2">
                      <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-emerald-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-emerald-900 ring-1 ring-emerald-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">M.Ed. Mathematik &amp; Informatik</div>
                      <div class="flex h-14 w-20 items-center justify-center rounded-xl bg-emerald-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-emerald-900 ring-1 ring-emerald-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs">B.Ed. Mathematik &amp; Informatik</div>
                    </div>
                    <p class="mt-2 text-center text-[0.65rem] font-medium uppercase tracking-wider text-ink-500 sm:text-xs">
                      Lehramtsstudium
                    </p>
                  </div>

                  <!-- Praxiserfahrung: gleiche Höhe wie beide Block-Reihen
                       zusammen, breiter und farblich dominant. -->
                  <div class="w-full sm:w-auto sm:flex-1">
                    <div class="flex h-16 w-full items-center justify-center rounded-xl bg-brand-600 px-4 text-white shadow-sm ring-1 ring-brand-700 sm:h-[8.5rem] sm:min-w-[12rem]">
                      <span class="text-center text-sm font-semibold uppercase tracking-wider sm:text-base">
                        Praxiserfahrung
                      </span>
                    </div>
                    <p class="mt-2 text-center text-[0.65rem] font-medium uppercase tracking-wider text-ink-500 sm:text-xs">
                      Konkrete Umsetzung
                    </p>
                  </div>
                </div>

                <p class="text-xs leading-relaxed text-ink-500">
                  Drei vollständige Studiengänge nebeneinander: Informatik und Mathematik fachlich,
                  Lehramt didaktisch. Dazu die tägliche Praxis als Enterprise Architect in der
                  Finanzbranche – deshalb bleiben Vorträge und Workshops nah an dem, was wirklich
                  passiert.
                </p>
              </div>
          </figure>
        </div>
      </div>
    </div>
  </Section>

  <!-- SPEAKING -->
  <Section
    id="speaking"
    eyebrow="Speaking & Consulting"
    title="Keynotes & Fachvorträge"
    lead="Ich spreche und berate auf Konferenzen, an Universitäten und in Unternehmen über KI, IT Security und andere spannende IT Themen."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        topics.map((t) => (
          <div class="rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-ink-900">{t.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{t.text}</p>
          </div>
        ))
      }

      <!-- Sechste Kachel: weitere Themen als Stichwortliste. Gleiche Größe wie
           die anderen, aber zurückgenommen (grauer Rahmen, kleinere Schrift). -->
      <div class="rounded-2xl border border-dashed border-ink-300 bg-ink-50 p-6">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-500">Weitere Themen</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-ink-600">
          {
            weitereThemen.map((t) => (
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-400" aria-hidden="true" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-brand-200 bg-brand-50 p-6 text-center shadow-sm">
      <h3 class="text-lg font-semibold text-ink-900">Consulting</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-600">Beratung zu diesen Themen ist  natürlich auch möglich. Egal, ob Konzeption, Architektur-Review oder Hands-On Umsetzung.</p>
    </div>

    {/* YouTube-Vorträge vorübergehend ausgeblendet – zum Reaktivieren die umschließenden {/​* *​/}-Marker entfernen. Siehe README. */}
    {/*
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <div class="aspect-video w-full overflow-hidden rounded-2xl border border-ink-200 shadow-sm">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/4JBXO_SQuJM"
            title="Fully Homomorphic Encryption and its Use Cases (englischer Vortrag)"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
        <p class="mt-3 text-sm text-ink-600">Englisch – „Fully Homomorphic Encryption and its Use Cases".</p>
      </div>
      <div>
        <div class="aspect-video w-full overflow-hidden rounded-2xl border border-ink-200 shadow-sm">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/awbrW_Rl2nU"
            title="Fully Homomorphic Encryption – KI in der Cloud ohne Datenschutzbedenken (deutscher Vortrag)"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
        <p class="mt-3 text-sm text-ink-600">Deutsch – „FHE – KI in der Cloud ohne Datenschutzbedenken".</p>
      </div>
    </div>
    */}

    <div class="mt-10 text-center">
      <a href="#kontakt" class="rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800">
        Jetzt anfragen
      </a>
      <p class="mx-auto mt-4 max-w-xl text-sm text-ink-500">
        Ihr Thema ist nicht dabei? Sprechen Sie mich gerne an.
      </p>
    </div>
  </Section>

  <!-- BILDUNGSANGEBOTE -->
  <!-- Die Karten kommen aus derselben Content-Collection wie /education/, aber
       bewusst knapper: hier steht nur, WAS es gibt (Titel, Untertitel, Teaser).
       Zielgruppe, Dauer und Preis – also alles, was man zum Abwägen braucht –
       stehen auf /education/ und der jeweiligen Angebotsseite. Wer nur diese
       Seite scrollt, kennt trotzdem jedes Angebot beim Namen. -->
  <Section
    id="bildung"
    background="muted"
    eyebrow="Bildung"
    title="Bildungsangebote"
    lead="Workshops, Vorträge und Fortbildungen zu KI, IT-Sicherheit und Medienkompetenz – für Schulen, Lehrkräfte, Eltern und Schüler:innen, zunehmend auch in der Erwachsenenbildung."
  >
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        angebote.map((a) => (
          <a
            href={angebotPath(a.id)}
            class="group flex h-full flex-col rounded-2xl border border-ink-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md"
          >
            <h3 class="text-base font-semibold text-ink-900">{a.data.title}</h3>
            <p class="mt-1 text-sm text-emerald-700">{a.data.subtitle}</p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{a.data.teaser}</p>
          </a>
        ))
      }
    </div>

    <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={PATHS.education}
        class="rounded-lg bg-emerald-600 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-emerald-700"
      >
        Alle Bildungsangebote ansehen
      </a>
      <a
        href={EDU_PATHS.projekte}
        class="rounded-lg border border-ink-200 bg-white px-5 py-3 text-sm font-medium text-ink-800 shadow-sm transition hover:border-emerald-300 hover:text-emerald-700"
      >
        Einblicke aus Workshops
      </a>
    </div>
  </Section>

  <!-- PUBLIKATIONEN -->
  <Section
    id="publikationen"
    eyebrow="Publikationen"
    title="Buch & Paper"
    lead="Forschung zu Kryptographie und KI – als Buch bei Springer und als Fachbeiträge."
  >
    <!-- Buch -->
    <article class="rounded-3xl border border-ink-200 bg-white p-6 shadow-sm md:p-10">
      <div class="grid gap-8 md:grid-cols-[auto_1fr] md:items-start">
        <img
          src="/img/goppa-book/cover.avif"
          alt="Buchcover: Goppa Codes and the McEliece Cryptosystem (Springer BestMasters)"
          width="500"
          height="709"
          class="mx-auto w-44 rounded-xl shadow-lg ring-1 ring-ink-200 sm:w-52"
          loading="lazy"
        />
        <div>
          <h3 class="font-display text-2xl font-bold text-ink-900">Goppa Codes and the McEliece Cryptosystem</h3>
          <p class="mt-3 leading-relaxed text-ink-600">
            Eine fundierte Einführung in das McEliece-Kryptosystem – von den mathematischen Basics bis zur konkreten
            Implementierung.
          </p>
          <div class="mt-5 grid grid-cols-3 gap-3">
            <a href="/pdf/goppa-book/uebersicht.pdf" class="group block overflow-hidden rounded-lg border border-ink-200">
              <img src="/img/goppa-book/uebersicht.png" alt="Kapitelübersicht des Buches" class="h-28 w-full object-cover object-top transition group-hover:scale-[1.02]" loading="lazy" />
            </a>
            <a href="/pdf/goppa-book/leseprobe.pdf" class="group block overflow-hidden rounded-lg border border-ink-200">
              <img src="/img/goppa-book/leseprobe.png" alt="Leseprobe aus dem Buch" class="h-28 w-full object-cover object-top transition group-hover:scale-[1.02]" loading="lazy" />
            </a>
            <a href="/pdf/goppa-book/literaturverzeichnis.pdf" class="group block overflow-hidden rounded-lg border border-ink-200">
              <img src="/img/goppa-book/literaturverzeichnis.png" alt="Literaturverzeichnis des Buches" class="h-28 w-full object-cover object-top transition group-hover:scale-[1.02]" loading="lazy" />
            </a>
          </div>
          <p class="mt-3 text-xs text-ink-500">Klicken Sie auf eine Vorschau, um Kapitelübersicht, Leseprobe oder Literaturverzeichnis als PDF zu öffnen.</p>
          <div class="mt-5 flex flex-wrap gap-2 text-sm font-medium">
            <a
              href="https://link.springer.com/book/10.1007/978-3-658-46743-2"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-brand-700 px-4 py-2 text-white shadow-sm transition hover:bg-brand-800"
            >
              Bei Springer ansehen &amp; kaufen
            </a>
          </div>
        </div>
      </div>
    </article>

    <!-- Paper -->
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="flex h-full flex-col rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-widest text-brand-700">Fachbeitrag · Kryptographie</div>
        <h3 class="mt-2 text-lg font-semibold text-ink-900">Fully Homomorphic Encryption and its Use Cases</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">
          Survey-Paper darüber, wie FHE Berechnungen auf verschlüsselten Daten ermöglicht – inklusive Vortrag und Folien.
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-sm font-medium">
          <a href="/pdf/fhe-survey.pdf" class="rounded-lg bg-brand-700 px-4 py-2 text-white shadow-sm transition hover:bg-brand-800">Paper (PDF)</a>
          <a href="/pdf/slides-fhe-use-cases-without-notes.pdf" class="rounded-lg border border-ink-200 px-4 py-2 text-ink-800 transition hover:border-brand-300 hover:text-brand-700">Folien (PDF)</a>
        </div>
      </div>

      <div class="flex h-full flex-col rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-widest text-brand-700">Fachbeitrag · KI</div>
        <h3 class="mt-2 text-lg font-semibold text-ink-900">Science-Gym: a simple testbed for AI-driven scientific discovery</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">
          Eine einfache Testumgebung, um zu untersuchen, wie KI selbstständig wissenschaftliche Zusammenhänge entdecken kann – erschienen in <em>Machine Learning</em> (Springer).
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-sm font-medium">
          <a href="https://link.springer.com/article/10.1007/s10994-025-06914-x" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-brand-700 px-4 py-2 text-white shadow-sm transition hover:bg-brand-800">Artikel ansehen</a>
        </div>
      </div>
    </div>
  </Section>

  <!-- AKTUELLES -->
  <!-- Gepflegt über src/news/content/*.md — eine Datei pro Eintrag.
       Der Abschnitt blendet sich aus, solange es keine Einträge gibt. -->
  {
    newsItems.length > 0 && (
      <Section
        id="aktuelles"
    background="muted"
        eyebrow="Aktuelles"
        title="Zuletzt gemacht"
        lead="Gehaltene Workshops und Vorträge, Veröffentlichungen und Releases – in umgekehrter Reihenfolge."
      >
        <ol class="mx-auto max-w-3xl space-y-3">
          {newsItems.map((n) => (
            <li class="rounded-2xl border border-ink-200 bg-white p-5 shadow-sm">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="inline-flex rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-brand-700">
                  {NEWS_KIND_LABELS[n.data.kind]}
                </span>
                <time datetime={n.data.date.toISOString()} class="text-xs text-ink-500">
                  {newsFmt.format(n.data.date)}
                </time>
                {n.data.location && <span class="text-xs text-ink-500">· {n.data.location}</span>}
              </div>
              <h3 class="mt-2 text-base font-semibold text-ink-900">{n.data.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-600">{n.data.summary}</p>
              {n.data.url && (
                <a
                  href={n.data.url}
                  class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-700 hover:text-brand-900"
                >
                  {n.data.urlLabel ?? "Mehr dazu"}
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              )}
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  <!-- BLOG -->
  <Section id="blog">
    <div class="rounded-3xl bg-gradient-to-br from-brand-700 to-brand-900 p-8 text-white md:p-12">
      <div class="grid items-center gap-8 md:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-200">Blog</p>
          <h2 class="mt-2 font-display text-3xl font-bold leading-tight md:text-4xl">Mein persönlicher Blog</h2>
          <p class="mt-4 max-w-xl text-brand-100">
            Gedanken zu Themen, die mich umtreiben – IT Security, KI, IT in der Bildung und eigene spannende Tech-Projekte. Für Professionals, Lehrer, Eltern, Schüler und allgemeine Tech-Enthusiast:innen.
          </p>
          <a
            href={PATHS.blog}
            class="mt-6 inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-medium text-brand-800 shadow-sm transition hover:bg-brand-50"
          >
            Zum Blog
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
        <ul class="grid gap-3 text-sm">
          {
            latestPosts.map((post) => (
              <li>
                <a
                  href={postPath(post.id)}
                  class="block rounded-xl bg-white/10 px-4 py-3 transition hover:bg-white/20"
                >
                  <span class="block font-medium leading-snug text-white">{post.data.title}</span>
                  <time datetime={post.data.pubDate.toISOString()} class="mt-1 block text-xs text-brand-200">
                    {postFmt.format(post.data.pubDate)}
                  </time>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- KONTAKT -->
  <Section
    id="kontakt"
    background="muted"
    eyebrow="Kontakt"
    title="Lassen Sie uns sprechen"
    lead="Ein Vortrag, ein Workshop,  eine Zusammenarbeit oder einfach eine Frage – eine kurze Nachricht genügt. Ich melde mich werktags innerhalb von 48 Stunden."
  >
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr]">
      <ContactForm />

      <aside class="space-y-6">
        <div class="rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-lg font-semibold text-ink-900">Direkter Kontakt</h2>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <div class="font-medium text-ink-500">E-Mail</div>
              <a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </li>
            <li>
              <div class="font-medium text-ink-500">LinkedIn</div>
              <a class="text-brand-700 underline" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">Profil ansehen</a>
            </li>
            <li>
              <div class="font-medium text-ink-500">GitHub</div>
              <a class="text-brand-700 underline" href={SITE.github} target="_blank" rel="noopener noreferrer">Profil ansehen</a>
            </li>
          </ul>
        </div>

      </aside>
    </div>
  </Section>
  <!-- PRESSE / REDNERPROFIL -->
  <Section
    id="presse"
    eyebrow="Presse & Rednerprofil"
    title="Material für Veranstalter & Presse"
    lead="Kurzbio, Foto und Rednerprofil – das Wichtigste auf einen Blick."
  >
    <div class="grid gap-6 md:grid-cols-[1.4fr_1fr]">
      <div class="rounded-2xl border border-ink-200 bg-white p-6 shadow-sm md:p-8">
        <h3 class="font-display text-lg font-semibold text-ink-900">Kurzbio (zum Kopieren)</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-700">
          Felix Paul ist Informatiker und Mathematiker mit Schwerpunkt IT Security, KI und Cloud. Hauptberuflich ist er
          Enterprise Architect bei der Atruvia AG, dem IT-Dienstleister der genossenschaftlichen Banken. Daneben ist er auch freiberuflich sehr aktiv. 
          Als Keynote-Speaker spricht er auf Konferenzen, an Universitäten
          und in Unternehmen über IT-Security, KI und weitere IT-Themen. Außerdem hält er Vorträge an Schulen, vertreibt eigene Softwareprodukte und 
          veröffentlichte ein Buch über Post-Quanten-Kryptographie bei Springer.
        </p>
        <dl class="mt-6 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
          <div><dt class="font-medium text-ink-500">Sprachen</dt><dd class="mt-1 text-ink-900">Deutsch · Englisch</dd></div>
          <div><dt class="font-medium text-ink-500">Kontakt</dt><dd class="mt-1"><a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        </dl>
      </div>

      <div class="flex flex-col gap-4 rounded-2xl border border-ink-200 bg-white p-6 shadow-sm md:p-8">
        <h3 class="font-display text-lg font-semibold text-ink-900">Downloads</h3>
        <a href="/pdf/rednerprofil-felix-paul.pdf" download class="flex items-center justify-between rounded-lg border border-ink-200 px-4 py-3 text-sm font-medium text-ink-800 transition hover:border-brand-300 hover:text-brand-700">
          Rednerprofil (PDF)
          <span class="text-xs text-ink-400">PDF</span>
        </a>
        <a href={PORTRAIT.press} download class="flex items-center justify-between rounded-lg border border-ink-200 px-4 py-3 text-sm font-medium text-ink-800 transition hover:border-brand-300 hover:text-brand-700">
          Pressefoto (Porträt)
          <span class="text-xs text-ink-400">PNG</span>
        </a>
      </div>
    </div>
  </Section>

</Layout>
