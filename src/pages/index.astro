---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import DocGrid from "../components/DocGrid.astro";
import Section from "../components/Section.astro";
import ContactForm from "../components/ContactForm.astro";
import { nummernGeber, type RailItem } from "../components/outline";
import { SITE, PATHS, PORTRAIT } from "../consts";
import { EDU_PATHS, angebotPath } from "../education/consts";
import ZielgruppenHinweis from "../education/components/ZielgruppenHinweis.astro";
import { postPath } from "../blog/consts";
import { NEWS_KIND_LABELS } from "../news/collection";

// The home page pulls the education offers, the latest posts and the news log
// straight from the same collections the sub-pages use. That is deliberate:
// a visitor who only scrolls this page should see the real content, and there
// is no second copy of it to drift out of sync.
const alleAngebote = (await getCollection("angebote", ({ data }) => !data.preview)).sort(
  (a, b) => a.data.order - b.data.order,
);
// Only a taste on the home page: the full catalogue is what /schools/ is
// for, and repeating all of it here left nothing to click through to.
const angebote = alleAngebote.slice(0, 2);
const weitereAngebote = alleAngebote.length - angebote.length;

const latestPosts = (await getCollection("posts", ({ data }) => !data.draft && !data.preview))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const newsItems = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const newsFmt = new Intl.DateTimeFormat("de-DE", { year: "numeric", month: "long" });
const postFmt = new Intl.DateTimeFormat("de-DE", { year: "numeric", month: "short", day: "numeric" });

// ── Die Gliederung der Seite ──────────────────────────────────────────────
// Eine Liste, zwei Verbraucher: das Abschnittsverzeichnis in der Seitenspalte
// (Reihenfolge, Beschriftung, Ankerziel) und die Nummer über jeder
// Überschrift. Ein Abschnitt, der hier fehlt, taucht auch im Verzeichnis nicht
// auf — und keine Nummer kann von Hand danebengeraten.
const OUTLINE: readonly RailItem[] = [
  { id: "saeulen", label: "Überblick" },
  { id: "ueber-mich", label: "Über mich" },
  { id: "speaking", label: "Speaking & Consulting" },
  { id: "bildung", label: "Bildung" },
  { id: "software", label: "Software" },
  { id: "publikationen", label: "Publikationen" },
  { id: "blog", label: "Blog" },
  { id: "kontakt", label: "Kontakt" },
  { id: "presse", label: "Presse & Rednerprofil" },
];
const nr = nummernGeber(OUTLINE);

// Orientation strip at the top of the page: one line per area, no selling.
// The detail lives in #speaking and #bildung further down, so this stays a
// signpost rather than a second copy of the offer.
const orientation = [
  {
    label: "Keynotes & Fachvorträge",
    line: "Vorträge und Beratung zu KI, IT-Sicherheit, Cloud, IAM und Kryptographie.",
    href: "#speaking",
    bar: "bg-brand-500",
  },
  {
    label: "Bildungsangebote",
    line: "Workshops und Fortbildungen für Unternehmen, Schulen und Privatpersonen.",
    href: "#bildung",
    bar: "bg-emerald-500",
  },
  {
    label: "Software",
    line: "Lauffähige Software und Projekte über dSolve.",
    href: "#software",
    bar: "bg-amber-500",
  },
  {
    // Kein Angebot, deshalb optisch zurückgenommen (graue Marke statt Akzentfarbe).
    // Wie die anderen Zeilen ein Anker auf den Abschnitt weiter unten, nicht
    // direkt auf /blog/ — der Absprung auf die Blogseite steht dort.
    label: "Blog",
    line: "Beiträge zu Themen die mich beschäftigen wie KI, IT-Sicherheit und schulische Bildung.",
    href: "#blog",
    bar: "bg-ink-300",
  },
] as const;

// Speaking topics — one card per talk that stands on its own. Deliberately
// one sentence each: this section is a menu, not the talk itself.
const topics = [
  {
    title: "Künstliche Intelligenz",
    text: "Funktionsweise, (un)sinnvolle Einsatzgebiete, KI-Integrationsarchitekturen (A2A, MCP, REST) und kosteneffiziente Einsatzskalierung (Von AI Gateway über Sandboxes, Filtermechanismen, ...)",
  },
  {
    title: "Identity & Access Management",
    text: "Moderne Authentifizierung, Autorisierung und Zero Trust in hybriden Cloudumgebungen richtig einsetzen.",
  },
  {
    title: "IT Security",
    text: "Lehrbuch gegen gelebte Praxis. Wie findet man den richtigen Trade-Off zwischen Security, Kosten, Usability und Wartbarkeit – Einblicke aus der Finanzbranche",
  },
  {
    title: "Cloud",
    text: "Was wirklich skaliert, was nur kostet, hybride Szenarien und welche Architekturentscheidungen sich später kaum noch korrigieren lassen.",
  },
  {
    title: "Kryptographie",
    text: "Über Fully Homomorphic Encryption (Rechnen auf verschlüsselten Daten) bis Post-Quanten-Kryptographie (mathematischer Deep Dive oder pragmatische Migrationsroadmap).",
  },
];

// Sechste Zelle im Raster: kurze Stichworte statt ausformulierter Themen,
// damit die Liste wachsen kann, ohne den Abschnitt zu verlängern.
const weitereThemen = [
  "Gesellschaftliche Folgen von KI",
  "Skalierungsprobleme bei Enterprise-IT",
  "..."
];

// Die Studien- und Praxisblöcke von „Über mich" als Daten. Vorher standen sie
// als sieben fast identische Kästen im Markup, deren Unterkanten nur zufällig
// zusammenpassten; als Tabelle richten sie sich von selbst aus.
const qualifikation = [
  {
    gruppe: "Fachstudium",
    ton: "brand",
    eintraege: ["M.Sc. Informatik", "B.Sc. Informatik", "B.Sc. Mathematik"],
  },
  {
    gruppe: "Lehramtsstudium",
    ton: "emerald",
    eintraege: ["M.Ed. Mathematik & Informatik", "B.Ed. Mathematik & Informatik"],
  },
] as const;

const tonKlassen = {
  brand: "bg-brand-50 text-brand-900",
  emerald: "bg-emerald-50 text-emerald-900",
} as const;

// Die beiden Fachbeiträge als Datensätze — Kennung, Titel, ein Satz, Belege.
const paper = [
  {
    kennung: "Fachbeitrag · Kryptographie",
    titel: "Fully Homomorphic Encryption and its Use Cases",
    text: "Survey-Paper darüber, wie FHE Berechnungen auf verschlüsselten Daten ermöglicht – inklusive Vortrag und Folien.",
    links: [
      { href: "/pdf/fhe-survey.pdf", label: "Paper (PDF)", extern: false },
      { href: "/pdf/slides-fhe-use-cases-without-notes.pdf", label: "Folien (PDF)", extern: false },
    ],
  },
  {
    kennung: "Fachbeitrag · KI",
    titel: "Science-Gym: a simple testbed for AI-driven scientific discovery",
    textVorEm: "Eine einfache Testumgebung, um zu untersuchen, wie KI selbstständig wissenschaftliche Zusammenhänge entdecken kann – erschienen in ",
    em: "Machine Learning",
    textNachEm: " (Springer).",
    links: [
      {
        href: "https://link.springer.com/article/10.1007/s10994-025-06914-x",
        label: "Artikel ansehen",
        extern: true,
      },
    ],
  },
];

const buchVorschauen = [
  { href: "/pdf/goppa-book/uebersicht.pdf", img: "/img/goppa-book/uebersicht.png", alt: "Kapitelübersicht des Buches" },
  { href: "/pdf/goppa-book/leseprobe.pdf", img: "/img/goppa-book/leseprobe.png", alt: "Leseprobe aus dem Buch" },
  { href: "/pdf/goppa-book/literaturverzeichnis.pdf", img: "/img/goppa-book/literaturverzeichnis.png", alt: "Literaturverzeichnis des Buches" },
];

// Zwei Knopfformen für die ganze Seite. Rechteckig, mindestens 44px hoch.
const knopfPrimaer =
  "inline-flex min-h-11 items-center justify-center bg-brand-700 px-5 text-sm font-semibold text-white transition hover:bg-brand-800";
const knopfSekundaer =
  "inline-flex min-h-11 items-center justify-center border border-rule bg-surface px-5 text-sm font-semibold text-ink-800 transition hover:border-brand-700 hover:text-brand-700";
---

<Layout>
  <Hero />

  <DocGrid outline={OUTLINE} navLabel="Abschnitte dieser Seite">
    <!-- ORIENTIERUNG -->
    <!-- Bewusst knapp: eine Zeile pro Bereich, damit klar wird, was es gibt und
         wo es weitergeht. Die eigentlichen Inhalte stehen weiter unten
         (#speaking, #bildung) — hier wird nicht verkauft, hier wird sortiert. -->
    <Section id="saeulen" index={nr("saeulen")} eyebrow="Überblick" title="Was ich mache" lead="">
      <ul class="recordlist">
        {
          orientation.map((o) => {
            const external = o.href.startsWith("http");
            return (
              <li>
                <a
                  href={o.href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="group flex items-stretch gap-4 py-4 transition hover:bg-ink-50"
                >
                  <span class={`w-1 shrink-0 ${o.bar}`} aria-hidden="true" />
                  <span class="flex-1">
                    <span class="block font-semibold text-ink-900">{o.label}</span>
                    <span class="mt-0.5 block text-[0.9375rem] leading-relaxed text-ink-600">{o.line}</span>
                  </span>
                  <svg
                    class="mt-1 h-4 w-4 shrink-0 text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-brand-700"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </li>
            );
          })
        }
      </ul>
    </Section>

    <!-- ÜBER MICH -->
    <Section id="ueber-mich" index={nr("ueber-mich")} eyebrow="Über mich" title="Kurz zu mir">
      <div class="grid gap-8 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-10">
        <figure class="border border-rule">
          <img
            src={PORTRAIT.image}
            alt={`${SITE.author} – persönliches Foto`}
            width="640"
            height="800"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
        </figure>

        <div class="prose-content">
          <p>
            Was mich antreibt: Neues lernen, Zusammenhänge verstehen, selbst nachprüfen & umsetzen, Wissen teilen.
          </p>
          <p>
            Den ausführlichen Lebenslauf gibt es auf <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
          </p>
        </div>
      </div>

      <!-- Der Hintergrund als Tabelle: eine Zeile pro Strang, links die
           Bezeichnung, rechts die Abschlüsse als gleich große Rasterfelder. -->
      <figure class="mt-10">
        <figcaption class="label border-b border-rule pb-2 text-brand-700">Mein Hintergrund</figcaption>

        <dl>
          {
            qualifikation.map((q) => (
              <div class="grid gap-3 border-b border-rule-soft py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
                <dt class="label pt-1 text-ink-500">{q.gruppe}</dt>
                <dd class="cellgrid grid-cols-2 sm:grid-cols-3">
                  {q.eintraege.map((e) => (
                    <span class={`flex min-h-14 items-center justify-center px-2 py-2 text-center text-xs font-semibold leading-tight ${tonKlassen[q.ton]}`}>
                      {e}
                    </span>
                  ))}
                  {/* Füllfeld: ohne es stünde in der dreispaltigen Zeile mit nur
                      zwei Abschlüssen die Rahmenfläche offen — ein graues Loch
                      im Raster. Leer, aber Fläche. */}
                  {q.eintraege.length < 3 && <span class="hidden sm:block" aria-hidden="true" />}
                </dd>
              </div>
            ))
          }

          <div class="grid gap-3 border-b border-rule py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
            <dt class="label pt-1 text-ink-500">Konkrete Umsetzung</dt>
            <dd>
              <span class="flex min-h-14 items-center justify-center bg-brand-700 px-4 py-2 text-center text-sm font-semibold tracking-wider text-white uppercase">
                Praxiserfahrung
              </span>
            </dd>
          </div>
        </dl>

        <p class="mt-4 max-w-2xl text-[0.8125rem] leading-relaxed text-ink-500">
          Drei vollständige Studiengänge nebeneinander: Informatik und Mathematik fachlich,
          Lehramt didaktisch. Dazu die tägliche Praxis als Solution Architekt in der
          Finanzbranche – deshalb bleiben Vorträge und Workshops nah an dem, was wirklich
          passiert.
        </p>
      </figure>
    </Section>

    <!-- SPEAKING -->
    <Section
      id="speaking"
      index={nr("speaking")}
      eyebrow="Speaking & Consulting"
      title="Keynotes & Fachvorträge"
      lead="Ich spreche und berate auf Konferenzen, an Universitäten und in Unternehmen über die folgenden Themen."
    >
      <div class="cellgrid sm:grid-cols-2 xl:grid-cols-3">
        {
          topics.map((t) => (
            <div class="p-5">
              <h3 class="text-base font-semibold text-ink-900">{t.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-600">{t.text}</p>
            </div>
          ))
        }

        <!-- Sechste Zelle: weitere Themen als Stichwortliste. Gleiche Größe wie
             die anderen, aber zurückgenommen (grauer Grund, kleinere Schrift). -->
        <div class="bg-ink-50 p-5">
          <h3 class="label text-ink-500">Weitere Themen</h3>
          <ul class="mt-3 space-y-1.5 text-[0.9375rem] text-ink-600">
            {
              weitereThemen.map((t) => (
                <li class="flex items-start gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 bg-ink-400" aria-hidden="true" />
                  <span>{t}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-8 border-t-2 border-brand-700 bg-brand-50 p-6">
        <h3 class="text-base font-semibold text-ink-900">Consulting</h3>
        <p class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-700">Beratung zu diesen Themen ist  natürlich auch möglich. Egal, ob Konzeption, Architektur-Review oder Hands-On Umsetzung.</p>
      </div>

      {/* YouTube-Vorträge vorübergehend ausgeblendet – zum Reaktivieren die umschließenden {/​* *​/}-Marker entfernen. Siehe README. */}
      {/*
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <div>
          <div class="aspect-video w-full overflow-hidden border border-rule">
            <iframe
              class="h-full w-full"
              src="https://www.youtube.com/embed/4JBXO_SQuJM"
              title="Fully Homomorphic Encryption and its Use Cases (englischer Vortrag)"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen></iframe>
          </div>
          <p class="mt-3 text-sm text-ink-600">Englisch – „Fully Homomorphic Encryption and its Use Cases".</p>
        </div>
        <div>
          <div class="aspect-video w-full overflow-hidden border border-rule">
            <iframe
              class="h-full w-full"
              src="https://www.youtube.com/embed/awbrW_Rl2nU"
              title="Fully Homomorphic Encryption – KI in der Cloud ohne Datenschutzbedenken (deutscher Vortrag)"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen></iframe>
          </div>
          <p class="mt-3 text-sm text-ink-600">Deutsch – „FHE – KI in der Cloud ohne Datenschutzbedenken".</p>
        </div>
      </div>
      */}

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-rule pt-6">
        <a href="#kontakt" class={knopfPrimaer}>
          Jetzt anfragen
        </a>
        <p class="text-[0.9375rem] text-ink-500">
          Ihr Thema ist nicht dabei? Sprechen Sie mich gerne an.
        </p>
      </div>
    </Section>

    <!-- BILDUNGSANGEBOTE -->
    <!-- Die Karten kommen aus derselben Content-Collection wie /schools/, aber
         bewusst knapper: hier steht nur, WAS es gibt (Titel, Untertitel, Teaser).
         Zielgruppe, Dauer und Preis – also alles, was man zum Abwägen braucht –
         stehen auf /schools/ und der jeweiligen Angebotsseite. Wer nur diese
         Seite scrollt, kennt trotzdem jedes Angebot beim Namen. -->
    <Section
      id="bildung"
      index={nr("bildung")}
      eyebrow="Bildung"
      title="Bildungsangebote"
      lead="Workshops, Vorträge und Fortbildungen – für Schulen, Universitäten, Unternehmen und Privatpersonen."
    >
      <ZielgruppenHinweis compact />

      <p class="label mt-10 border-b border-rule pb-2 text-ink-500">
        Einblick in unsere Workshops für Schulen
      </p>

      <div class="cellgrid border-t-0 sm:grid-cols-2 xl:grid-cols-3">
        {
          angebote.map((a) => (
            <a href={angebotPath(a.id)} class="group flex h-full flex-col p-5 transition hover:bg-ink-50">
              <p class="label border-b border-rule-soft pb-2 text-emerald-700">{a.data.subtitle}</p>
              <h3 class="mt-3 text-base font-semibold text-ink-900 group-hover:text-brand-700">{a.data.title}</h3>
              <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">{a.data.teaser}</p>
            </a>
          ))
        }

        <!-- Dritte Zelle: der Rest des Katalogs, sichtbar als eigener Weg statt
             als Link unter den Karten. -->
        <a href={PATHS.schools} class="group flex h-full flex-col justify-center bg-emerald-50 p-5 transition hover:bg-emerald-100">
          <span class="font-display text-4xl font-bold tabular-nums text-emerald-700">+{weitereAngebote}</span>
          <span class="mt-1 text-sm font-semibold text-emerald-900">weitere Schulworkshops</span>
          <span class="mt-2 text-[0.8125rem] leading-relaxed text-emerald-900">
            Elternabende, Cybersicherheit, Cybermobbing, AGs zu Vibe Coding und
            Zehnfingersystem – mit Zielgruppen, Dauer und Preisen.
          </span>
          <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-emerald-800">
            Alle ansehen
            <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      </div>

      <div class="mt-8 flex flex-wrap gap-3 border-t border-rule pt-6">
        <a
          href={PATHS.schools}
          class="inline-flex min-h-11 items-center justify-center bg-emerald-700 px-5 text-sm font-semibold text-white transition hover:bg-emerald-800"
        >
          Alle Schulworkshops ansehen
        </a>
        <a href={EDU_PATHS.insights} class={knopfSekundaer}>
          Vergangene Workshops & Materialien
        </a>
      </div>
    </Section>

    <!-- SOFTWARE -->
    <!-- dSolve ist der Bereich; NECK steht nur als eine anfassbare Referenz
         daneben, nicht als gleichwertiger zweiter Block. Ohne irgendein
         konkretes Beispiel wäre der Abschnitt nur ein Link nach außen. -->
    <Section id="software" index={nr("software")} eyebrow="Software" title="Was ich gebaut habe">
      <a
        href={SITE.dSolveSite}
        target="_blank"
        rel="noopener noreferrer"
        class="group block border border-rule border-t-2 border-t-amber-500 p-6 transition hover:bg-ink-50 md:p-8"
      >
        <span class="label text-amber-800">dSolve</span>
        <h3 class="mt-3 font-display text-2xl font-bold text-ink-900">
          Professionelle Softwareprodukte
        </h3>
        <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-600">
          Über dSolve entwickle und vertreibe ich Software. Von kleinen Automationen bis Enterprise Ready Anwendungen.
        </p>
        <span class="mt-6 inline-flex items-center gap-2 font-mono text-sm font-semibold text-amber-800">
          d-solve.de
          <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>
    </Section>

    <!-- PUBLIKATIONEN -->
    <Section
      id="publikationen"
      index={nr("publikationen")}
      eyebrow="Publikationen"
      title="Buch & Paper"
      lead="Forschung zu Kryptographie und KI – als Buch bei Springer und als Fachbeiträge."
    >
      <!-- Buch -->
      <article class="border border-rule p-6 md:p-8">
        <div class="grid gap-8 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-start">
          <img
            src="/img/goppa-book/cover.avif"
            alt="Buchcover: Goppa Codes and the McEliece Cryptosystem (Springer BestMasters)"
            width="500"
            height="709"
            class="w-full border border-rule"
            loading="lazy"
          />
          <div>
            <h3 class="font-display text-xl font-bold text-ink-900 md:text-2xl">Goppa Codes and the McEliece Cryptosystem</h3>
            <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-600">
              Eine fundierte Einführung in das McEliece-Kryptosystem – von den mathematischen Basics bis zur konkreten
              Implementierung.
            </p>
            <div class="cellgrid mt-5 grid-cols-3">
              {
                buchVorschauen.map((v) => (
                  <a href={v.href} class="group block overflow-hidden">
                    <img src={v.img} alt={v.alt} class="h-28 w-full object-cover object-top transition group-hover:scale-[1.02]" loading="lazy" />
                  </a>
                ))
              }
            </div>
            <p class="mt-3 text-xs text-ink-500">Klicken Sie auf eine Vorschau, um Kapitelübersicht, Leseprobe oder Literaturverzeichnis als PDF zu öffnen.</p>
            <div class="mt-5">
              <a
                href="https://link.springer.com/book/10.1007/978-3-658-46743-2"
                target="_blank"
                rel="noopener noreferrer"
                class={knopfPrimaer}
              >
                Bei Springer ansehen &amp; kaufen
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- Paper: als Verzeichniszeilen, nicht als zwei Prospektkarten. Links
           die Kennung in der Monospalte, rechts Titel, Einordnung und Belege. -->
      <ul class="recordlist mt-10">
        {
          paper.map((p) => (
            <li class="record">
              <span class="label text-brand-700">{p.kennung}</span>
              <div>
                <h3 class="text-base font-semibold text-ink-900">{p.titel}</h3>
                <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-600">
                  {p.text}
                  {p.textVorEm}
                  {p.em && <em>{p.em}</em>}
                  {p.textNachEm}
                </p>
                <div class="mt-2 flex flex-wrap gap-x-5">
                  {p.links.map((l) => (
                    <a
                      href={l.href}
                      target={l.extern ? "_blank" : undefined}
                      rel={l.extern ? "noopener noreferrer" : undefined}
                      class="inline-flex min-h-11 items-center font-mono text-sm font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-900"
                    >
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </Section>

    <!-- AKTUELLES -->
    <!-- Gepflegt über src/news/content/*.md — eine Datei pro Eintrag.
         Der Abschnitt blendet sich aus, solange es keine Einträge gibt. -->
