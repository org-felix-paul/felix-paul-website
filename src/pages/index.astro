  <!-- BLOG -->
  <!-- Bewusst im normalen Seitenlayout statt als dunkler Block: der Blog ist
       kein Angebot, und in der Übersicht oben steht er aus demselben Grund
       als schmale Leiste unter den drei Bereichen. Ein Kasten, der lauter ist
       als alles andere auf der Seite, widerspricht dieser Reihenfolge. -->
  <Section
    id="blog"
    background="muted"
    eyebrow="Blog"
    title="Mein persönlicher Blog"
    lead="Gedanken zu Themen, die mich umtreiben – IT-Sicherheit, KI, IT in der Bildung und vieles mehr. Für Professionals, Lehrkräfte, Eltern, Schüler:innen und Neugierige."
  >
    <ul class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-3">
      {
        latestPosts.map((post) => (
          <li>
            <a
              href={postPath(post.id)}
              class="group flex h-full flex-col rounded-2xl border border-ink-200 bg-surface p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
            >
              <time datetime={post.data.pubDate.toISOString()} class="text-xs text-ink-500">
                {postFmt.format(post.data.pubDate)}
              </time>
              <span class="mt-2 flex-1 font-semibold leading-snug text-ink-900 group-hover:text-brand-700">
                {post.data.title}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 text-center">
      <a
        href={PATHS.blog}
        class="inline-flex items-center gap-2 rounded-lg border border-ink-200 bg-surface px-5 py-3 text-sm font-medium text-ink-800 shadow-sm transition hover:border-brand-300 hover:text-brand-700"
      >
        Alle Beiträge
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </Section>

  <!-- KONTAKT -->
  <Section
    id="kontakt"
    eyebrow="Kontakt"
    title="Lassen Sie uns sprechen"
    lead="Ein Vortrag, ein Workshop,  eine Zusammenarbeit oder einfach eine Frage – eine kurze Nachricht genügt. Ich melde mich werktags innerhalb von 48 Stunden."
  >
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr]">
      <ContactForm />

      <aside class="space-y-6">
        <div class="rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm">
          <h2 class="font-display text-lg font-semibold text-ink-900">Direkter Kontakt</h2>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <div class="font-medium text-ink-500">E-Mail</div>
              <a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </li>
            <li>
              <div class="font-medium text-ink-500">LinkedIn</div>
              <a class="text-brand-700 underline" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">Profil ansehen</a>
            </li>
            <li>
              <div class="font-medium text-ink-500">GitHub</div>
              <a class="text-brand-700 underline" href={SITE.github} target="_blank" rel="noopener noreferrer">Profil ansehen</a>
            </li>
          </ul>
        </div>

      </aside>
    </div>
  </Section>
  <!-- PRESSE / REDNERPROFIL -->
  <Section
    id="presse"
    background="muted"
    eyebrow="Presse & Rednerprofil"
    title="Material für Veranstalter & Presse"
    lead="Kurzbio, Foto und Rednerprofil – das Wichtigste auf einen Blick."
  >
    <div class="grid gap-6 md:grid-cols-[1.4fr_1fr]">
      <div class="rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm md:p-8">
        <h3 class="font-display text-lg font-semibold text-ink-900">Kurzbio (zum Kopieren)</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-700">
          Felix Paul ist Informatiker und Mathematiker mit Schwerpunkt IT Security, IAM, KI und Cloud. Hauptberuflich ist er
          Solution Architekt bei der Atruvia AG, dem IT-Dienstleister der genossenschaftlichen Banken. Daneben ist er auch freiberuflich sehr aktiv. 
          Als Keynote-Speaker spricht er auf Konferenzen, an Universitäten
          und in Unternehmen. Außerdem hält er Vorträge an Schulen, vertreibt eigene Softwareprodukte und 
          veröffentlichte ein Buch über Post-Quanten-Kryptographie bei Springer.
        </p>
        <dl class="mt-6 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
          <div><dt class="font-medium text-ink-500">Sprachen</dt><dd class="mt-1 text-ink-900">Deutsch · Englisch</dd></div>
          <div><dt class="font-medium text-ink-500">Kontakt</dt><dd class="mt-1"><a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        </dl>
      </div>

      <div class="flex flex-col gap-4 rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm md:p-8">
        <h3 class="font-display text-lg font-semibold text-ink-900">Downloads</h3>
        <a href="/pdf/rednerprofil.pdf" download class="flex items-center justify-between rounded-lg border border-ink-200 px-4 py-3 text-sm font-medium text-ink-800 transition hover:border-brand-300 hover:text-brand-700">
          Rednerprofil (PDF)
          <span class="text-xs text-ink-400">PDF</span>
        </a>
        <a href={PORTRAIT.press} download class="flex items-center justify-between rounded-lg border border-ink-200 px-4 py-3 text-sm font-medium text-ink-800 transition hover:border-brand-300 hover:text-brand-700">
          Pressefoto (Porträt)
          <span class="text-xs text-ink-400">PNG</span>
        </a>
      </div>
    </div>
  </Section>

