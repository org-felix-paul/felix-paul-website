     -->


  <!-- BLOG -->
  <!-- Bewusst im normalen Seitenlayout statt als dunkler Block: der Blog ist
       kein Angebot, und in der Übersicht oben steht er aus demselben Grund
       als schmale Leiste unter den drei Bereichen. Ein Kasten, der lauter ist
       als alles andere auf der Seite, widerspricht dieser Reihenfolge.

       Deshalb hier auch ein Nebenabschnitt: weniger Luft als bei Speaking und
       Bildung, drei Zeilen mit Datum links. -->
  <Section
    id="blog"
    tone="minor"
    eyebrow="Blog"
    title="Mein persönlicher Blog"
    lead="Gedanken zu Themen, die mich umtreiben – IT-Sicherheit, KI, IT in der Bildung und vieles mehr. Für Professionals, Lehrkräfte, Eltern, Schüler:innen und Neugierige."
  >
    <ul class="border-t border-ink-200">
      {
        latestPosts.map((post) => (
          <li class="border-b border-ink-100">
            <a href={postPath(post.id)} class="group grid items-baseline gap-x-10 gap-y-1 py-6 md:grid-cols-12">
              <time datetime={post.data.pubDate.toISOString()} class="u-eyebrow text-ink-400 md:col-span-3">
                {postFmt.format(post.data.pubDate)}
              </time>
              <span class="u-heading text-ink-900 transition-colors group-hover:text-brand-700 md:col-span-9">
                {post.data.title}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10">
      <a href={PATHS.blog} class={knopfSekundaer}>
        Alle Beiträge
        <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </Section>

  <!-- KONTAKT -->
  <!-- Zurück auf die gedämpfte Fläche und mit voller Luft: das ist die
       eigentliche Handlung der Seite. -->
  <Section
    id="kontakt"
    background="muted"
    eyebrow="Kontakt"
    title="Lassen Sie uns sprechen"
    lead="Ein Vortrag, ein Workshop,  eine Zusammenarbeit oder einfach eine Frage – eine kurze Nachricht genügt. Ich melde mich werktags innerhalb von 48 Stunden."
  >
    <div class="grid gap-x-12 gap-y-12 md:grid-cols-12">
      <div class="md:col-span-7">
        <ContactForm />
      </div>

      <aside class="md:col-span-4 md:col-start-9">
        <h2 class="u-eyebrow text-ink-500">Direkter Kontakt</h2>
        <ul class="mt-5 border-t border-ink-200">
          <li class="border-b border-ink-100 py-4">
            <div class="text-xs font-medium uppercase tracking-wider text-ink-500">E-Mail</div>
            <a class="mt-1 block text-[0.9375rem] font-medium text-brand-700 underline underline-offset-4 hover:text-brand-900" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          <li class="border-b border-ink-100 py-4">
            <div class="text-xs font-medium uppercase tracking-wider text-ink-500">LinkedIn</div>
            <a class="mt-1 block text-[0.9375rem] font-medium text-brand-700 underline underline-offset-4 hover:text-brand-900" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">Profil ansehen</a>
          </li>
          <li class="border-b border-ink-100 py-4">
            <div class="text-xs font-medium uppercase tracking-wider text-ink-500">GitHub</div>
            <a class="mt-1 block text-[0.9375rem] font-medium text-brand-700 underline underline-offset-4 hover:text-brand-900" href={SITE.github} target="_blank" rel="noopener noreferrer">Profil ansehen</a>
          </li>
        </ul>
      </aside>
    </div>
  </Section>

  <!-- PRESSE / REDNERPROFIL -->
  <!-- Ein Nebenabschnitt: wer hier landet, sucht gezielt. Entsprechend
       zurückgenommen. -->
  <Section
    id="presse"
    tone="minor"
    eyebrow="Presse & Rednerprofil"
    title="Material für Veranstalter & Presse"
    lead="Kurzbio, Foto und Rednerprofil – das Wichtigste auf einen Blick."
  >
    <div class="grid gap-x-12 gap-y-12 border-t border-ink-200 pt-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h3 class="u-eyebrow text-ink-500">Kurzbio (zum Kopieren)</h3>
        <p class="u-measure mt-4 leading-relaxed text-ink-700">
          Felix Paul ist Informatiker und Mathematiker mit Schwerpunkt IT Security, IAM, KI und Cloud. Hauptberuflich ist er
          Solution Architekt bei der Atruvia AG, dem IT-Dienstleister der genossenschaftlichen Banken. Daneben ist er auch freiberuflich sehr aktiv.
          Als Keynote-Speaker spricht er auf Konferenzen, an Universitäten
          und in Unternehmen. Außerdem hält er Vorträge an Schulen, vertreibt eigene Softwareprodukte und
          veröffentlichte ein Buch über Post-Quanten-Kryptographie bei Springer.
        </p>
        <dl class="mt-8 grid gap-x-10 gap-y-4 text-sm sm:grid-cols-2">
          <div><dt class="text-xs font-medium uppercase tracking-wider text-ink-500">Sprachen</dt><dd class="mt-1 text-ink-900">Deutsch · Englisch</dd></div>
          <div><dt class="text-xs font-medium uppercase tracking-wider text-ink-500">Kontakt</dt><dd class="mt-1"><a class="text-brand-700 underline underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        </dl>
      </div>

      <div class="md:col-span-4 md:col-start-9">
        <h3 class="u-eyebrow text-ink-500">Downloads</h3>
        <ul class="mt-5 border-t border-ink-200">
          <li>
            <a href="/pdf/rednerprofil.pdf" download class="flex min-h-11 items-center justify-between gap-4 border-b border-ink-100 py-4 text-[0.9375rem] font-medium text-ink-800 transition hover:text-brand-700">
              Rednerprofil (PDF)
              <span class="u-eyebrow text-ink-400">PDF</span>
            </a>
          </li>
          <li>
            <a href={PORTRAIT.press} download class="flex min-h-11 items-center justify-between gap-4 border-b border-ink-100 py-4 text-[0.9375rem] font-medium text-ink-800 transition hover:text-brand-700">
              Pressefoto (Porträt)
              <span class="u-eyebrow text-ink-400">PNG</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </Section>

</Layout>
