---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE, PATHS, PORTRAIT } from "../consts";
import { EDU_PATHS, angebotPath } from "../education/consts";
import ZielgruppenHinweis from "../education/components/ZielgruppenHinweis.astro";
import { postPath } from "../blog/consts";
import { NEWS_KIND_LABELS } from "../news/collection";

// The home page pulls the education offers, the latest posts and the news log
// straight from the same collections the sub-pages use. That is deliberate:
// a visitor who only scrolls this page should see the real content, and there
// is no second copy of it to drift out of sync.
const alleAngebote = (await getCollection("angebote", ({ data }) => !data.preview)).sort(
  (a, b) => a.data.order - b.data.order,
);
// Only a taste on the home page: the full catalogue is what /schools/ is
// for, and repeating all of it here left nothing to click through to.
const angebote = alleAngebote.slice(0, 2);
const weitereAngebote = alleAngebote.length - angebote.length;

const latestPosts = (await getCollection("posts", ({ data }) => !data.draft && !data.preview))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const newsItems = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const newsFmt = new Intl.DateTimeFormat("de-DE", { year: "numeric", month: "long" });
const postFmt = new Intl.DateTimeFormat("de-DE", { year: "numeric", month: "short", day: "numeric" });

// Orientation strip at the top of the page: one line per area, no selling.
// The detail lives in #speaking and #bildung further down, so this stays a
// signpost rather than a second copy of the offer.
const orientation = [
  {
    label: "Keynotes & Fachvorträge",
    line: "Vorträge und Beratung zu KI, IT-Sicherheit, Cloud, IAM und Kryptographie.",
    href: "#speaking",
    bar: "bg-brand-500",
  },
  {
    label: "Bildungsangebote",
    line: "Workshops und Fortbildungen für Unternehmen, Schulen und Privatpersonen.",
    href: "#bildung",
    bar: "bg-emerald-500",
  },
  {
    label: "Software",
    line: "Lauffähige Software und Projekte über dSolve.",
    href: "#software",
    bar: "bg-amber-500",
  },
  {
    // Kein Angebot, deshalb optisch zurückgenommen (graue Marke statt Akzentfarbe).
    // Wie die anderen Zeilen ein Anker auf den Abschnitt weiter unten, nicht
    // direkt auf /blog/ — der Absprung auf die Blogseite steht dort.
    label: "Blog",
    line: "Beiträge zu Themen die mich beschäftigen wie KI, IT-Sicherheit und schulische Bildung.",
    href: "#blog",
    bar: "bg-ink-300",
  },
] as const;

// Speaking topics — one card per talk that stands on its own. Deliberately
// one sentence each: this section is a menu, not the talk itself.
const topics = [
  {
    title: "Künstliche Intelligenz",
    text: "Funktionsweise, (un)sinnvolle Einsatzgebiete, KI-Integrationsarchitekturen (A2A, MCP, REST) und kosteneffiziente Einsatzskalierung (Von AI Gateway über Sandboxes, Filtermechanismen, ...)",
  },
  {
    title: "Identity & Access Management",
    text: "Moderne Authentifizierung, Autorisierung und Zero Trust in hybriden Cloudumgebungen richtig einsetzen.",
  },
  {
    title: "IT Security",
    text: "Lehrbuch gegen gelebte Praxis. Wie findet man den richtigen Trade-Off zwischen Security, Kosten, Usability und Wartbarkeit – Einblicke aus der Finanzbranche",
  },
  {
    title: "Cloud",
    text: "Was wirklich skaliert, was nur kostet, hybride Szenarien und welche Architekturentscheidungen sich später kaum noch korrigieren lassen.",
  },
  {
    title: "Kryptographie",
    text: "Über Fully Homomorphic Encryption (Rechnen auf verschlüsselten Daten) bis Post-Quanten-Kryptographie (mathematischer Deep Dive oder pragmatische Migrationsroadmap).",
  },
];

// Sechste Kachel im Raster: kurze Stichworte statt ausformulierter Themen,
// damit die Liste wachsen kann, ohne den Abschnitt zu verlängern.
const weitereThemen = [
  "Gesellschaftliche Folgen von KI",
  "Skalierungsprobleme bei Enterprise-IT",
  "..."
];

// Der Hintergrund als Aufstellung statt als Kachelgrafik: drei Gruppen,
// jede mit ihrer Bildunterschrift und ihren Abschlüssen. Die Wörter sind
// dieselben wie vorher, sie stehen nur nicht mehr in farbigen Kästchen.
const hintergrund = [
  {
    gruppe: "Fachstudium",
    abschluesse: ["M.Sc. Informatik", "B.Sc. Informatik", "B.Sc. Mathematik"],
    akzent: "bg-brand-500",
  },
  {
    gruppe: "Lehramtsstudium",
    abschluesse: ["M.Ed. Mathematik & Informatik", "B.Ed. Mathematik & Informatik"],
    akzent: "bg-emerald-500",
  },
  {
    gruppe: "Konkrete Umsetzung",
    abschluesse: ["Praxiserfahrung"],
    akzent: "bg-amber-500",
  },
];

// Ein gemeinsamer Typ für beide Einträge, damit der zweite sein <em> behalten
// kann, ohne dass der erste eine leere Auszeichnung braucht.
const publikationen: {
  kicker: string;
  titel: string;
  text?: string;
  textVorEm?: string;
  em?: string;
  textNachEm?: string;
  links: { href: string; label: string; primaer?: boolean; extern?: boolean }[];
}[] = [
  {
    kicker: "Fachbeitrag · Kryptographie",
    titel: "Fully Homomorphic Encryption and its Use Cases",
    text: "Survey-Paper darüber, wie FHE Berechnungen auf verschlüsselten Daten ermöglicht – inklusive Vortrag und Folien.",
    links: [
      { href: "/pdf/fhe-survey.pdf", label: "Paper (PDF)", primaer: true },
      { href: "/pdf/slides-fhe-use-cases-without-notes.pdf", label: "Folien (PDF)" },
    ],
  },
  {
    kicker: "Fachbeitrag · KI",
    titel: "Science-Gym: a simple testbed for AI-driven scientific discovery",
    textVorEm: "Eine einfache Testumgebung, um zu untersuchen, wie KI selbstständig wissenschaftliche Zusammenhänge entdecken kann – erschienen in ",
    em: "Machine Learning",
    textNachEm: " (Springer).",
    links: [
      {
        href: "https://link.springer.com/article/10.1007/s10994-025-06914-x",
        label: "Artikel ansehen",
        primaer: true,
        extern: true,
      },
    ],
  },
];

const buchVorschauen = [
  { href: "/pdf/goppa-book/uebersicht.pdf", src: "/img/goppa-book/uebersicht.png", alt: "Kapitelübersicht des Buches" },
  { href: "/pdf/goppa-book/leseprobe.pdf", src: "/img/goppa-book/leseprobe.png", alt: "Leseprobe aus dem Buch" },
  { href: "/pdf/goppa-book/literaturverzeichnis.pdf", src: "/img/goppa-book/literaturverzeichnis.png", alt: "Literaturverzeichnis des Buches" },
];

// Zwei wiederkehrende Formen auf dieser Seite, damit „Zeile in einer Liste"
// und „Schaltfläche" überall dasselbe bedeuten.
const zeile =
  "group grid items-baseline gap-x-10 gap-y-2 py-7 lg:grid-cols-12 lg:py-8";
const knopfPrimaer =
  "inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-white transition hover:bg-brand-800";
const knopfSekundaer =
  "inline-flex min-h-11 items-center justify-center rounded-full border border-ink-300 px-6 text-[0.9375rem] font-medium text-ink-800 transition hover:border-ink-400 hover:text-brand-700";
---

<Layout>
  <Hero />

  <!-- ORIENTIERUNG -->
  <!-- Bewusst knapp: eine Zeile pro Bereich, damit klar wird, was es gibt und
       wo es weitergeht. Die eigentlichen Inhalte stehen weiter unten
       (#speaking, #bildung) — hier wird nicht verkauft, hier wird sortiert.

       Als Register über die volle Satzbreite statt als umrandete Kartenliste:
       vier Zeilen, durch Haarlinien getrennt, mit laufender Nummer. So liest
       es sich als Inhaltsverzeichnis der Seite und nicht als vierte Kachel-
       sammlung. -->
  <Section id="saeulen" eyebrow="Überblick" title="Was ich mache" tone="minor">
    <ul class="border-t border-ink-200">
      {
        orientation.map((o, i) => {
          const external = o.href.startsWith("http");
          return (
            <li class="border-b border-ink-100">
              <a
                href={o.href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class={zeile}
              >
                <span class="lg:col-span-1">
                  <span class="u-eyebrow block text-ink-400" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class={`mt-2 block h-0.5 w-6 rounded-full ${o.bar}`} aria-hidden="true" />
                </span>
                <span class="u-subtitle text-ink-900 transition-colors group-hover:text-brand-700 lg:col-span-5">
                  {o.label}
                </span>
                <span class="u-measure text-ink-600 lg:col-span-5">{o.line}</span>
                <span class="hidden justify-self-end text-ink-300 transition group-hover:translate-x-1 group-hover:text-brand-700 lg:col-span-1 lg:block">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </Section>

  <!-- ÜBER MICH -->
  <!-- Schmale Kolumne statt Raster: das ist der persönlichste Abschnitt der
       Seite, und er liest sich am besten als Text mit einem Bild daneben. Die
       Studienabschlüsse stehen darunter als Aufstellung — dieselben Wörter,
       aber ohne die farbigen Kästchen, die vorher wie eine Infografik wirkten
       und den Text übertönten. -->
  <Section id="ueber-mich" background="muted" eyebrow="Über mich" title="Kurz zu mir">
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-12">
      <figure class="md:col-span-4 lg:col-span-3">
        <img
          src={PORTRAIT.image}
          alt={`${SITE.author} – persönliches Foto`}
          width="640"
          height="800"
          class="aspect-[4/5] w-full max-w-xs rounded-2xl object-cover object-[50%_18%]"
          loading="lazy"
        />
      </figure>

      <div class="md:col-span-8 lg:col-span-7 lg:col-start-5">
        <div class="prose-content u-measure">
          <p>
            Was mich antreibt: Neues lernen, Zusammenhänge verstehen, selbst nachprüfen & umsetzen, Wissen teilen.
          </p>
          <p>
            Den ausführlichen Lebenslauf gibt es auf <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
          </p>
        </div>

        <figure class="mt-14">
          <figcaption class="u-eyebrow text-brand-700">
            Mein Hintergrund
          </figcaption>

          <!-- Drei Gruppen untereinander, jede mit einer Haarlinie darüber und
               einem kurzen Farbstrich als Marke. Die Abschlüsse stehen als
               Wortliste in einer Zeile: dieselbe Information, aber lesbar
               statt in Kacheln zerlegt. -->
          <dl class="mt-8 border-t border-ink-200">
            {
              hintergrund.map((h) => (
                <div class="grid gap-x-10 gap-y-2 border-b border-ink-100 py-5 sm:grid-cols-12">
                  <dt class="sm:col-span-4">
                    <span class={`mb-2 block h-0.5 w-6 rounded-full ${h.akzent}`} aria-hidden="true" />
                    <span class="u-eyebrow text-ink-500">{h.gruppe}</span>
                  </dt>
                  <dd class="flex flex-wrap gap-x-6 gap-y-1 sm:col-span-8">
                    {h.abschluesse.map((a) => (
                      <span class="text-[0.9375rem] font-medium text-ink-900">{a}</span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>

          <p class="u-measure mt-6 text-sm leading-relaxed text-ink-500">
            Drei vollständige Studiengänge nebeneinander: Informatik und Mathematik fachlich,
            Lehramt didaktisch. Dazu die tägliche Praxis als Solution Architekt in der
            Finanzbranche – deshalb bleiben Vorträge und Workshops nah an dem, was wirklich
            passiert.
          </p>
        </figure>
      </div>
    </div>
  </Section>

  <!-- SPEAKING -->
  <!-- Der wichtigste Abschnitt der Seite und deshalb der luftigste. Die
       Themen stehen als Werkverzeichnis: Titel links, Beschreibung rechts,
       getrennt durch Haarlinien. Vorher waren es sechs gleich große Karten mit
       Rahmen und Schatten — sechs Kästen, in denen nichts wichtiger war als
       der Rest. -->
  <Section
    id="speaking"
    eyebrow="Speaking & Consulting"
    title="Keynotes & Fachvorträge"
    lead="Ich spreche und berate auf Konferenzen, an Universitäten und in Unternehmen über die folgenden Themen."
  >
    <ul class="border-t border-ink-200">
      {
        topics.map((t) => (
          <li class="grid items-baseline gap-x-10 gap-y-2 border-b border-ink-100 py-7 lg:grid-cols-12 lg:py-9">
            <h3 class="u-subtitle text-ink-900 lg:col-span-5">{t.title}</h3>
            <p class="u-measure leading-relaxed text-ink-600 lg:col-span-7">{t.text}</p>
          </li>
        ))
      }

      <!-- Weitere Themen: dieselbe Zeilenform, aber sichtbar zurückgenommen —
           kleinere Schrift, graue Marke. Kein gestrichelter Rahmen mehr. -->
      <li class="grid items-baseline gap-x-10 gap-y-2 border-b border-ink-100 py-7 lg:grid-cols-12">
        <h3 class="u-eyebrow text-ink-500 lg:col-span-5">Weitere Themen</h3>
        <ul class="flex flex-wrap gap-x-6 gap-y-1.5 text-[0.9375rem] text-ink-500 lg:col-span-7">
          {
            weitereThemen.map((t) => (
              <li class="flex items-baseline gap-2">
                <span class="h-1 w-1 shrink-0 rounded-full bg-ink-300" aria-hidden="true" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </li>
    </ul>

    <!-- Consulting: eigene Fläche, weil es ein anderes Angebot ist als ein
         Vortrag. Große Fläche, großer Radius, keine Kante. -->
    <div class="mt-12 rounded-3xl bg-brand-50 px-7 py-9 md:px-12 md:py-11">
      <div class="grid gap-x-12 gap-y-4 lg:grid-cols-12">
        <h3 class="u-subtitle text-brand-900 lg:col-span-4">Consulting</h3>
        <p class="u-measure leading-relaxed text-brand-900/85 lg:col-span-8">Beratung zu diesen Themen ist  natürlich auch möglich. Egal, ob Konzeption, Architektur-Review oder Hands-On Umsetzung.</p>
      </div>
    </div>

    {/* YouTube-Vorträge vorübergehend ausgeblendet – zum Reaktivieren die umschließenden {/​* *​/}-Marker entfernen. Siehe README. */}
    {/*
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <div class="aspect-video w-full overflow-hidden rounded-2xl border border-ink-200">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/4JBXO_SQuJM"
            title="Fully Homomorphic Encryption and its Use Cases (englischer Vortrag)"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
        <p class="mt-3 text-sm text-ink-600">Englisch – „Fully Homomorphic Encryption and its Use Cases".</p>
      </div>
      <div>
        <div class="aspect-video w-full overflow-hidden rounded-2xl border border-ink-200">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/awbrW_Rl2nU"
            title="Fully Homomorphic Encryption – KI in der Cloud ohne Datenschutzbedenken (deutscher Vortrag)"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
        </div>
        <p class="mt-3 text-sm text-ink-600">Deutsch – „FHE – KI in der Cloud ohne Datenschutzbedenken".</p>
      </div>
    </div>
    */}

    <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a href="#kontakt" class={knopfPrimaer}>
        Jetzt anfragen
      </a>
      <p class="u-measure-tight text-sm text-ink-500">
        Ihr Thema ist nicht dabei? Sprechen Sie mich gerne an.
      </p>
    </div>
  </Section>

  <!-- BILDUNGSANGEBOTE -->
  <!-- Die Karten kommen aus derselben Content-Collection wie /schools/, aber
       bewusst knapper: hier steht nur, WAS es gibt (Titel, Untertitel, Teaser).
       Zielgruppe, Dauer und Preis – also alles, was man zum Abwägen braucht –
       stehen auf /schools/ und der jeweiligen Angebotsseite. Wer nur diese
       Seite scrollt, kennt trotzdem jedes Angebot beim Namen. -->
  <Section
    id="bildung"
    background="muted"
    eyebrow="Bildung"
    title="Bildungsangebote"
    lead="Workshops, Vorträge und Fortbildungen – für Schulen, Universitäten, Unternehmen und Privatpersonen."
  >
    <ZielgruppenHinweis compact />

    <p class="u-eyebrow mt-16 text-ink-500">
      Einblick in unsere Workshops für Schulen
    </p>

    <ul class="mt-6 grid gap-x-10 border-y border-ink-200 lg:grid-cols-3">
      {
        angebote.map((a) => (
          <li class="border-b border-ink-100 last:border-b-0 lg:border-b-0">
            <a href={angebotPath(a.id)} class="group flex h-full flex-col py-7 lg:py-8">
              <span class="u-eyebrow text-emerald-700">{a.data.subtitle}</span>
              <h3 class="u-heading mt-3 text-ink-900 transition-colors group-hover:text-brand-700">
                {a.data.title}
              </h3>
              <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">{a.data.teaser}</p>
            </a>
          </li>
        ))
      }

      <!-- Der Rest des Katalogs, als dritte Spalte im selben Register statt
           als gestrichelte Sonderkachel. -->
      <li class="last:border-b-0">
        <a href={PATHS.schools} class="group flex h-full flex-col py-7 lg:py-8">
          <span class="u-eyebrow text-emerald-700"><span class="text-emerald-800">+{weitereAngebote}</span> weitere Schulworkshops</span>
          <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">
            Elternabende, Cybersicherheit, Cybermobbing, AGs zu Vibe Coding und
            Zehnfingersystem – mit Zielgruppen, Dauer und Preisen.
          </p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-[0.9375rem] font-medium text-emerald-700">
            Alle ansehen
            <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      </li>
    </ul>

    <div class="mt-12 flex flex-wrap gap-4 border-t border-ink-200 pt-10">
      <a
        href={PATHS.schools}
        class="inline-flex min-h-11 items-center justify-center rounded-full bg-emerald-700 px-6 text-[0.9375rem] font-medium text-white transition hover:bg-emerald-800"
      >
        Alle Schulworkshops ansehen
      </a>
      <a href={EDU_PATHS.insights} class={knopfSekundaer}>
        Vergangene Workshops & Materialien
      </a>
    </div>
  </Section>

  <!-- SOFTWARE -->
  <!-- dSolve ist der Bereich; NECK steht nur als eine anfassbare Referenz
       daneben, nicht als gleichwertiger zweiter Block. Ohne irgendein
       konkretes Beispiel wäre der Abschnitt nur ein Link nach außen.

       Kurzer Abschnitt, deshalb weniger Luft und kein zweispaltiger Kopf:
       eine einzige große Aussage über die volle Breite. -->
  <Section id="software" tone="minor">
    <a
      href={SITE.dSolveSite}
      target="_blank"
      rel="noopener noreferrer"
      class="group block border-t-2 border-amber-500 pt-10"
    >
      <div class="grid gap-x-12 gap-y-6 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="u-eyebrow text-amber-800">Software</p>
          <p class="u-eyebrow mt-3 text-ink-400">dSolve</p>
        </div>
        <div class="lg:col-span-8">
          <h2 class="u-title text-balance text-ink-900">Was ich gebaut habe</h2>
          <h3 class="u-subtitle mt-5 font-normal text-ink-700">
            Professionelle Softwareprodukte
          </h3>
          <p class="u-measure mt-4 leading-relaxed text-ink-600">
            Über dSolve entwickle und vertreibe ich Software. Von kleinen Automationen bis Enterprise Ready Anwendungen.
          </p>
          <span class="mt-7 inline-flex items-center gap-2 text-[0.9375rem] font-medium text-amber-800">
            d-solve.de
            <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  </Section>

  <!-- PUBLIKATIONEN -->
  <Section
    id="publikationen"
    background="muted"
    eyebrow="Publikationen"
    title="Buch & Paper"
    lead="Forschung zu Kryptographie und KI – als Buch bei Springer und als Fachbeiträge."
  >
    <!-- Buch: das Cover ist das Objekt, es braucht keinen Kasten drumherum.
         Nur eine Haarlinie am Bild, damit der weiße Rand des Covers nicht in
         der Fläche verschwindet. -->
    <article class="grid gap-x-12 gap-y-8 md:grid-cols-12">
      <img
        src="/img/goppa-book/cover.avif"
        alt="Buchcover: Goppa Codes and the McEliece Cryptosystem (Springer BestMasters)"
        width="500"
        height="709"
        class="w-40 rounded-lg ring-1 ring-ink-200 sm:w-48 md:col-span-4 md:w-full md:max-w-[15rem]"
        loading="lazy"
      />
      <div class="md:col-span-8">
        <h3 class="u-subtitle text-balance text-ink-900">Goppa Codes and the McEliece Cryptosystem</h3>
        <p class="u-measure mt-4 leading-relaxed text-ink-600">
          Eine fundierte Einführung in das McEliece-Kryptosystem – von den mathematischen Basics bis zur konkreten
          Implementierung.
        </p>
        <div class="mt-7 grid max-w-lg grid-cols-3 gap-3">
          {
            buchVorschauen.map((v) => (
              <a href={v.href} class="group block overflow-hidden rounded-md ring-1 ring-ink-200 transition hover:ring-brand-400">
                <img src={v.src} alt={v.alt} class="h-24 w-full object-cover object-top transition group-hover:scale-[1.03]" loading="lazy" />
              </a>
            ))
          }
        </div>
        <p class="mt-3 text-xs text-ink-500">Klicken Sie auf eine Vorschau, um Kapitelübersicht, Leseprobe oder Literaturverzeichnis als PDF zu öffnen.</p>
        <div class="mt-7">
          <a
            href="https://link.springer.com/book/10.1007/978-3-658-46743-2"
            target="_blank"
            rel="noopener noreferrer"
            class={knopfPrimaer}
          >
            Bei Springer ansehen &amp; kaufen
          </a>
        </div>
      </div>
    </article>

    <!-- Paper: dieselbe Zeilenform wie die Vortragsthemen, damit die Seite
         eine Sprache spricht. -->
    <ul class="mt-16 border-t border-ink-200">
      {
        publikationen.map((p) => (
          <li class="grid gap-x-10 gap-y-3 border-b border-ink-100 py-8 md:grid-cols-12">
            <div class="md:col-span-4">
              <p class="u-eyebrow text-brand-700">{p.kicker}</p>
            </div>
            <div class="md:col-span-8">
              <h3 class="u-heading text-ink-900">{p.titel}</h3>
              <p class="u-measure mt-2 text-[0.9375rem] leading-relaxed text-ink-600">
                {p.text}
                {p.textVorEm}
                {p.em && <em>{p.em}</em>}
                {p.textNachEm}
              </p>
              <div class="mt-5 flex flex-wrap gap-3">
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    target={l.extern ? "_blank" : undefined}
                    rel={l.extern ? "noopener noreferrer" : undefined}
                    class={l.primaer ? knopfPrimaer : knopfSekundaer}
                  >
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- AKTUELLES -->
  <!-- Gepflegt über src/news/content/*.md — eine Datei pro Eintrag.
       Der Abschnitt blendet sich aus, solange es keine Einträge gibt. -->
  <!--  {
    newsItems.length > 0 && (
      <Section
        id="aktuelles"
        eyebrow="Aktuelles"
        title="Zuletzt gemacht"
        lead="Gehaltene Workshops und Vorträge, Veröffentlichungen und Releases – in umgekehrter Reihenfolge."
      >
        <ol class="border-t border-ink-200">
          {newsItems.map((n) => (
            <li class="grid gap-x-10 gap-y-2 border-b border-ink-100 py-7 md:grid-cols-12">
              <div class="md:col-span-4">
                <span class="u-eyebrow text-brand-700">{NEWS_KIND_LABELS[n.data.kind]}</span>
                <div class="mt-2 flex flex-wrap items-center gap-x-2">
                  <time datetime={n.data.date.toISOString()} class="text-xs text-ink-500">
                    {newsFmt.format(n.data.date)}
                  </time>
                  {n.data.location && <span class="text-xs text-ink-500">· {n.data.location}</span>}
                </div>
