---
// Der Schulbereich benutzt denselben Abschnitt wie der Rest der Domain.
//
// Bis Experiment 4 lag hier eine byteidentische Kopie von
// src/components/Section.astro. Zwei Kopien desselben Rasterbausteins laufen
// beim ersten Umbau auseinander — genau das wäre bei diesem passiert. Der
// Bereich behält seine eigene Marke (Header, Favicon, Hero); das Raster ist
// dagegen etwas, das die ganze Domain teilt, und steht deshalb nur einmal.
//
// Die Datei bleibt trotzdem bestehen: die Seiten unter src/pages/schools/
// importieren sie, und der Bereich soll weiterhin ohne Änderung an fünf
// Seiten auf einen eigenen Abschnitt umschwenken können.
import Section from "../../components/Section.astro";

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  background?: "white" | "muted";
  index?: string;
  as?: "h1" | "h2";
}
---

<Section {...Astro.props as Props}>
  <slot />
</Section>
