---
// Who the formats are for. The offers below are written in school terms, so
// without this the whole section reads as school-only.
//
// One card per audience, each in the colour that audience already has
// elsewhere on the site: green is the education area in the overview strip,
// blue is Keynotes & Fachvorträge (where the company topics live), amber is
// Software / the third pillar. Colour on white rather than coloured text on a
// coloured ground — the previous emerald-on-emerald version was hard to read.
import { PATHS } from "../../consts";
import { lokalisiere, nurDeutsch } from "../../i18n/pages.mjs";
import type { Sprache } from "../../i18n/ui";

interface Props {
  /** Home page uses the tighter version; /education/ the full one. */
  compact?: boolean;
  lang?: Sprache;
}
const { compact = false, lang = "de" } = Astro.props;
const en = lang === "en";

const gruppen = [
  {
    label: en ? "Schools & teachers" : "Schulen & Lehrkräfte",
    short: en
      ? "Workshops for teachers, parents and students"
      : "Workshops für Lehrer, Eltern und Schüler:innen",
    text: en
      ? "In-service training days, workshops for classes and year groups, parents' evenings, and clubs running over a full term."
      : "Pädagogische Tage, Workshops für Klassen und Jahrgänge, Elternabende und AGs über ein Halbjahr.",
    bar: "bg-emerald-500",
    chip: "bg-emerald-50 text-emerald-800",
    href: PATHS.schools,
    hrefLabel: en ? "See the school programme" : "Zu den Schulangeboten",
  },
  {
    label: en ? "Companies & universities" : "Unternehmen & Universitäten",
    short: en
      ? "Training shaped around a role or an organisation, and consulting on request"
      : "Rollen- und organisationsspezifische Fortbildungen oder Consulting auf Anfrage",
    text: en
      ? "Shaped around the role and the organisation — from a one-to-one conversation to a format for an entire division."
      : "Zugeschnitten auf die Rolle und die Organisation – vom Einzelgespräch bis zum Format für den ganzen Bereich.",
    bar: "bg-brand-500",
    chip: "bg-brand-50 text-brand-800",
    href: PATHS.companies,
    hrefLabel: en ? "For companies & universities" : "Für Unternehmen & Universitäten",
  },
  {
    label: en ? "Individuals" : "Privatpersonen",
    short: en
      ? "Adult education, one to one or in small groups."
      : "Erwachsenenbildung, einzeln oder in kleinen Gruppen.",
    text: en
      ? "Adult education for individuals and small groups, shaped around you — on request."
      : "Erwachsenenbildung für Einzelne und kleine Gruppen, individuell zugeschnitten – auf Anfrage.",
    bar: "bg-amber-500",
    chip: "bg-amber-50 text-amber-800",
    href: PATHS.individuals,
    hrefLabel: en ? "For individuals" : "Für Privatpersonen",
  },
];
---

{/*
  Drei Zellen eines Rasters statt drei frei stehender Karten: der 1px-Abstand
  zeigt die Rasterlinie, die farbige Kante oben bleibt als Kennzeichnung der
  Zielgruppe erhalten — jetzt aber als 3px-Kante auf der Rasterlinie, nicht als
  schwebendes Stäbchen.
*/}
<div class={compact ? "" : "mt-10"}>
  {
    !compact && (
      <h3 class="label border-b border-rule pb-2 text-ink-500">Auch außerhalb der Schule</h3>
    )
  }
  <ul class={`cellgrid sm:grid-cols-3 ${compact ? "" : "border-t-0"}`}>
    {
      gruppen.map((g) => (
        <li class="flex flex-col p-5">
          <span class={`-mx-5 -mt-5 mb-4 h-[3px] ${g.bar}`} aria-hidden="true" />
          <span class={`label w-fit px-2 py-1 ${g.chip}`}>{g.label}</span>
          <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">{compact ? g.short : g.text}</p>
          {g.href && (
            <a
              href={lokalisiere(g.href, lang)}
              class="mt-3 inline-flex min-h-11 w-fit items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-900"
            >
              {g.hrefLabel}
              {en && nurDeutsch(g.href) && (
                <span class="border border-rule-soft px-1.5 py-0.5 font-mono text-[0.65rem] font-semibold uppercase tracking-wider text-ink-500">
                  in German
                </span>
              )}
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>
