---
// Who the formats are for. The offers below are written in school terms, so
// without this the whole section reads as school-only.
//
// One card per audience, each in the colour that audience already has
// elsewhere on the site: green is the education area in the overview strip,
// blue is Keynotes & Fachvorträge (where the company topics live), amber is
// Software / the third pillar. Colour on white rather than coloured text on a
// coloured ground — the previous emerald-on-emerald version was hard to read.
import { PATHS } from "../../consts";

interface Props {
  /** Home page uses the tighter version; /education/ the full one. */
  compact?: boolean;
}
const { compact = false } = Astro.props;

const gruppen = [
  {
    label: "Schulen & Lehrkräfte",
    short: "Workshops für Lehrer, Eltern und Schüler:innen",
    text: "Pädagogische Tage, Workshops für Klassen und Jahrgänge, Elternabende und AGs über ein Halbjahr.",
    bar: "bg-emerald-500",
    chip: "bg-emerald-50 text-emerald-800",
    href: PATHS.schools,
    hrefLabel: "Zu den Schulangeboten",
  },
  {
    label: "Unternehmen & Universitäten",
    short: "Rollen- und organisationsspezifische Fortbildungen oder Consulting auf Anfrage",
    text: "Zugeschnitten auf die Rolle und die Organisation – vom Einzelgespräch bis zum Format für den ganzen Bereich.",
    bar: "bg-brand-500",
    chip: "bg-brand-50 text-brand-800",
    href: PATHS.companies,
    hrefLabel: "Für Unternehmen & Universitäten",
  },
  {
    label: "Privatpersonen",
    short: "Erwachsenenbildung, einzeln oder in kleinen Gruppen.",
    text: "Erwachsenenbildung für Einzelne und kleine Gruppen, individuell zugeschnitten – auf Anfrage.",
    bar: "bg-amber-500",
    chip: "bg-amber-50 text-amber-800",
    href: PATHS.individuals,
    hrefLabel: "Für Privatpersonen",
  },
];
---

<div class={compact ? "" : "mt-10"}>
  {
    !compact && (
      <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-500">Auch außerhalb der Schule</h3>
    )
  }
  <ul class={`grid gap-4 sm:grid-cols-3 ${compact ? "" : "mt-4"}`}>
    {
      gruppen.map((g) => (
        <li class="relative flex flex-col overflow-hidden rounded-2xl border border-ink-200 bg-surface p-5 shadow-sm">
          <span class={`absolute inset-x-0 top-0 h-1 ${g.bar}`} aria-hidden="true" />
          <span class={`inline-flex w-fit rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider ${g.chip}`}>
            {g.label}
          </span>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{compact ? g.short : g.text}</p>
          {g.href && (
            <a
              href={g.href}
              class="mt-3 inline-flex w-fit items-center gap-1 text-sm font-medium text-brand-700 hover:text-brand-900"
            >
              {g.hrefLabel}
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>
