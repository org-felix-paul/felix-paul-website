---
interface Props {
  href?: string;
  title: string;
  subtitle: string;
  zielgruppe: string;
  dauer: string;
  preis: string;
  teaser: string;
  icon: string;
  preview?: boolean;
}

const { href, title, subtitle, zielgruppe, dauer, preis, teaser, icon, preview = false } = Astro.props;

// Preview-Karten sind nicht klickbar (div statt a) und visuell gedämpft.
const Tag = preview ? "div" : "a";

const icons: Record<string, string> = {
  ki: "M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z",
  shield: "M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z",
  people: "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z",
  lock: "M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z",
};

const iconPath = icons[icon] ?? icons.ki;
---

<Tag
  href={preview ? undefined : href}
  class:list={[
    "group relative flex h-full flex-col rounded-2xl border border-ink-200 bg-white p-6 shadow-sm transition",
    preview ? "opacity-70" : "hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md",
  ]}
>
  {preview && (
    <span class="absolute right-4 top-4 rounded-full bg-ink-100 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-ink-500">
      In Vorbereitung
    </span>
  )}
  <div class="flex items-center gap-3">
    <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d={iconPath}></path>
      </svg>
    </span>
    <div class="text-xs font-medium uppercase tracking-widest text-ink-500">{subtitle}</div>
  </div>

  <h3 class="mt-5 text-xl font-semibold text-ink-900 group-hover:text-brand-700">{title}</h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{teaser}</p>

  <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-ink-100 pt-4 text-xs">
    <div>
      <dt class="font-medium text-ink-500">Zielgruppe</dt>
      <dd class="mt-0.5 text-ink-800">{zielgruppe}</dd>
    </div>
    <div>
      <dt class="font-medium text-ink-500">Dauer</dt>
      <dd class="mt-0.5 text-ink-800">{dauer}</dd>
    </div>
    <div>
      <dt class="font-medium text-ink-500">Honorar</dt>
      <dd class="mt-0.5 text-ink-800">{preis}</dd>
    </div>
  </dl>

  {
    preview ? (
      <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-ink-400">
        Bald verfügbar
      </span>
    ) : (
      <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-brand-700">
        Details ansehen
        <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    )
  }
</Tag>
