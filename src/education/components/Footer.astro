---
import SiteFooter from "../../components/SiteFooter.astro";
import { SITE, PATHS } from "../../consts";
import { EDU, EDU_PATHS } from "../consts";
---

<SiteFooter
  logo={EDU.logo}
  logoAlt=""
  wordmark={`Teaching@${SITE.name}`}
  blurb="IT-Pädagoge mit Doppelqualifikation – Vorträge, Workshops und Fortbildungen für Schulen."
  columns={[
    {
      heading: "Navigation",
      links: [
        { href: EDU_PATHS.home, label: "Start" },
        { href: EDU_PATHS.projekte, label: "Referenzen" },
        { href: PATHS.kontakt, label: "Kontakt" },
      ],
    },
    {
      heading: "Mehr von mir",
      links: [
        { href: PATHS.home, label: "Startseite", note: "Keynotes, Fachvorträge & Software" },
        { href: PATHS.blog, label: "Blog", note: "KI, IT-Sicherheit und IT in der Bildung" },
        { href: SITE.dSolveSite, label: "d-solve.de", note: "Softwareentwicklung & Beratung", external: true },
      ],
    },
  ]}
/>
