---
import { SITE } from "../../consts";
import { EDU, EDU_PATHS } from "../consts";
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-canvas to-canvas">
  <div class="absolute inset-0 -z-10 opacity-70">
    <div class="absolute -top-32 -right-32 h-96 w-96 rounded-full bg-brand-200/55 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-brand-200/45 blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-[1.4fr_1fr] md:items-center md:py-28">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-surface px-3 py-1 text-xs font-medium text-brand-700">
        <span class="h-2 w-2 rounded-full bg-brand-500"></span>
        Buchbar als Referent für Lehrerfortbildungen, Schülerworkshops, Kursserien &amp; Elternabende
      </p>

      <h1 class="mt-5 font-display text-4xl font-bold leading-tight tracking-tight text-ink-900 md:text-5xl">
        Bildungsangebote für Schulen – <span class="text-brand-700">verständlich erklärt</span> <span class="text-brand-700 text-2xl md:text-3xl">von Felix Paul</span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-700">
        Ich bin <strong class="font-semibold text-ink-900">{SITE.author}</strong> - M.Ed. <em>und</em> M.Sc. Informatik. Diese
        Doppelqualifikation ist selten und genau das, was Schulen heute brauchen: jemand, der KI und IT-Security technisch
        versteht, praktisch in der Wirtschaft anwendet und gleichzeitig weiß, wie Unterricht funktioniert.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#angebote"
          class="rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800"
        >
          Angebote ansehen
        </a>
        <a
          href={EDU_PATHS.kontakt}
          class="rounded-lg border border-ink-200 bg-surface px-5 py-3 text-sm font-medium text-ink-800 shadow-sm transition hover:border-brand-300 hover:text-brand-700"
        >
          Unverbindlich anfragen
        </a>
      </div>

      <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-4 text-sm sm:grid-cols-3">
        <div>
          <dt class="font-medium text-ink-500">Qualifikation</dt>
          <dd class="mt-1 text-ink-900">M.Ed. + M.Sc. Informatik</dd>
        </div>
        <div>
          <dt class="font-medium text-ink-500">Beruf</dt>
          <dd class="mt-1 text-ink-900">Solution-Architekt (Finanzindustrie)</dd>
        </div>
        <div>
          <dt class="font-medium text-ink-500">Einsatzgebiet</dt>
          <dd class="mt-1 text-ink-900">Schwerpunkt RLP &amp; Hamburg</dd>
        </div>
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-sm">
      <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-300/45 to-brand-200/30 blur-2xl"></div>
      <img
        src={EDU.portrait}
        alt={`${SITE.author} – IT-Pädagoge für Vorträge und Workshops zu KI, Cybersicherheit und Medienkompetenz an Schulen`}
        width="800"
        height="800"
        class="aspect-square w-full rounded-3xl object-cover shadow-xl ring-1 ring-ink-200"
        loading="eager"
      />
    </div>
  </div>
</section>
