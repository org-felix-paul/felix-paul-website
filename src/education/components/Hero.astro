---
// Dieselbe Anlage wie der Kopf der Startseite: eine typografische Aussage,
// darunter eine Haarlinie, dann Fließtext und Handlung. Das Porträt steht
// hochkant daneben, ohne Rahmen und ohne Schatten.
import { SITE } from "../../consts";
import { EDU, EDU_PATHS } from "../consts";

const eckdaten: { dt: string; dd?: string; ddHtml?: string }[] = [
  { dt: "Qualifikation", dd: "M.Ed. + M.Sc. Informatik" },
  { dt: "Beruf", dd: "Solution-Architekt (Finanzindustrie)" },
  { dt: "Einsatzgebiet", ddHtml: "Schwerpunkt RLP &amp; Hamburg" },
];
---

<section class="edu-hero relative overflow-hidden">
  <div class="mx-auto max-w-[88rem] px-5 sm:px-8">
    <div class="grid items-end gap-y-12 lg:grid-cols-12 lg:gap-x-12">
      <div class="pt-16 pb-4 md:pt-24 lg:col-span-7 lg:pt-32 lg:pb-24">
        <p class="u-eyebrow text-balance text-brand-700">
          Buchbar als Referent für Lehrerfortbildungen, Schülerworkshops, Kursserien &amp; Elternabende
        </p>

        <h1 class="u-title mt-7 text-balance text-ink-900">
          Bildungsangebote für Schulen – <span class="text-brand-700">verständlich erklärt</span>
          <span class="u-subtitle mt-4 block font-normal text-ink-500">von Felix Paul</span>
        </h1>

        <div class="mt-10 max-w-2xl border-t border-ink-200 pt-8">
          <p class="u-lede u-measure text-ink-700">
            Ich bin <strong class="font-semibold text-ink-900">{SITE.author}</strong> - M.Ed. <em>und</em> M.Sc. Informatik. Diese
            Doppelqualifikation ist selten und genau das, was Schulen heute brauchen: jemand, der KI und IT-Security technisch
            versteht, praktisch in der Wirtschaft anwendet und gleichzeitig weiß, wie Unterricht funktioniert.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href="#angebote"
              class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-6 text-[0.9375rem] font-medium text-brand-50 transition hover:bg-brand-800"
            >
              Angebote ansehen
            </a>
            <a
              href={EDU_PATHS.kontakt}
              class="inline-flex min-h-11 items-center justify-center rounded-full border border-ink-300 px-6 text-[0.9375rem] font-medium text-ink-800 transition hover:border-ink-400 hover:text-brand-700"
            >
              Unverbindlich anfragen
            </a>
          </div>

          <!-- Eckdaten als Register unter einer Haarlinie statt als drei
               freistehende Spalten: so gehören sie sichtbar zusammen. -->
          <dl class="mt-12 grid gap-x-10 border-t border-ink-200 sm:grid-cols-3">
            {
              eckdaten.map((e) => (
                <div class="border-b border-ink-100 py-4 sm:border-b-0">
                  <dt class="text-xs font-medium uppercase tracking-wider text-ink-500">{e.dt}</dt>
                  {e.ddHtml ? (
                    <dd class="mt-1 text-[0.9375rem] text-ink-900" set:html={e.ddHtml} />
                  ) : (
                    <dd class="mt-1 text-[0.9375rem] text-ink-900">{e.dd}</dd>
                  )}
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="edu-hero__portrait lg:col-span-5">
        <img
          src={EDU.portrait}
          alt={`${SITE.author} – IT-Pädagoge für Vorträge und Workshops zu KI, Cybersicherheit und Medienkompetenz an Schulen`}
          width="800"
          height="800"
          class="h-full w-full object-cover object-[50%_18%]"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .edu-hero {
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-brand-50) 85%, transparent),
      var(--color-canvas) 70%
    );
  }

  .edu-hero__portrait {
    overflow: hidden;
    border-radius: 1.75rem;
    aspect-ratio: 4 / 3;
    background-color: var(--color-ink-100);
  }

  @media (min-width: 640px) {
    .edu-hero__portrait {
      aspect-ratio: 3 / 2;
    }
  }

  @media (min-width: 1024px) {
    .edu-hero__portrait {
      aspect-ratio: 4 / 5;
      border-radius: 2rem 2rem 0 0;
      margin-bottom: -1px;
    }
  }
</style>
