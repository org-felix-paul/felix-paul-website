---
// Education chrome on top of the shared Layout. Head/metadata is owned by the
// shared Layout; this file supplies branding defaults and Header/Footer only.
import Layout from "../layouts/Layout.astro";
import { FAVICONS } from "../consts";
import Header from "./components/Header.astro";
import { EDU } from "./consts";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = EDU.description,
  ogImage = EDU.ogImage,
  ogType = "website",
  schema = [],
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  siteName={EDU.name}
  ogType={ogType}
  schema={schema}
  favicon={FAVICONS.schools}
>
  <Header slot="header" />
  <slot />
</Layout>
