---
// Ein Formular für beide Sprachen. Die versteckten Felder gehen mit: eine
// englische Anfrage darf keine deutsche Autoantwort auslösen, und nach dem
// Absenden muss die englische Dankeseite kommen, nicht die deutsche.
import { SITE, PATHS } from "../consts";
import { lokalisiere } from "../i18n/pages.mjs";
import type { Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;
const en = lang === "en";

const T = {
  betreff: en ? "New enquiry via felix-paul.de" : "Neue Anfrage über felix-paul.de",
  weiter: en ? `${SITE.url}/en/thank-you/` : `${SITE.url}/thank-you/`,
  autoantwort: en
    ? "Thank you for your message via felix-paul.de. I have received your enquiry and usually reply within 48 hours. Best regards, Felix Paul"
    : "Vielen Dank für Ihre Nachricht über felix-paul.de. Ich habe Ihre Anfrage erhalten und melde mich in der Regel innerhalb von 48 Stunden zurück. Beste Grüße, Felix Paul",
  name: en ? "Name *" : "Name *",
  namePlatzhalter: en ? "Jane Doe" : "Max Mustermann",
  email: en ? "Email *" : "E-Mail *",
  emailPlatzhalter: en ? "jane.doe@example.com" : "max.mustermann@gmail.com",
  nachricht: en ? "Message *" : "Nachricht *",
  nachrichtPlatzhalter: en ? "What can I help you with?" : "Worum geht es? ",
  senden: en ? "Send enquiry" : "Anfrage senden",
  direkt: en ? "Or write to me directly:" : "Oder direkt schreiben:",
};
---

<form
  action={`https://formsubmit.co/${SITE.email}`}
  method="POST"
  class="space-y-5 border border-rule bg-surface p-6 md:p-8"
>
  <input type="hidden" name="_subject" value={T.betreff} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="true" />
  <input type="hidden" name="_next" value={T.weiter} />
  <input
    type="hidden"
    name="_autoresponse"
    value={T.autoantwort}
  />
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  <div>
    <label for="name" class="block text-sm font-medium text-ink-800">{T.name}</label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder={T.namePlatzhalter}
      required
      autocomplete="name"
      class="mt-1 w-full min-h-11 border border-rule bg-surface px-3 py-2.5 text-sm transition focus:border-brand-700 focus:ring-2 focus:ring-brand-200 focus:outline-none"
    />
  </div>

  <div>
    <label for="email" class="block text-sm font-medium text-ink-800">{T.email}</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      placeholder={T.emailPlatzhalter}
      class="mt-1 w-full min-h-11 border border-rule bg-surface px-3 py-2.5 text-sm transition focus:border-brand-700 focus:ring-2 focus:ring-brand-200 focus:outline-none"
    />
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-ink-800">{T.nachricht}</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      placeholder={T.nachrichtPlatzhalter}
      class="mt-1 w-full min-h-11 border border-rule bg-surface px-3 py-2.5 text-sm transition focus:border-brand-700 focus:ring-2 focus:ring-brand-200 focus:outline-none"
    ></textarea>
  </div>

  <div class="flex items-start gap-2 text-sm text-ink-600">
    <input
      id="privacy"
      type="checkbox"
      name="privacy"
      value="yes"
      required
      class="mt-0.5 h-5 w-5 shrink-0 border-rule text-brand-700 focus:ring-brand-500"
    />
    <label for="privacy">
      {
        en ? (
          <Fragment>
            I have read the{" "}
            <a href={lokalisiere(PATHS.datenschutz, lang)} class="text-brand-700 underline">
              privacy policy
            </a>{" "}
            and consent to my details being processed in order to handle this enquiry.
          </Fragment>
        ) : (
          <Fragment>
            Ich habe die{" "}
            <a href={PATHS.datenschutz} class="text-brand-700 underline">
              Datenschutzerklärung
            </a>{" "}
            gelesen und willige ein, dass meine Angaben zur Bearbeitung der Anfrage verarbeitet werden.
          </Fragment>
        )
      }
    </label>
  </div>

  <button
    type="submit"
    class="inline-flex w-full items-center justify-center bg-brand-700 px-5 py-3 text-sm font-medium text-on-brand transition hover:bg-brand-800 sm:w-auto"
  >
    {T.senden}
  </button>

  <p class="text-xs text-ink-500">
    {T.direkt} <a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </p>
</form>
