---
// Umschalter hell/dunkel. Drei Zustände sind bewusst nicht vorgesehen: der
// Knopf schaltet zwischen hell und dunkel, Ausgangspunkt ist immer die
// Systemeinstellung. Wer nie klickt, folgt dem System dauerhaft.
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex h-11 w-11 items-center justify-center text-ink-600 transition hover:bg-ink-100 hover:text-ink-900"
  aria-label="Zwischen hellem und dunklem Design wechseln"
  aria-pressed="false"
>
  <svg class="h-5 w-5 dark-hide" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
  </svg>
  <svg class="h-5 w-5 dark-show" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
  </svg>
</button>

<style>
  /* Mond im hellen Modus (= „schalte auf dunkel"), Sonne im dunklen. */
  .dark-show { display: none; }
  :root[data-theme="dark"] .dark-hide { display: none; }
  :root[data-theme="dark"] .dark-show { display: inline; }
</style>

<script>
  const apply = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((b) =>
      b.setAttribute("aria-pressed", theme === "dark" ? "true" : "false"),
    );
    // mermaid rendert Diagramme mit fest eingebauten Farben — die müssen neu
    // gezeichnet werden, sonst steht ein helles SVG auf dunklem Grund.
    window.dispatchEvent(new CustomEvent("themechange", { detail: theme }));
  };

  const current = () =>
    document.documentElement.dataset.theme === "dark" ? "dark" : "light";

  document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Privater Modus o. Ä.: dann gilt die Wahl nur für diese Seite.
      }
      apply(next);
    }),
  );

  // Solange niemand aktiv gewählt hat, folgt die Seite dem System.
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem("theme");
    } catch {}
    if (!stored) apply(e.matches ? "dark" : "light");
  });
</script>
