---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  background?: "white" | "muted";
  /**
   * Heading level for `title`. Defaults to h2 because a Section is usually a
   * block inside a page that already has its own h1. Pass "h1" on the one
   * Section that IS the page's main heading — every page needs exactly one h1.
   */
  as?: "h1" | "h2";
}

const { id, eyebrow, title, lead, background = "white", as = "h2" } = Astro.props;
const Heading = as;
const bg = background === "muted" ? "bg-ink-50" : "bg-surface";
---

<section id={id} class={`${bg}`}>
  <div class="mx-auto max-w-6xl px-6 py-20">
    {
      (eyebrow || title || lead) && (
        <header class="mx-auto mb-12 max-w-3xl text-center">
          {eyebrow && (
            <p class="text-sm font-semibold uppercase tracking-widest text-brand-700">{eyebrow}</p>
          )}
          {title && (
            <Heading class="mt-3 font-display text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">
              {title}
            </Heading>
          )}
          {lead && <p class="mt-4 text-lg leading-relaxed text-ink-600">{lead}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
