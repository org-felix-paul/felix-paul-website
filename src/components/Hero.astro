---
import { SITE, PORTRAIT } from "../consts";
import type { Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;
const en = lang === "en";

const T = {
  fuer: en
    ? "For companies, universities, schools & individuals"
    : "Für Unternehmen, Universitäten, Schulen &amp;  Privatpersonen",
  untertitel: en ? "Keynotes & training" : "Keynotes &amp; Bildungsangebote",
  lead: en
    ? "Talks, training and consulting on IT topics such as AI, IAM, IT security and cryptography."
    : "Fachvorträge, Bildungsangebote und Beratung zu IT Themen wie KI, IAM, IT-Sicherheit und Kryptographie.",
  hauptberuflich: en ? "Solution Architect at" : "Hauptberuflich Solution Architekt bei der",
  cta: en ? "Get in touch" : "Jetzt anfragen",
  portraet: en ? `Portrait photo of ${SITE.author}` : `Porträtfoto von ${SITE.author}`,
};
---

<section id="top" class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-canvas to-canvas">
  <div class="absolute inset-0 -z-10 opacity-60">
    <div class="absolute -top-32 -right-32 h-96 w-96 rounded-full bg-brand-200/40 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-brand-100/60 blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-[1.3fr_1fr] md:items-center md:py-28">
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-700" set:html={T.fuer} />
      <h1 class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight text-ink-900 md:text-5xl">
        <span class="text-brand-700">Felix Paul</span>
        <span class="mt-3 block text-2xl font-semibold leading-snug text-ink-700 md:text-3xl" set:html={T.untertitel} />
      </h1>

      <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-700">{T.lead}</p>

      <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-500">
        {T.hauptberuflich}
        <strong class="font-semibold text-ink-700">Atruvia AG</strong>.
      </p>

      <!-- Nur ein Button. Der zweite zeigte auf #speaking und ließ die Seite
           wirken, als ginge es vor allem um Keynotes; die Übersicht direkt
           darunter nennt ohnehin alle Bereiche. -->
      <div class="mt-8">
        <a
          href="#kontakt"
          class="rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-on-accent shadow-sm transition hover:bg-brand-800"
        >
          {T.cta}
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-sm">
      <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-200/50 to-brand-100/30 blur-2xl"></div>
      <img
        src={PORTRAIT.image}
        alt={T.portraet}
        width="800"
        height="800"
        class="aspect-square w-full rounded-3xl object-cover shadow-xl ring-1 ring-ink-200"
        loading="eager"
      />
    </div>
  </div>
</section>
