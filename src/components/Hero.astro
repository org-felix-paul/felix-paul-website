---
import { SITE, PORTRAIT } from "../consts";
---

<section id="top" class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-white">
  <div class="absolute inset-0 -z-10 opacity-60">
    <div class="absolute -top-32 -right-32 h-96 w-96 rounded-full bg-brand-200/40 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-brand-100/60 blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-[1.3fr_1fr] md:items-center md:py-28">
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-700">
        Informatiker &amp; Mathematiker
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight text-ink-900 md:text-5xl">
        <span class="text-brand-700">Felix Paul</span>
        <span class="mt-3 block text-2xl font-semibold leading-snug text-ink-700 md:text-3xl">
          Keynotes &amp; Bildungsangebote (Schulworkshops)
        </span>
      </h1>

      <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-700">
        Als Keynote-Speaker spreche ich auf Konferenzen, an Universitäten und in
        Unternehmen, biete Bildungsangebote für Erwachsene und Schulen zu verschiedenen Themen wie KI, IT-Sicherheit und Medienkompetenz an
        und entwickle über dSolve professionelle Softwareprodukte.
      </p>

      <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-500">
        Hauptberuflich Enterprise Architect bei der
        <strong class="font-semibold text-ink-700">Atruvia AG</strong>, dem
        IT-Dienstleister der genossenschaftlichen Banken.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#kontakt"
          class="rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800"
        >
          Jetzt anfragen
        </a>
        <a
          href="#speaking"
          class="rounded-lg border border-ink-200 bg-white px-5 py-3 text-sm font-medium text-ink-800 shadow-sm transition hover:border-brand-300 hover:text-brand-700"
        >
          Keynotes & Workshops
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-sm">
      <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-200/50 to-brand-100/30 blur-2xl"></div>
      <img
        src={PORTRAIT.image}
        alt={`Porträtfoto von ${SITE.author}`}
        width="800"
        height="800"
        class="aspect-square w-full rounded-3xl object-cover shadow-xl ring-1 ring-ink-200"
        loading="eager"
      />
    </div>
  </div>
</section>
