---
// Der Kopf der Startseite — als Titelseite eines gesetzten Dokuments, nicht
// als Werbebanner.
//
// Vorher: ein Farbverlauf mit zwei weichgezeichneten Kreisen, ein abgerundetes
// Porträtquadrat, alles schwebend. Jetzt: eine Kopfzeile aus Haarlinien, der
// Name als Titel über die volle Breite, darunter zwei Spalten — links der
// Text, rechts das Porträt als Rasterfeld mit derselben Kante wie alles
// andere. Die Worte sind unverändert.
import { SITE, PORTRAIT } from "../consts";
import type { Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;
const en = lang === "en";

const T = {
  fuer: en
    ? "For companies, universities, schools & individuals"
    : "Für Unternehmen, Universitäten, Schulen &amp;  Privatpersonen",
  untertitel: en ? "Keynotes & training" : "Keynotes &amp; Bildungsangebote",
  lead: en
    ? "Talks, training and consulting on IT topics such as AI, IAM, IT security and cryptography."
    : "Fachvorträge, Bildungsangebote und Beratung zu IT Themen wie KI, IAM, IT-Sicherheit und Kryptographie.",
  hauptberuflich: en ? "Solution Architect at" : "Hauptberuflich Solution Architekt bei der",
  cta: en ? "Get in touch" : "Jetzt anfragen",
  portraet: en ? `Portrait photo of ${SITE.author}` : `Porträtfoto von ${SITE.author}`,
};
---

<section id="top" class="bg-surface">
  <div class="mx-auto max-w-[84rem] px-6 pt-10 pb-14 md:pt-14 md:pb-20">
    <!-- Kopfzeile des Dokuments: Label, Haarlinie, Titel. -->
    <p class="label text-brand-700" set:html={T.fuer} />

    <div class="mt-5 border-t border-rule pt-6 md:pt-8">
      <h1 class="font-display tracking-tight text-ink-900">
        <span class="block text-5xl font-bold leading-[0.95] sm:text-6xl md:text-7xl lg:text-8xl">
          Felix Paul
        </span>
        <span
          class="mt-4 block max-w-3xl text-2xl font-semibold leading-snug text-ink-700 md:mt-6 md:text-4xl"
          set:html={T.untertitel}
        />
      </h1>
    </div>

    <!-- Zwei Felder auf einer Kante: Text links, Porträt rechts. -->
    <div class="mt-10 grid gap-8 border-t border-rule pt-8 md:mt-14 md:grid-cols-[minmax(0,1fr)_18rem] md:gap-12 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <div>
        <p class="max-w-2xl text-[1.0625rem] leading-relaxed text-ink-700 md:text-xl">{T.lead}</p>

        <p class="mt-5 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-500">
          {T.hauptberuflich}
          <strong class="font-semibold text-ink-700">Atruvia AG</strong>.
        </p>

        <!-- Nur ein Button. Der zweite zeigte auf #speaking und ließ die Seite
             wirken, als ginge es vor allem um Keynotes; die Übersicht direkt
             darunter nennt ohnehin alle Bereiche. -->
        <div class="mt-8">
          <a
            href="#kontakt"
            class="inline-flex min-h-11 items-center bg-brand-700 px-6 text-sm font-semibold text-white transition hover:bg-brand-800"
          >
            {T.cta}
          </a>
        </div>
      </div>

      <!-- Das Porträt ist ein Rasterfeld, kein schwebendes Objekt: gleiche
           Haarlinie, gleiche rechten Winkel wie jede andere Zelle. -->
      <figure class="border border-rule">
        <img
          src={PORTRAIT.image}
          alt={T.portraet}
          width="800"
          height="800"
          class="aspect-square w-full object-cover md:aspect-[4/5]"
          loading="eager"
        />
      </figure>
    </div>
  </div>
</section>
