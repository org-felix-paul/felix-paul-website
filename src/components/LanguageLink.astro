---
// Zeigt den Sprachwechsel nur dort, wo es wirklich eine übersetzte Seite gibt.
// Ein Link auf eine Rückfall-URL wäre eine Lüge: dahinter stünde derselbe
// deutsche Text unter einer englischen Adresse.
import { echteEnglischeRouten } from "../i18n/pages.mjs";

const uebersetzt = echteEnglischeRouten();
const pfad = Astro.url.pathname;
const istEnglisch = uebersetzt.has(pfad);
const ziel = istEnglisch
  ? pfad.replace(/^\/en\//, "/")
  : uebersetzt.has(`/en${pfad}`)
    ? `/en${pfad}`
    : null;
---

{
  ziel && (
    <a
      href={ziel}
      hreflang={istEnglisch ? "de" : "en"}
      lang={istEnglisch ? "de" : "en"}
      class="rounded-lg px-2 py-1 text-sm font-semibold text-ink-600 transition hover:bg-ink-50 hover:text-ink-900"
      aria-label={istEnglisch ? "Auf Deutsch ansehen" : "View in English"}
    >
      {istEnglisch ? "DE" : "EN"}
    </a>
  )
}
