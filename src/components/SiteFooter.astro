---
// Die Fußzeile, auf jeder Seite derselben Sprache identisch — Hauptseite,
// Blog, Bildung. Sie kennt nur EINE Variable: die Sprache.
//
// Bis §32 nahm sie gar keine Props und war auf der ganzen Domain
// byteidentisch. Das ist mit den englischen Seiten nicht mehr zu halten:
// eine englische Seite mit deutscher Fußzeile verweist auf deutsche
// Rechtsseiten, obwohl es die englischen gibt. Die Zusicherung lautet also
// jetzt „identisch innerhalb einer Sprache" statt „identisch überall" — und
// es gibt weiterhin genau eine Stelle, an der man sie ändert.
import { SITE, PATHS, AREAS } from "../consts";
import { lokalisiere, nurDeutsch } from "../i18n/pages.mjs";
import { uebersetzer, type Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;
const t = uebersetzer(lang);
const beschriftung = (e: { label: string; labelEn?: string }) =>
  lang === "en" ? (e.labelEn ?? e.label) : e.label;
const notiz = (e: { note: string; noteEn?: string }) =>
  lang === "en" ? (e.noteEn ?? e.note) : e.note;
/** Interne Ziele auf die englische Fassung ziehen, wo es sie gibt. */
const ziel = (href: string) => lokalisiere(href, lang);

/** Ein Hinweis an Zielen, die es nur auf Deutsch gibt. */
const deutschesZiel = (href: string) => lang === "en" && nurDeutsch(href);

const year = new Date().getFullYear();
---

{/*
  Der Fuß schließt das Dokument ab und benutzt dieselbe Sprache wie der Rest:
  eine kräftige Abschlusslinie, dieselbe Rasterbreite wie die Startseite
  (84rem), und die Bereichsliste als Zeilen mit Haarlinien statt als frei
  stehende Spalten. Der Bereich ist damit sofort als Verzeichnis lesbar.
*/}
<footer class="mt-20 border-t-2 border-rule bg-surface">
  <div class="mx-auto max-w-[84rem] px-6 py-10">
    <div class="grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-16">
      <div>
        <a href={ziel(PATHS.home)} class="flex w-fit items-center gap-2.5">
          <span
            class="inline-flex h-9 w-9 items-center justify-center bg-brand-700 font-mono text-sm font-bold text-white"
            aria-hidden="true"
          >
            FP
          </span>
          <span class="text-[1.0625rem] font-semibold text-ink-900">{SITE.name}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-600">
          {t("tagline")}
        </p>
      </div>

      <div>
        <h2 class="label border-b border-rule pb-2 text-ink-500">{t("alleBereiche")}</h2>
        <ul class="grid text-sm text-ink-700 sm:grid-cols-2 sm:gap-x-10">
          <li class="border-b border-rule-soft py-3">
            <a href={ziel(PATHS.home)} class="font-semibold text-ink-800 hover:text-brand-700">{t("startseite")}</a>
            <span class="mt-0.5 block text-xs text-ink-500">{t("startseiteNote")}</span>
          </li>
          {
            AREAS.map((a) => (
              <li class="border-b border-rule-soft py-3">
                <a
                  href={a.external ? a.href : ziel(a.href)}
                  target={a.external ? "_blank" : undefined}
                  rel={a.external ? "noopener noreferrer" : undefined}
                  class="font-semibold text-ink-800 hover:text-brand-700"
                >
                  {beschriftung(a)}
                  {deutschesZiel(a.href) && <span class="ml-1.5 font-mono text-[0.65rem] uppercase tracking-wider text-ink-400">in German</span>}
                </a>
                <span class="mt-0.5 block text-xs text-ink-500">{notiz(a)}</span>
                {a.items && (
                  <ul class="mt-2 ml-0 border-l border-rule pl-3 text-xs">
                    {a.items.map((i) => (
                      <li class="py-0.5">
                        <a href={ziel(i.href)} class="text-ink-600 hover:text-brand-700">
                          {beschriftung(i)}
                          {deutschesZiel(i.href) && <span class="ml-1.5 font-mono uppercase tracking-wider text-ink-400">in German</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-rule pt-5 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="tabular-nums">© {year} {SITE.author}. {t("rechteVorbehalten")}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href={ziel(PATHS.kontakt)} class="inline-flex min-h-11 items-center font-semibold hover:text-brand-700">{t("kontakt")}</a></li>
        <li><a href={ziel(PATHS.impressum)} class="inline-flex min-h-11 items-center hover:text-brand-700">{t("impressum")}</a></li>
        <li><a href={ziel(PATHS.datenschutz)} class="inline-flex min-h-11 items-center hover:text-brand-700">{t("datenschutz")}</a></li>
      </ul>
    </div>
  </div>
</footer>
