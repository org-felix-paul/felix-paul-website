---
// The footer, identical on every page of the domain — main site, blog,
// education. It takes no props on purpose: a visitor should meet the same
// four areas, the same contact link and the same legal links wherever they
// are, and there should be exactly one place to change them.
import { SITE, PATHS, AREAS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-100 bg-ink-50">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-[1fr_1.4fr]">
      <div>
        <a href={PATHS.home} class="flex w-fit items-center gap-2">
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-700 font-bold text-white"
            aria-hidden="true"
          >
            FP
          </span>
          <span class="text-lg font-semibold text-ink-900">{SITE.name}</span>
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-600">
          Keynotes &amp; Fachvorträge, Bildungsangebote und Software – zu KI, IT-Sicherheit,
          Cloud und Kryptographie.
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-500">Alle Bereiche</h2>
        <ul class="mt-3 grid gap-3 text-sm text-ink-700 sm:grid-cols-2">
          <li>
            <a href={PATHS.home} class="font-medium text-ink-800 hover:text-brand-700">Startseite</a>
            <span class="block text-xs text-ink-500">Überblick, Hintergrund und Kontakt</span>
          </li>
          {
            AREAS.map((a) => (
              <li>
                <a
                  href={a.href}
                  target={a.external ? "_blank" : undefined}
                  rel={a.external ? "noopener noreferrer" : undefined}
                  class="font-medium text-ink-800 hover:text-brand-700"
                >
                  {a.label}
                </a>
                <span class="block text-xs text-ink-500">{a.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-ink-200 pt-6 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.author}. Alle Rechte vorbehalten.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href={PATHS.kontakt} class="font-medium hover:text-brand-700">Kontakt</a></li>
        <li>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-brand-700">LinkedIn</a>
        </li>
        <li><a href={PATHS.impressum} class="hover:text-brand-700">Impressum</a></li>
        <li><a href={PATHS.datenschutz} class="hover:text-brand-700">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>
