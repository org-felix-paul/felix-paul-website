---
// Die Fußzeile, auf jeder Seite derselben Sprache identisch — Hauptseite,
// Blog, Bildung. Sie kennt nur EINE Variable: die Sprache.
//
// Bis §32 nahm sie gar keine Props und war auf der ganzen Domain
// byteidentisch. Das ist mit den englischen Seiten nicht mehr zu halten:
// eine englische Seite mit deutscher Fußzeile verweist auf deutsche
// Rechtsseiten, obwohl es die englischen gibt. Die Zusicherung lautet also
// jetzt „identisch innerhalb einer Sprache" statt „identisch überall" — und
// es gibt weiterhin genau eine Stelle, an der man sie ändert.
import { SITE, PATHS, AREAS } from "../consts";
import { lokalisiere, nurDeutsch } from "../i18n/pages.mjs";
import { uebersetzer, type Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;
const t = uebersetzer(lang);
const beschriftung = (e: { label: string; labelEn?: string }) =>
  lang === "en" ? (e.labelEn ?? e.label) : e.label;
const notiz = (e: { note: string; noteEn?: string }) =>
  lang === "en" ? (e.noteEn ?? e.note) : e.note;
/** Interne Ziele auf die englische Fassung ziehen, wo es sie gibt. */
const ziel = (href: string) => lokalisiere(href, lang);

/** Ein Hinweis an Zielen, die es nur auf Deutsch gibt. */
const deutschesZiel = (href: string) => lang === "en" && nurDeutsch(href);

const year = new Date().getFullYear();
---

<!-- Keine eigene Fläche mehr: die Fußzeile steht auf derselben Leinwand wie
     der Rest der Seite und wird nur durch eine Haarlinie und viel Luft
     abgesetzt. Ein grauer Block am Seitenende war ein weiterer Kasten in
     einer Seite, die aus Kästen bestand. -->
<footer class="mt-32 border-t border-ink-200">
  <div class="mx-auto max-w-[88rem] px-5 py-16 sm:px-8 md:py-20">
    <div class="grid gap-x-12 gap-y-12 md:grid-cols-12">
      <div class="md:col-span-4 lg:col-span-3">
        <a href={ziel(PATHS.home)} class="flex w-fit items-center gap-2.5">
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-700 text-[0.8125rem] font-bold text-brand-50"
            aria-hidden="true"
          >
            FP
          </span>
          <span class="font-display text-base font-semibold tracking-tight text-ink-900">{SITE.name}</span>
        </a>
        <p class="u-measure-tight mt-5 text-[0.9375rem] leading-relaxed text-ink-600">
          {t("tagline")}
        </p>
      </div>

      <div class="md:col-span-8 lg:col-span-8 lg:col-start-5">
        <h2 class="u-eyebrow text-ink-500">{t("alleBereiche")}</h2>
        <ul class="mt-6 grid gap-x-10 border-t border-ink-200 text-sm text-ink-700 sm:grid-cols-2">
          <li class="border-b border-ink-100 py-4">
            <a href={ziel(PATHS.home)} class="font-medium text-ink-900 hover:text-brand-700">{t("startseite")}</a>
            <span class="mt-0.5 block text-xs leading-relaxed text-ink-500">{t("startseiteNote")}</span>
          </li>
          {
            AREAS.map((a) => (
              <li class="border-b border-ink-100 py-4">
                <a
                  href={a.external ? a.href : ziel(a.href)}
                  target={a.external ? "_blank" : undefined}
                  rel={a.external ? "noopener noreferrer" : undefined}
                  class="font-medium text-ink-900 hover:text-brand-700"
                >
                  {beschriftung(a)}
                  {deutschesZiel(a.href) && <span class="ml-1.5 text-[0.65rem] uppercase tracking-wider text-ink-500">in German</span>}
                </a>
                <span class="mt-0.5 block text-xs leading-relaxed text-ink-500">{notiz(a)}</span>
                {a.items && (
                  <ul class="mt-2.5 space-y-1.5 border-l border-ink-200 pl-3.5 text-xs">
                    {a.items.map((i) => (
                      <li>
                        <a href={ziel(i.href)} class="text-ink-600 hover:text-brand-700">
                          {beschriftung(i)}
                          {deutschesZiel(i.href) && <span class="ml-1.5 uppercase tracking-wider text-ink-500">in German</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-ink-200 pt-8 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.author}. {t("rechteVorbehalten")}</p>
      <ul class="flex flex-wrap items-center gap-x-7 gap-y-2">
        <li><a href={ziel(PATHS.kontakt)} class="font-medium hover:text-brand-700">{t("kontakt")}</a></li>
        <li><a href={ziel(PATHS.impressum)} class="hover:text-brand-700">{t("impressum")}</a></li>
        <li><a href={ziel(PATHS.datenschutz)} class="hover:text-brand-700">{t("datenschutz")}</a></li>
      </ul>
    </div>
  </div>
</footer>
