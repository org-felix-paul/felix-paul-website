---
// Lupe in der Kopfzeile, führt auf die Suchseite (Pagefind-Index aus dem Build).
import { PATHS } from "../consts";
---

<a
  href={PATHS.search}
  class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-ink-600 transition hover:bg-ink-100 hover:text-ink-900"
  aria-label="Seite durchsuchen"
>
  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
  </svg>
</a>
