---
// One header for the whole domain. Branding and nav entries come in as props,
// so each section keeps its identity as data rather than as a forked copy.
//
// A nav entry is either a link or a group. Groups render as a "Mehr" dropdown
// on desktop and as a labelled block in the mobile menu, which keeps the bar
// down to the things someone might actually want to book or read while still
// showing that the rest of the page exists.
//
// Scroll-spy tracks `spy` (a home-page section id), not `href`. The two differ
// for "Blog": it links to /blog/ but marks the blog teaser while you scroll
// past it. A group lights up when any of its children is the current section.

interface NavItem {
  href: string;
  label: string;
  spy?: string;
}

interface NavGroup {
  label: string;
  items: readonly NavItem[];
}

type NavEntry = NavItem | NavGroup;
const isGroup = (e: NavEntry): e is NavGroup => "items" in e;

interface Props {
  home: string;
  logo?: string;
  logoAlt?: string;
  initials?: string;
  wordmark: string;
  wordmarkAccent?: string;
  nav?: readonly NavEntry[];
  cta?: { href: string; label: string; spy?: string };
  width?: string;
}

const {
  home,
  logo,
  logoAlt = "",
  initials = "FP",
  wordmark,
  wordmarkAccent,
  nav = [],
  cta,
  width = "max-w-6xl",
} = Astro.props;

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const homePath = home.replace(/\/$/, "") || "/";
const onHome = current === homePath;

// An anchor only works on the page that owns the sections; from anywhere else
// it has to travel there first.
const toHref = (href: string) =>
  href.startsWith("#") && !onHome ? `${home.replace(/\/$/, "")}/${href}` : href;

// Path entries get their current state server-side; anchors are handled at
// runtime by the scroll observer below.
const isActive = (href: string) => {
  if (href.startsWith("#")) return false;
  const n = href.replace(/\/$/, "") || "/";
  if (n === homePath) return current === homePath;
  return current === n || current.startsWith(n + "/");
};

const linkClass =
  "border-b-2 border-transparent pb-0.5 transition-colors hover:text-brand-700 aria-[current]:border-brand-600 aria-[current]:text-brand-700";
---

<header
  class="sticky top-0 z-40 border-b border-ink-100 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70"
>
  <div class={`mx-auto flex ${width} items-center justify-between gap-6 px-6 py-4`}>
    <a href={toHref(home)} class="flex items-center gap-2 font-display font-semibold tracking-tight">
      {
        logo ? (
          <img src={logo} alt={logoAlt} width="36" height="36" class="h-9 w-9 rounded-lg" />
        ) : (
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-700 font-bold text-white"
            aria-hidden="true"
          >
            {initials}
          </span>
        )
      }
      <span class="text-lg text-ink-900" set:html={
        wordmarkAccent
          ? `${wordmark} <span class="text-brand-700">${wordmarkAccent}</span>`
          : wordmark
      } />
    </a>

    {
      nav.length > 0 && (
        <nav aria-label="Hauptnavigation" class="hidden md:block">
          <ul class="flex items-center gap-7 text-sm font-medium text-ink-700">
            {nav.map((entry) =>
              isGroup(entry) ? (
                <li>
                  <details class="group relative" data-nav-group>
                    <summary
                      data-spy-group={entry.items.map((i) => i.spy).filter(Boolean).join(" ")}
                      class={`flex cursor-pointer list-none items-center gap-1 ${linkClass}`}
                    >
                      {entry.label}
                      <svg
                        class="h-3.5 w-3.5 transition group-open:rotate-180"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </summary>
                    <ul class="absolute right-0 z-50 mt-3 w-64 overflow-hidden rounded-xl border border-ink-200 bg-white p-1 shadow-lg">
                      {entry.items.map((item) => (
                        <li>
                          <a
                            href={toHref(item.href)}
                            data-spy={item.spy}
                            data-nav-close
                            class="block rounded-lg px-3 py-2 text-ink-700 transition hover:bg-ink-50 hover:text-brand-700 aria-[current]:bg-brand-50 aria-[current]:text-brand-700"
                          >
                            {item.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ) : (
                <li>
                  <a
                    href={toHref(entry.href)}
                    data-spy={entry.spy}
                    aria-current={isActive(entry.href) ? "page" : undefined}
                    class={linkClass}
                  >
                    {entry.label}
                  </a>
                </li>
              ),
            )}
          </ul>
        </nav>
      )
    }

    {
      cta && (
        <a
          href={toHref(cta.href)}
          class="hidden rounded-lg bg-brand-700 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-brand-800 md:inline-block"
        >
          {cta.label}
        </a>
      )
    }

    <button
      type="button"
      class="rounded-lg p-2 text-ink-700 hover:bg-ink-50 md:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      data-mobile-menu-button
    >
      <span class="sr-only">Menü öffnen</span>
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Mobile Navigation" class="hidden border-t border-ink-100 md:hidden" data-mobile-menu>
    <ul class="space-y-1 px-6 py-4 text-base font-medium text-ink-800">
      {
        nav.map((entry) =>
          isGroup(entry) ? (
            <li class="pt-2">
              <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-ink-400">
                {entry.label}
              </p>
              <ul class="space-y-1">
                {entry.items.map((item) => (
                  <li>
                    <a
                      href={toHref(item.href)}
                      data-mobile-link
                      data-spy={item.spy}
                      class="block rounded-md px-3 py-2 text-ink-700 transition hover:bg-ink-50 hover:text-brand-700 aria-[current]:bg-brand-50 aria-[current]:text-brand-700"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={toHref(entry.href)}
                data-mobile-link
                data-spy={entry.spy}
                aria-current={isActive(entry.href) ? "page" : undefined}
                class="block rounded-md px-3 py-2 transition hover:bg-ink-50 hover:text-brand-700 aria-[current]:bg-brand-50 aria-[current]:text-brand-700"
              >
                {entry.label}
              </a>
            </li>
          ),
        )
      }
      {
        cta && (
          <li class="pt-3">
            <a
              href={toHref(cta.href)}
              data-mobile-link
              class="block rounded-lg bg-brand-700 px-4 py-2 text-center text-white transition hover:bg-brand-800"
            >
              {cta.label}
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>

<script>
  // ── mobile menu ──────────────────────────────────────────────────────────
  const btn = document.querySelector<HTMLButtonElement>("[data-mobile-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
    menu.querySelectorAll("[data-mobile-link]").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
      });
    });
  }

  // ── dropdown groups ──────────────────────────────────────────────────────
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-nav-group]"));
  const closeGroups = (except?: HTMLDetailsElement) =>
    groups.forEach((g) => {
      if (g !== except) g.open = false;
    });
  groups.forEach((g) => {
    g.addEventListener("toggle", () => g.open && closeGroups(g));
    g.querySelectorAll("[data-nav-close]").forEach((a) =>
      a.addEventListener("click", () => (g.open = false)),
    );
  });
  document.addEventListener("click", (e) => {
    if (!groups.some((g) => g.contains(e.target as Node))) closeGroups();
  });
  document.addEventListener("keydown", (e) => e.key === "Escape" && closeGroups());

  // ── scroll-spy ───────────────────────────────────────────────────────────
  // Marks the nav entry whose section is currently in view. A group's summary
  // lights up when any of its children is the current section, so nothing on
  // the page is silently unrepresented in the bar.
  const spyLinks = Array.from(document.querySelectorAll<HTMLElement>("[data-spy]"));
  const spyGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-spy-group]"));

  const setActive = (id: string | null) => {
    spyLinks.forEach((el) =>
      id && el.dataset.spy === id
        ? el.setAttribute("aria-current", "true")
        : el.removeAttribute("aria-current"),
    );
    spyGroups.forEach((el) =>
      id && (el.dataset.spyGroup ?? "").split(" ").includes(id)
        ? el.setAttribute("aria-current", "true")
        : el.removeAttribute("aria-current"),
    );
  };

  const ids = [
    ...new Set([
      ...spyLinks.map((el) => el.dataset.spy ?? ""),
      ...spyGroups.flatMap((el) => (el.dataset.spyGroup ?? "").split(" ")),
    ]),
  ].filter(Boolean);

  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    // Document order, so the topmost visible section wins when two overlap.
    const order = sections.map((s) => s.id);
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        const current = order.find((id) => visible.has(id)) ?? null;
        if (current) setActive(current);
      },
      { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  /* Safari still paints a disclosure triangle on summary without this. */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
