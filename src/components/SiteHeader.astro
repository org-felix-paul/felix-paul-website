---
// One header for the whole domain. Branding and nav entries come in as props,
// so each section keeps its identity as data rather than as a forked copy.
//
// A nav entry is either a link or a group. Groups render as a "Mehr" dropdown
// on desktop and as a labelled block in the mobile menu, which keeps the bar
// down to the things someone might actually want to book or read while still
// showing that the rest of the page exists.
//
// Scroll-spy tracks `spy` (a home-page section id), not `href`. The two differ
// for "Blog": it links to /blog/ but marks the blog teaser while you scroll
// past it. A group lights up when any of its children is the current section.

interface NavItem {
  href: string;
  label: string;
  labelEn?: string;
  spy?: string;
  /** Ziel gibt es nur in der anderen Sprache. */
  fremdsprachig?: boolean;
  /** Verlässt diese Domain. */
  external?: boolean;
}

interface NavGroup {
  label: string;
  labelEn?: string;
  items: readonly NavItem[];
}

type NavEntry = NavItem | NavGroup;
const isGroup = (e: NavEntry): e is NavGroup => "items" in e;

interface Props {
  /** Sprache der Seite. Steuert Beschriftungen, nicht die Struktur. */
  lang?: "de" | "en";
  /** Where the brand mark links — the section root. */
  home: string;
  /**
   * The page that owns the in-page anchors. Defaults to `home`, which is right
   * for the main site; the blog and the schools section pass "/" because they
   * use the site navigation, whose anchors live on the home page. Without
   * this, "#speaking" on a blog post resolves to /blog/#speaking and lands
   * nowhere.
   */
  anchorBase?: string;
  logo?: string;
  logoAlt?: string;
  initials?: string;
  wordmark: string;
  wordmarkAccent?: string;
  nav?: readonly NavEntry[];
  cta?: { href: string; label: string; spy?: string };
  width?: string;
}

const {
  lang = "de",
  home,
  anchorBase,
  logo,
  logoAlt = "",
  initials = "FP",
  wordmark,
  wordmarkAccent,
  nav = [],
  cta,
  width = "max-w-[88rem]",
} = Astro.props;

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const homePath = home.replace(/\/$/, "") || "/";
const anchorHome = (anchorBase ?? home).replace(/\/$/, "");
const onAnchorPage = current === (anchorHome || "/");

// An anchor only works on the page that owns the sections; from anywhere else
// it has to travel there first.
const toHref = (href: string) =>
  href.startsWith("#") && !onAnchorPage ? `${anchorHome}/${href}` : href;

// Path entries get their current state server-side; anchors are handled at
// runtime by the scroll observer below.
const isActive = (href: string) => {
  if (href.startsWith("#")) return false;
  const n = href.replace(/\/$/, "") || "/";
  if (n === homePath) return current === homePath;
  return current === n || current.startsWith(n + "/");
};

// Beschriftung in der Sprache der Seite, mit Rückfall auf Deutsch.
const beschriftung = (e: { label: string; labelEn?: string }) =>
  lang === "en" ? (e.labelEn ?? e.label) : e.label;

// Führt ein Eintrag in die andere Sprache, wird das im Menü gesagt statt
// den Leser hineinlaufen zu lassen. `hidden` für Screenreader ist hier falsch:
// gerade wer die Seite vorgelesen bekommt, will das vorher wissen.
const fremd = (e: { fremdsprachig?: boolean }) => lang === "en" && e.fremdsprachig;
const fremdKlasse =
  "ml-2 rounded-sm bg-ink-100 px-1.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wider text-ink-500";

// Ein Kopf, der sich zurücknimmt: durchscheinend, weichgezeichnet, ohne
// eigene Kante — solange die Seite oben steht. Erst beim Scrollen zieht er
// sich zusammen und setzt eine Haarlinie, damit der Inhalt nicht unter einer
// unsichtbaren Kante hindurchläuft.

// Externe Ziele öffnen in einem neuen Tab. rel="noopener" ist dabei Pflicht:
// ohne das bekommt die Zielseite über window.opener Zugriff auf diese hier.
const zielAttribute = (e: { external?: boolean }) =>
  e.external ? { target: "_blank", rel: "noopener noreferrer" } : {};

// Der aktive Eintrag wird durch eine Haarlinie markiert, die aus dem Nichts
// aufzieht — nicht durch einen 2px-Balken, der auch im Ruhezustand Platz
// beansprucht und die Leiste unruhig macht.
const linkClass =
  "relative inline-flex items-center py-1 transition-colors hover:text-ink-900 aria-[current]:text-brand-700 after:pointer-events-none after:absolute after:inset-x-0 after:-bottom-px after:h-px after:origin-left after:scale-x-0 after:bg-brand-600 after:transition-transform after:duration-300 hover:after:scale-x-100 aria-[current]:after:scale-x-100";
import ThemeToggle from "./ThemeToggle.astro";
import { uebersetzer } from "../i18n/ui";
import LanguageLink from "./LanguageLink.astro";
const t = uebersetzer(lang);
---

<header class="site-header sticky top-0 z-40" data-site-header>
  <div class={`site-header__inner mx-auto flex ${width} items-center justify-between gap-6 px-5 sm:px-8`}>
    <a
      href={toHref(home)}
      class="group flex shrink-0 items-center gap-2.5 font-display font-semibold tracking-tight"
    >
      {
        logo ? (
          <img src={logo} alt={logoAlt} width="36" height="36" class="site-header__mark rounded-lg" />
        ) : (
          <span
            class="site-header__mark inline-flex items-center justify-center rounded-lg bg-brand-700 text-[0.8125rem] font-bold text-white"
            aria-hidden="true"
          >
            {initials}
          </span>
        )
      }
      <span class="text-[0.9375rem] text-ink-900 sm:text-base" set:html={
        wordmarkAccent
          ? `${wordmark} <span class="text-brand-700">${wordmarkAccent}</span>`
          : wordmark
      } />
    </a>

    {
      nav.length > 0 && (
        <nav aria-label="Hauptnavigation" class="hidden lg:block">
          <ul class="flex items-center gap-8 text-[0.8125rem] font-medium text-ink-600">
            {nav.map((entry) =>
              isGroup(entry) ? (
                <li>
                  <details class="group relative" data-nav-group>
                    <summary
                      data-spy-group={entry.items.map((i) => i.spy).filter(Boolean).join(" ")}
                      class={`flex cursor-pointer list-none items-center gap-1 ${linkClass}`}
                    >
                      {beschriftung(entry)}
                      <svg
                        class="h-3.5 w-3.5 transition group-open:rotate-180"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </summary>
                    <ul class="site-header__menu absolute right-0 z-50 mt-4 w-72 overflow-hidden rounded-2xl border border-ink-200 p-1.5">
                      {entry.items.map((item) => (
                        <li>
                          <a
                            href={toHref(item.href)}
                            {...zielAttribute(item)}
                            data-spy={item.spy}
                            data-nav-close
                            class="flex min-h-11 items-center rounded-lg px-3 py-2.5 text-ink-700 transition hover:bg-ink-50 hover:text-brand-700 aria-[current]:bg-brand-50 aria-[current]:text-brand-700"
                          >
                            {beschriftung(item)}
                            {fremd(item) && <span class={fremdKlasse}>in German</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ) : (
                <li>
                  <a
                    href={toHref(entry.href)}
                    {...zielAttribute(entry)}
                    data-spy={entry.spy}
                    aria-current={isActive(entry.href) ? "page" : undefined}
                    class={linkClass}
                  >
                    {beschriftung(entry)}
                    {fremd(entry) && <span class={fremdKlasse}>in German</span>}
                  </a>
                </li>
              ),
            )}
          </ul>
        </nav>
      )
    }

    <div class="hidden shrink-0 items-center gap-1 lg:flex">
      <LanguageLink />
      <ThemeToggle />
      {
        cta && (
          <a
            href={toHref(cta.href)}
            class="ml-2 inline-flex min-h-9 items-center rounded-full bg-brand-700 px-4 text-[0.8125rem] font-medium text-white transition hover:bg-brand-800"
          >
            {cta.label}
          </a>
        )
      }
    </div>

    <div class="flex shrink-0 items-center gap-0.5 lg:hidden">
      <LanguageLink />
      <ThemeToggle />
    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-ink-700 transition hover:bg-ink-50 hover:text-ink-900"
      aria-controls="mobile-nav"
      aria-expanded="false"
      data-mobile-menu-button
    >
      <span class="sr-only">{t("menueOeffnen")}</span>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
      </svg>
    </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Mobile Navigation" class="site-header__panel hidden border-t border-ink-200 lg:hidden" data-mobile-menu>
    <ul class="space-y-0.5 px-5 py-4 text-base font-medium text-ink-800 sm:px-8">
      {
        nav.map((entry) =>
          isGroup(entry) ? (
            /*
             * Auf dem Handy klappt eine Gruppe zu, statt ihre Unterpunkte in
             * die Liste zu kippen. Sonst stehen z. B. die vier Zielgruppen der
             * Bildungsangebote gleichrangig neben "Software" und "Blog" — das
             * Menü wird lang und die Gliederung ist nicht mehr erkennbar.
             */
            <li>
              <details class="group/mobile">
                <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2.5 transition hover:bg-ink-50 hover:text-brand-700">
                  {beschriftung(entry)}
                  <svg
                    class="h-4 w-4 text-ink-400 transition group-open/mobile:rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <ul class="mt-0.5 ml-3 space-y-0.5 border-l border-ink-200 pl-3 text-[0.9375rem] font-normal">
                  {entry.items.map((item) => (
                    <li>
                      <a
                        href={toHref(item.href)}
                        {...zielAttribute(item)}
                        data-mobile-link
                        data-spy={item.spy}
                        class="flex min-h-11 items-center rounded-lg px-3 py-2 text-ink-600 transition hover:bg-ink-50 hover:text-brand-700 aria-[current]:bg-brand-50 aria-[current]:text-brand-700"
                      >
                        {beschriftung(item)}
                        {fremd(item) && <span class={fremdKlasse}>in German</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={toHref(entry.href)}
                {...zielAttribute(entry)}
                data-mobile-link
                data-spy={entry.spy}
                aria-current={isActive(entry.href) ? "page" : undefined}
                class="flex min-h-11 items-center rounded-lg px-3 py-2.5 transition hover:bg-ink-50 hover:text-brand-700 aria-[current]:bg-brand-50 aria-[current]:text-brand-700"
              >
                {beschriftung(entry)}
                {fremd(entry) && <span class={fremdKlasse}>in German</span>}
              </a>
            </li>
          ),
        )
      }
      {
        cta && (
          <li class="pt-3">
            <a
              href={toHref(cta.href)}
              data-mobile-link
              class="flex min-h-11 items-center justify-center rounded-full bg-brand-700 px-4 text-center text-[0.9375rem] text-white transition hover:bg-brand-800"
            >
              {cta.label}
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>

<script>
  // ── condense on scroll ───────────────────────────────────────────────────
  // Oben auf der Seite hat der Kopf keine Kante und darf Platz nehmen. Sobald
  // Inhalt darunter durchläuft, zieht er sich zusammen und setzt eine
  // Haarlinie — das ist die einzige Stelle, an der die Leiste sich meldet.
  const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");
  if (siteHeader) {
    let ticking = false;
    const sync = () => {
      ticking = false;
      siteHeader.toggleAttribute("data-scrolled", window.scrollY > 8);
    };
    sync();
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(sync);
      },
      { passive: true },
    );
  }

  // ── mobile menu ──────────────────────────────────────────────────────────
  const btn = document.querySelector<HTMLButtonElement>("[data-mobile-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  if (btn && menu) {
    const closeMenu = (refocus = false) => {
      menu.classList.add("hidden");
      btn.setAttribute("aria-expanded", "false");
      if (refocus) btn.focus();
    };
    btn.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
    menu.querySelectorAll("[data-mobile-link]").forEach((link) => {
      link.addEventListener("click", () => closeMenu());
    });
    // Escape schließt das Menü und gibt den Fokus zurück an den Knopf —
    // sonst landet man beim Weitertabben im geschlossenen Menü.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) closeMenu(true);
    });
  }

  // ── dropdown groups ──────────────────────────────────────────────────────
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-nav-group]"));
  const closeGroups = (except?: HTMLDetailsElement) =>
    groups.forEach((g) => {
      if (g !== except) g.open = false;
    });
  groups.forEach((g) => {
    g.addEventListener("toggle", () => g.open && closeGroups(g));
    g.querySelectorAll("[data-nav-close]").forEach((a) =>
      a.addEventListener("click", () => (g.open = false)),
    );
  });
  document.addEventListener("click", (e) => {
    if (!groups.some((g) => g.contains(e.target as Node))) closeGroups();
  });
  document.addEventListener("keydown", (e) => e.key === "Escape" && closeGroups());

  // ── scroll-spy ───────────────────────────────────────────────────────────
  // Marks the nav entry whose section is currently in view. A group's summary
  // lights up when any of its children is the current section, so nothing on
  // the page is silently unrepresented in the bar.
  const spyLinks = Array.from(document.querySelectorAll<HTMLElement>("[data-spy]"));
  const spyGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-spy-group]"));

  const setActive = (id: string | null) => {
    spyLinks.forEach((el) =>
      id && el.dataset.spy === id
        ? el.setAttribute("aria-current", "true")
        : el.removeAttribute("aria-current"),
    );
    spyGroups.forEach((el) =>
      id && (el.dataset.spyGroup ?? "").split(" ").includes(id)
        ? el.setAttribute("aria-current", "true")
        : el.removeAttribute("aria-current"),
    );
  };

  const ids = [
    ...new Set([
      ...spyLinks.map((el) => el.dataset.spy ?? ""),
      ...spyGroups.flatMap((el) => (el.dataset.spyGroup ?? "").split(" ")),
    ]),
  ].filter(Boolean);

  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    // Document order, so the topmost visible section wins when two overlap.
    const order = sections.map((s) => s.id);
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        const current = order.find((id) => visible.has(id)) ?? null;
        if (current) setActive(current);
      },
      { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  /* Safari still paints a disclosure triangle on summary without this. */
  summary::-webkit-details-marker {
    display: none;
  }

  /* Durchscheinend statt deckend: der Inhalt bleibt unter der Leiste sichtbar
     und schiebt sich nicht hinter eine zweite weiße Wand. Der Weichzeichner
     hält den Text trotzdem lesbar. */
  .site-header {
    background-color: color-mix(in srgb, var(--color-surface) 78%, transparent);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header {
      background-color: color-mix(in srgb, var(--color-surface) 62%, transparent);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      backdrop-filter: saturate(180%) blur(20px);
    }
  }

  .site-header[data-scrolled] {
    border-bottom-color: var(--color-ink-200);
  }

  /* Die Höhe ist die eigentliche Geste: 4.5rem oben, 3.5rem beim Scrollen.
     Padding statt height, damit ein umbrechendes Wortzeichen nicht abgeschnitten
     wird. */
  .site-header__inner {
    padding-block: 1.0625rem;
    transition: padding-block 0.3s ease;
  }

  .site-header[data-scrolled] .site-header__inner {
    padding-block: 0.5625rem;
  }

  .site-header__mark {
    height: 2.25rem;
    width: 2.25rem;
    transition:
      height 0.3s ease,
      width 0.3s ease;
  }

  .site-header[data-scrolled] .site-header__mark {
    height: 2rem;
    width: 2rem;
  }

  /* Aufklappmenü und Handy-Menü liegen über dem Inhalt und brauchen deshalb
     mehr Deckkraft als die Leiste selbst — sonst liest man zwei Ebenen
     übereinander. */
  .site-header__menu,
  .site-header__panel {
    background-color: color-mix(in srgb, var(--color-surface) 92%, transparent);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header__menu,
    .site-header__panel {
      -webkit-backdrop-filter: saturate(180%) blur(24px);
      backdrop-filter: saturate(180%) blur(24px);
    }
  }
</style>
