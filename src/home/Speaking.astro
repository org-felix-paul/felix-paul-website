---
// Keynotes & Fachvorträge: eine Karte pro Thema, das für sich steht.
// Bewusst je ein Satz — dieser Abschnitt ist eine Speisekarte, nicht der
// Vortrag selbst.
import Section from "../components/Section.astro";
import type { Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;

const de = {
  eyebrow: "Speaking & Consulting",
  title: "Keynotes & Fachvorträge",
  lead: "Ich spreche und berate auf Konferenzen, an Universitäten und in Unternehmen über die folgenden Themen.",
  themen: [
    {
      title: "Künstliche Intelligenz",
      text: "Funktionsweise, (un)sinnvolle Einsatzgebiete, KI-Integrationsarchitekturen (A2A, MCP, REST) und kosteneffiziente Einsatzskalierung (Von AI Gateway über Sandboxes, Filtermechanismen, ...)",
    },
    {
      title: "Identity & Access Management",
      text: "Moderne Authentifizierung, Autorisierung und Zero Trust in hybriden Cloudumgebungen richtig einsetzen.",
    },
    {
      title: "IT Security",
      text: "Lehrbuch gegen gelebte Praxis. Wie findet man den richtigen Trade-Off zwischen Security, Kosten, Usability und Wartbarkeit – Einblicke aus der Finanzbranche",
    },
    {
      title: "Cloud",
      text: "Was wirklich skaliert, was nur kostet, hybride Szenarien und welche Architekturentscheidungen sich später kaum noch korrigieren lassen.",
    },
    {
      title: "Kryptographie",
      text: "Über Fully Homomorphic Encryption (Rechnen auf verschlüsselten Daten) bis Post-Quanten-Kryptographie (mathematischer Deep Dive oder pragmatische Migrationsroadmap).",
    },
  ],
  // Sechste Kachel im Raster: kurze Stichworte statt ausformulierter Themen,
  // damit die Liste wachsen kann, ohne den Abschnitt zu verlängern.
  weitereTitel: "Weitere Themen",
  weitere: ["Gesellschaftliche Folgen von KI", "Skalierungsprobleme bei Enterprise-IT", "..."],
  consultingTitel: "Consulting",
  consulting:
    "Beratung zu diesen Themen ist natürlich auch möglich. Egal, ob Konzeption, Architektur-Review oder Hands-On Umsetzung.",
  cta: "Jetzt anfragen",
  nachsatz: "Ihr Thema ist nicht dabei? Sprechen Sie mich gerne an.",
};

const en: typeof de = {
  eyebrow: "Speaking & consulting",
  title: "Keynotes & talks",
  lead: "I speak and advise at conferences, universities and companies on the topics below.",
  themen: [
    {
      title: "Artificial intelligence",
      text: "How it works, where it does and does not belong, AI integration architectures (A2A, MCP, REST) and scaling it without the bill running away (AI gateways, sandboxes, filtering, and the rest).",
    },
    {
      title: "Identity & Access Management",
      text: "Getting modern authentication, authorization and zero trust right in hybrid cloud environments.",
    },
    {
      title: "IT security",
      text: "The textbook against everyday practice. How to find the right trade-off between security, cost, usability and maintainability — from inside the financial industry.",
    },
    {
      title: "Cloud",
      text: "What actually scales, what only costs, how hybrid setups play out, and which architecture decisions you can barely correct later.",
    },
    {
      title: "Cryptography",
      text: "From fully homomorphic encryption (computing on encrypted data) to post-quantum cryptography — as a mathematical deep dive or as a pragmatic migration roadmap.",
    },
  ],
  weitereTitel: "More topics",
  weitere: ["What AI does to society", "Scaling problems in enterprise IT", "…"],
  consultingTitel: "Consulting",
  consulting:
    "Consulting on these topics is of course also possible — whether that is design work, an architecture review, or hands-on implementation.",
  cta: "Get in touch",
  nachsatz: "Your topic is not listed? Ask me anyway.",
};

const T = lang === "en" ? en : de;
---

<Section id="speaking" eyebrow={T.eyebrow} title={T.title} lead={T.lead}>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      T.themen.map((t) => (
        <div class="rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-ink-900">{t.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{t.text}</p>
        </div>
      ))
    }

    {/* Sechste Kachel: weitere Themen als Stichwortliste. Gleiche Größe wie
         die anderen, aber zurückgenommen (grauer Rahmen, kleinere Schrift). */}
    <div class="rounded-2xl border border-dashed border-ink-300 bg-ink-50 p-6">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-500">{T.weitereTitel}</h3>
      <ul class="mt-3 space-y-1.5 text-sm text-ink-600">
        {
          T.weitere.map((t) => (
            <li class="flex items-start gap-2">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-400" aria-hidden="true" />
              <span>{t}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mt-6 rounded-2xl border border-brand-200 bg-brand-50 p-6 text-center shadow-sm">
    <h3 class="text-lg font-semibold text-ink-900">{T.consultingTitel}</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-600">{T.consulting}</p>
  </div>

  {/* YouTube-Vorträge vorübergehend ausgeblendet. Zum Reaktivieren die
      umschließenden Kommentar-Marker entfernen. */}
  {/*
  <div class="mt-12 grid gap-8 md:grid-cols-2">
    <div>
      <div class="aspect-video w-full overflow-hidden rounded-2xl border border-ink-200 shadow-sm">
        <iframe
          class="h-full w-full"
          src="https://www.youtube.com/embed/4JBXO_SQuJM"
          title="Fully Homomorphic Encryption and its Use Cases (englischer Vortrag)"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
      <p class="mt-3 text-sm text-ink-600">Englisch – „Fully Homomorphic Encryption and its Use Cases".</p>
    </div>
    <div>
      <div class="aspect-video w-full overflow-hidden rounded-2xl border border-ink-200 shadow-sm">
        <iframe
          class="h-full w-full"
          src="https://www.youtube.com/embed/awbrW_Rl2nU"
          title="Fully Homomorphic Encryption – KI in der Cloud ohne Datenschutzbedenken (deutscher Vortrag)"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen></iframe>
      </div>
      <p class="mt-3 text-sm text-ink-600">Deutsch – „FHE – KI in der Cloud ohne Datenschutzbedenken".</p>
    </div>
  </div>
  */}

  <div class="mt-10 text-center">
    <a href="#kontakt" class="rounded-lg bg-brand-700 px-5 py-3 text-sm font-medium text-on-accent shadow-sm transition hover:bg-brand-800">
      {T.cta}
    </a>
    <p class="mx-auto mt-4 max-w-xl text-sm text-ink-500">{T.nachsatz}</p>
  </div>
</Section>
