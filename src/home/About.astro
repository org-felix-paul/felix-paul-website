---
// "Über mich": Portrait, zwei Sätze und die Abschlüsse als Blöcke.
import Section from "../components/Section.astro";
import { SITE, PORTRAIT } from "../consts";
import type { Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;

const de = {
  eyebrow: "Über mich",
  title: "Kurz zu mir",
  portraet: `${SITE.author} – persönliches Foto`,
  antrieb: "Was mich antreibt: Neues lernen, Zusammenhänge verstehen, selbst nachprüfen & umsetzen, Wissen teilen.",
  lebenslauf: "Den ausführlichen Lebenslauf gibt es auf",
  hintergrund: "Mein Hintergrund",
  fach: ["M.Sc. Informatik", "B.Sc. Informatik", "B.Sc. Mathematik"],
  fachTitel: "Fachstudium",
  lehramt: ["M.Ed. Mathematik & Informatik", "B.Ed. Mathematik & Informatik"],
  lehramtTitel: "Lehramtsstudium",
  praxis: "Praxiserfahrung",
  praxisTitel: "Konkrete Umsetzung",
  fazit:
    "Drei vollständige Studiengänge nebeneinander: Informatik und Mathematik fachlich, Lehramt didaktisch. Dazu die tägliche Praxis als Solution Architekt in der Finanzbranche – deshalb bleiben Vorträge und Workshops nah an dem, was wirklich passiert.",
};

const en: typeof de = {
  eyebrow: "About me",
  title: "A little about me",
  portraet: `${SITE.author} – personal photo`,
  antrieb:
    "What drives me: learning new things, understanding how they fit together, checking and building them myself, and passing the knowledge on.",
  lebenslauf: "The full CV is on",
  hintergrund: "My background",
  fach: ["M.Sc. Computer Science", "B.Sc. Computer Science", "B.Sc. Mathematics"],
  fachTitel: "Subject degrees",
  lehramt: ["M.Ed. Maths & Computer Science", "B.Ed. Maths & Computer Science"],
  lehramtTitel: "Teaching degrees",
  praxis: "Hands-on experience",
  praxisTitel: "Actually building it",
  fazit:
    "Three complete degree programmes side by side: computer science and mathematics for the subject matter, teaching for how to convey it. On top of that, the day job as a Solution Architect in the financial industry — which is why the talks and workshops stay close to what actually happens.",
};

const T = lang === "en" ? en : de;

// Ein Abschluss-Block: blau für das Fachstudium, grün fürs Lehramt. Die
// Klassen stehen ausgeschrieben da, weil Tailwind nur vollständige Klassen-
// namen im Quelltext findet — zusammengesetzte (`bg-${farbe}-100`) würden
// nicht ins CSS aufgenommen.
const blockFach =
  "flex h-14 w-20 items-center justify-center rounded-xl bg-brand-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-brand-900 ring-1 ring-brand-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs";
const blockLehramt =
  "flex h-14 w-20 items-center justify-center rounded-xl bg-emerald-100 px-1.5 text-center text-[0.6rem] font-semibold leading-tight text-emerald-900 ring-1 ring-emerald-200 sm:h-16 sm:w-28 sm:px-2 sm:text-xs";
const bildunterschrift = "mt-2 text-center text-[0.65rem] font-medium uppercase tracking-wider text-ink-500 sm:text-xs";
---

<Section id="ueber-mich" background="muted" eyebrow={T.eyebrow} title={T.title}>
  <div class="mx-auto max-w-5xl">
    <div class="grid items-start gap-10 md:grid-cols-[auto_1fr]">
      <figure class="mx-auto w-full max-w-xs">
        <img
          src={PORTRAIT.image}
          alt={T.portraet}
          width="640"
          height="800"
          class="aspect-[4/5] w-full rounded-2xl object-cover shadow-md ring-1 ring-ink-200"
          loading="lazy"
        />
      </figure>

      <div>
        <div class="prose-content">
          <p>{T.antrieb}</p>
          <p>
            {T.lebenslauf} <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
          </p>
        </div>

        <figure class="mt-8">
          <figcaption class="text-sm font-semibold uppercase tracking-widest text-brand-700">
            {T.hintergrund}
          </figcaption>
          <div class="mt-6">
            {/* Drei Gruppen nebeneinander, Unterkanten der Blöcke bündig:
                 die beiden Studienstränge und daneben die Praxiserfahrung,
                 die über die volle Höhe beider Reihen läuft. Jede Gruppe hat
                 eine dünne Bildunterschrift, damit klar ist, wofür M.Ed.
                 steht. Auf Mobil bricht die Praxis in eine eigene Zeile. */}
            <div class="flex flex-col gap-4">
              <div class="flex flex-wrap items-end gap-4 sm:gap-6">
                {/* Fachstudium: Informatik (B.Sc. + M.Sc.) und Mathematik (B.Sc.) */}
                <div>
                  <div class="flex items-end gap-2 sm:gap-3">
                    <div class="flex flex-col gap-2">
                      <div class={blockFach}>{T.fach[0]}</div>
                      <div class={blockFach}>{T.fach[1]}</div>
                    </div>
                    <div class="flex flex-col gap-2">
                      <div class={blockFach}>{T.fach[2]}</div>
                    </div>
                  </div>
                  <p class={bildunterschrift}>{T.fachTitel}</p>
                </div>

                {/* Lehramtsstudium: B.Ed. + M.Ed. */}
                <div>
                  <div class="flex flex-col gap-2">
                    <div class={blockLehramt}>{T.lehramt[0]}</div>
                    <div class={blockLehramt}>{T.lehramt[1]}</div>
                  </div>
                  <p class={bildunterschrift}>{T.lehramtTitel}</p>
                </div>

                {/* Praxiserfahrung: gleiche Höhe wie beide Block-Reihen
                     zusammen, breiter und farblich dominant. */}
                <div class="w-full sm:w-auto sm:flex-1">
                  <div class="flex h-16 w-full items-center justify-center rounded-xl bg-brand-600 px-4 text-on-accent shadow-sm ring-1 ring-brand-700 sm:h-[8.5rem] sm:min-w-[12rem]">
                    <span class="text-center text-sm font-semibold uppercase tracking-wider sm:text-base">
                      {T.praxis}
                    </span>
                  </div>
                  <p class={bildunterschrift}>{T.praxisTitel}</p>
                </div>
              </div>

              <p class="text-xs leading-relaxed text-ink-500">{T.fazit}</p>
            </div>
          </div>
        </figure>
      </div>
    </div>
  </div>
</Section>
