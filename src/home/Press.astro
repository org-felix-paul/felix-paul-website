---
// Presse & Rednerprofil: Kurzbio zum Kopieren und die Downloads.
import Section from "../components/Section.astro";
import { SITE, PORTRAIT } from "../consts";
import type { Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;

const de = {
  eyebrow: "Presse & Rednerprofil",
  title: "Material für Veranstalter & Presse",
  lead: "Kurzbio, Foto und Rednerprofil – das Wichtigste auf einen Blick.",
  kurzbio: "Kurzbio (zum Kopieren)",
  bio: "Felix Paul ist Informatiker und Mathematiker mit Schwerpunkt IT Security, IAM, KI und Cloud. Hauptberuflich ist er Solution Architekt bei der Atruvia AG, dem IT-Dienstleister der genossenschaftlichen Banken. Daneben ist er auch freiberuflich sehr aktiv. Als Keynote-Speaker spricht er auf Konferenzen, an Universitäten und in Unternehmen. Außerdem hält er Vorträge an Schulen, vertreibt eigene Softwareprodukte und veröffentlichte ein Buch über Post-Quanten-Kryptographie bei Springer.",
  sprachen: "Sprachen",
  sprachenWert: "Deutsch · Englisch",
  kontakt: "Kontakt",
  downloads: "Downloads",
  rednerprofil: "Rednerprofil (PDF)",
  pressefoto: "Pressefoto (Porträt)",
};

const en: typeof de = {
  eyebrow: "Press & speaker profile",
  title: "Material for organisers & press",
  lead: "Short bio, photo and speaker profile – the essentials in one place.",
  kurzbio: "Short bio (ready to copy)",
  bio: "Felix Paul is a computer scientist and mathematician focusing on IT security, IAM, AI and cloud. His day job is Solution Architect at Atruvia AG, the IT provider of the German cooperative banks; alongside that he is very active as a freelancer. As a keynote speaker he appears at conferences, universities and companies. He also gives talks at schools, sells his own software products, and published a book on post-quantum cryptography with Springer.",
  sprachen: "Languages",
  sprachenWert: "German · English",
  kontakt: "Contact",
  downloads: "Downloads",
  rednerprofil: "Speaker profile (PDF)",
  pressefoto: "Press photo (portrait)",
};

const T = lang === "en" ? en : de;

const download =
  "flex items-center justify-between rounded-lg border border-ink-200 px-4 py-3 text-sm font-medium text-ink-800 transition hover:border-brand-300 hover:text-brand-700";
---

<Section id="presse" background="muted" eyebrow={T.eyebrow} title={T.title} lead={T.lead}>
  <div class="grid gap-6 md:grid-cols-[1.4fr_1fr]">
    <div class="rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm md:p-8">
      <h3 class="font-display text-lg font-semibold text-ink-900">{T.kurzbio}</h3>
      <p class="mt-3 text-sm leading-relaxed text-ink-700">{T.bio}</p>
      <dl class="mt-6 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
        <div><dt class="font-medium text-ink-500">{T.sprachen}</dt><dd class="mt-1 text-ink-900">{T.sprachenWert}</dd></div>
        <div><dt class="font-medium text-ink-500">{T.kontakt}</dt><dd class="mt-1"><a class="text-brand-700 underline" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
      </dl>
    </div>

    <div class="flex flex-col gap-4 rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm md:p-8">
      <h3 class="font-display text-lg font-semibold text-ink-900">{T.downloads}</h3>
      <a href="/pdf/rednerprofil.pdf" download class={download}>
        {T.rednerprofil}
        <span class="text-xs text-ink-500">PDF</span>
      </a>
      <a href={PORTRAIT.press} download class={download}>
        {T.pressefoto}
        <span class="text-xs text-ink-500">PNG</span>
      </a>
    </div>
  </div>
</Section>
