---
// Publikationen: das Buch bei Springer und zwei Fachbeiträge.
import Section from "../components/Section.astro";
import type { Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;

const de = {
  eyebrow: "Publikationen",
  title: "Buch & Paper",
  lead: "Forschung zu Kryptographie und KI – als Buch bei Springer und als Fachbeiträge.",
  buch: {
    cover: "Buchcover: Goppa Codes and the McEliece Cryptosystem (Springer BestMasters)",
    text: "Eine fundierte Einführung in das McEliece-Kryptosystem – von den mathematischen Basics bis zur konkreten Implementierung.",
    uebersicht: "Kapitelübersicht des Buches",
    leseprobe: "Leseprobe aus dem Buch",
    literatur: "Literaturverzeichnis des Buches",
    hinweis: "Klicken Sie auf eine Vorschau, um Kapitelübersicht, Leseprobe oder Literaturverzeichnis als PDF zu öffnen.",
    kaufen: "Bei Springer ansehen & kaufen",
  },
  fhe: {
    kicker: "Fachbeitrag · Kryptographie",
    text: "Survey-Paper darüber, wie FHE Berechnungen auf verschlüsselten Daten ermöglicht – inklusive Vortrag und Folien.",
    paper: "Paper (PDF)",
    folien: "Folien (PDF)",
  },
  scienceGym: {
    kicker: "Fachbeitrag · KI",
    // HTML, weil der Zeitschriftenname kursiv steht.
    html: "Eine einfache Testumgebung, um zu untersuchen, wie KI selbstständig wissenschaftliche Zusammenhänge entdecken kann – erschienen in <em>Machine Learning</em> (Springer).",
    artikel: "Artikel ansehen",
  },
};

const en: typeof de = {
  eyebrow: "Publications",
  title: "Book & papers",
  lead: "Research on cryptography and AI – as a book with Springer and as peer-reviewed papers.",
  buch: {
    cover: "Book cover: Goppa Codes and the McEliece Cryptosystem (Springer BestMasters)",
    text: "A thorough introduction to the McEliece cryptosystem — from the mathematical foundations through to a concrete implementation.",
    uebersicht: "Chapter overview of the book",
    leseprobe: "Sample pages from the book",
    literatur: "Bibliography of the book",
    hinweis: "Click a preview to open the chapter overview, the sample pages or the bibliography as a PDF.",
    kaufen: "View & buy at Springer",
  },
  fhe: {
    kicker: "Paper · Cryptography",
    text: "A survey paper on how FHE makes computation on encrypted data possible — including the talk and the slides.",
    paper: "Paper (PDF)",
    folien: "Slides (PDF)",
  },
  scienceGym: {
    kicker: "Paper · AI",
    html: "A simple test environment for studying how AI can discover scientific relationships on its own – published in <em>Machine Learning</em> (Springer).",
    artikel: "View the article",
  },
};

const T = lang === "en" ? en : de;

const vorschauen = [
  { pdf: "/pdf/goppa-book/uebersicht.pdf", img: "/img/goppa-book/uebersicht.png", alt: T.buch.uebersicht },
  { pdf: "/pdf/goppa-book/leseprobe.pdf", img: "/img/goppa-book/leseprobe.png", alt: T.buch.leseprobe },
  { pdf: "/pdf/goppa-book/literaturverzeichnis.pdf", img: "/img/goppa-book/literaturverzeichnis.png", alt: T.buch.literatur },
];

const button = "rounded-lg bg-brand-700 px-4 py-2 text-on-accent shadow-sm transition hover:bg-brand-800";
const buttonLeise = "rounded-lg border border-ink-200 px-4 py-2 text-ink-800 transition hover:border-brand-300 hover:text-brand-700";
---

<Section id="publikationen" background="muted" eyebrow={T.eyebrow} title={T.title} lead={T.lead}>
  {/* Buch */}
  <article class="rounded-3xl border border-ink-200 bg-surface p-6 shadow-sm md:p-10">
    <div class="grid gap-8 md:grid-cols-[auto_1fr] md:items-start">
      <img
        src="/img/goppa-book/cover.avif"
        alt={T.buch.cover}
        width="500"
        height="709"
        class="mx-auto w-44 rounded-xl shadow-lg ring-1 ring-ink-200 sm:w-52"
        loading="lazy"
      />
      <div>
        <h3 class="font-display text-2xl font-bold text-ink-900">Goppa Codes and the McEliece Cryptosystem</h3>
        <p class="mt-3 leading-relaxed text-ink-600">{T.buch.text}</p>
        <div class="mt-5 grid grid-cols-3 gap-3">
          {
            vorschauen.map((v) => (
              <a href={v.pdf} class="group block overflow-hidden rounded-lg border border-ink-200">
                <img
                  src={v.img}
                  alt={v.alt}
                  width="300"
                  height="112"
                  class="h-28 w-full object-cover object-top transition group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </a>
            ))
          }
        </div>
        <p class="mt-3 text-xs text-ink-500">{T.buch.hinweis}</p>
        <div class="mt-5 flex flex-wrap gap-2 text-sm font-medium">
          <a href="https://link.springer.com/book/10.1007/978-3-658-46743-2" target="_blank" rel="noopener noreferrer" class={button}>
            {T.buch.kaufen}
          </a>
        </div>
      </div>
    </div>
  </article>

  {/* Paper */}
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    <div class="flex h-full flex-col rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-widest text-brand-700">{T.fhe.kicker}</div>
      <h3 class="mt-2 text-lg font-semibold text-ink-900">Fully Homomorphic Encryption and its Use Cases</h3>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{T.fhe.text}</p>
      <div class="mt-4 flex flex-wrap gap-2 text-sm font-medium">
        <a href="/pdf/fhe-survey.pdf" class={button}>{T.fhe.paper}</a>
        <a href="/pdf/slides-fhe-use-cases-without-notes.pdf" class={buttonLeise}>{T.fhe.folien}</a>
      </div>
    </div>

    <div class="flex h-full flex-col rounded-2xl border border-ink-200 bg-surface p-6 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-widest text-brand-700">{T.scienceGym.kicker}</div>
      <h3 class="mt-2 text-lg font-semibold text-ink-900">Science-Gym: a simple testbed for AI-driven scientific discovery</h3>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600" set:html={T.scienceGym.html} />
      <div class="mt-4 flex flex-wrap gap-2 text-sm font-medium">
        <a href="https://link.springer.com/article/10.1007/s10994-025-06914-x" target="_blank" rel="noopener noreferrer" class={button}>
          {T.scienceGym.artikel}
        </a>
      </div>
    </div>
  </div>
</Section>
