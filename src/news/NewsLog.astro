---
// "Aktuelles": gehaltene Workshops und Vorträge, Veröffentlichungen und
// Releases, neueste zuerst. Gepflegt über src/news/content/*.md – eine Datei
// pro Eintrag. Rendert nichts, solange es keine Einträge gibt.
//
// Derzeit nicht eingebunden – siehe src/home/HomePage.astro.
import { getCollection } from "astro:content";
import Section from "../components/Section.astro";
import { NEWS_KIND_LABELS } from "./collection";
import type { Sprache } from "../i18n/ui";

interface Props {
  lang?: Sprache;
}
const { lang = "de" } = Astro.props;
const en = lang === "en";

const eintraege = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const datum = new Intl.DateTimeFormat(en ? "en-GB" : "de-DE", { year: "numeric", month: "long" });

const de = {
  eyebrow: "Aktuelles",
  title: "Zuletzt gemacht",
  lead: "Gehaltene Workshops und Vorträge, Veröffentlichungen und Releases – in umgekehrter Reihenfolge.",
  mehr: "Mehr dazu",
};
const enT: typeof de = {
  eyebrow: "Latest",
  title: "Recently done",
  lead: "Workshops and talks given, publications and releases – newest first.",
  mehr: "Read more",
};
const T = en ? enT : de;
---

{
  eintraege.length > 0 && (
    <Section id="aktuelles" eyebrow={T.eyebrow} title={T.title} lead={T.lead}>
      <ol class="mx-auto max-w-3xl space-y-3">
        {eintraege.map((n) => (
          <li class="rounded-2xl border border-ink-200 bg-surface p-5 shadow-sm">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="inline-flex rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-brand-700">
                {NEWS_KIND_LABELS[n.data.kind]}
              </span>
              <time datetime={n.data.date.toISOString()} class="text-xs text-ink-500">
                {datum.format(n.data.date)}
              </time>
              {n.data.location && <span class="text-xs text-ink-500">· {n.data.location}</span>}
            </div>
            <h3 class="mt-2 text-base font-semibold text-ink-900">{n.data.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-600">{n.data.summary}</p>
            {n.data.url && (
              <a href={n.data.url} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-700 hover:text-brand-900">
                {n.data.urlLabel ?? T.mehr}
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            )}
          </li>
        ))}
      </ol>
    </Section>
  )
}
