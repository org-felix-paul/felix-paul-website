---
// The blog keeps its own wordmark and favicon, but uses the site navigation.
// Before this it had no nav at all: a reader arriving from search could reach
// the contact form and nothing else — not the workshops the posts are about.
import SiteHeader from "../../components/SiteHeader.astro";
import { PATHS, NAV } from "../../consts";
import { BLOG } from "../consts";
---

<SiteHeader
  home={BLOG.base}
  anchorBase={PATHS.home}
  logo={BLOG.logo}
  logoAlt="Felix Paul – Blog"
  wordmark={BLOG.name}
  nav={NAV}
  cta={{ href: PATHS.kontakt, label: "Kontakt" }}
/>
