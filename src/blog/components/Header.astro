---
// Blog branding on the shared header. Layout, mobile menu and nav behaviour
// live once in src/components/SiteHeader.astro.
import SiteHeader from "../../components/SiteHeader.astro";
import { PATHS } from "../../consts";
import { BLOG } from "../consts";
---

<SiteHeader
  home={BLOG.base}
  logo={BLOG.logo}
  logoAlt="Felix Paul – Blog"
  wordmark={BLOG.name}
  width="max-w-5xl"
  nav={[{ href: PATHS.home, label: "Startseite" }]}
  cta={{ href: PATHS.kontakt, label: "Kontakt" }}
/>
