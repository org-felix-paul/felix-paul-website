---
import SiteFooter from "../../components/SiteFooter.astro";
import { SITE, PATHS } from "../../consts";
import { BLOG } from "../consts";
---

<SiteFooter
  logo={BLOG.logo}
  logoAlt=""
  wordmark={BLOG.name}
  width="max-w-5xl"
  blurb="Felix Pauls persönlicher Blog – Gedanken zu KI, IT-Sicherheit, IT in der Bildung und spannenden IT-Projekten."
  columns={[
    {
      heading: "Mehr",
      links: [
        { href: PATHS.home, label: "Startseite", note: "Über Felix: Vorträge, Profil und Kontakt." },
        { href: PATHS.education, label: "Workshops für Schulen", note: "Workshops zu KI & IT-Sicherheit für Schulen." },
        { href: SITE.dSolveSite, label: "d-solve.de", note: "Softwareentwicklung & technische Beratung.", external: true },
      ],
    },
  ]}
/>
