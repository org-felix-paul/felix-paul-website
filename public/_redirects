/education/projekte/     /schools/insights/          301
/education/projekte      /schools/insights/          301
/education/              /schools/                   301
/education               /schools/                   301
/unternehmen/            /companies/                 301
/unternehmen             /companies/                 301
/privatpersonen/         /individuals/               301
/privatpersonen          /individuals/               301

# ── Pages removed from the education section before the merge ────────────
/schools/ueber-mich/     /schools/                   301
/schools/ueber-mich      /schools/                   301
/schools/angebote/       /schools/#angebote          301
/education/ueber-mich/   /schools/                   301
/education/angebote/     /schools/#angebote          301

